<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <!-- 原生 NuGet 资源也会带 PDB，统一从分发文件列表移除，保留本机诊断输出。 -->
  <Target Name="ExcludeDesktopPublishSymbols" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
