    <Thickness x:Key="DesktopStandardDialogBorderThickness">1</Thickness>
    <Thickness x:Key="DesktopDialogBorderThickness">1</Thickness>
    <Thickness x:Key="DesktopDialogSeparatorThickness">0,0,0,1</Thickness>
    <SolidColorBrush x:Key="DesktopAccentBrush" Color="#005FB8"/>
    <SolidColorBrush x:Key="DesktopOnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DesktopSelectedBrush" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="DesktopNavigationSelectedPointerOverBrush" Color="#DEDEDE"/>
    <SolidColorBrush x:Key="DesktopNavigationSelectedPressedBrush" Color="#D8D8D8"/>
    <SolidColorBrush x:Key="DesktopSectionSelectedBrush" Color="#E7F0FB"/>
    <SolidColorBrush x:Key="DesktopBroadcastBrush" Color="#EAF2F9"/>
    <SolidColorBrush x:Key="DesktopCalendarSelectedBrush" Color="#005FB8" Opacity="0.14"/>
    <SolidColorBrush x:Key="DesktopCalendarSelectedEdgeBrush" Color="#005FB8"/>
    <SolidColorBrush x:Key="DesktopButtonBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DesktopButtonHoverBrush" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="DesktopButtonPressedBrush" Color="#F0F0F0"/>
    <LinearGradientBrush x:Key="DesktopButtonEdgeBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,2">
        <LinearGradientBrush.RelativeTransform><ScaleTransform ScaleY="-1" CenterY="0.5"/></LinearGradientBrush.RelativeTransform>
        <GradientStop Offset="0.5" Color="#CCCCCC"/><GradientStop Offset="1" Color="#E5E5E5"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DesktopButtonHoverEdgeBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,2">
        <LinearGradientBrush.RelativeTransform><ScaleTransform ScaleY="-1" CenterY="0.5"/></LinearGradientBrush.RelativeTransform>
        <GradientStop Offset="0.5" Color="#CCCCCC"/><GradientStop Offset="1" Color="#DCDCDC"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DesktopButtonPressedEdgeBrush" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="DesktopPrimaryButtonBrush" Color="#005FB8"/>
    <SolidColorBrush x:Key="DesktopPrimaryButtonHoverBrush" Color="#196EBF"/>
    <SolidColorBrush x:Key="DesktopPrimaryButtonPressedBrush" Color="#317CC4"/>
    <SolidColorBrush x:Key="DesktopPrimaryButtonDisabledBrush" Color="#005FB8" Opacity="0.35"/>
    <LinearGradientBrush x:Key="DesktopPrimaryButtonEdgeBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,2">
        <LinearGradientBrush.RelativeTransform><ScaleTransform ScaleY="-1" CenterY="0.5"/></LinearGradientBrush.RelativeTransform>
        <GradientStop Offset="0.5" Color="#003E75"/><GradientStop Offset="1" Color="#00539F"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DesktopPrimaryButtonHoverEdgeBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,2">
        <LinearGradientBrush.RelativeTransform><ScaleTransform ScaleY="-1" CenterY="0.5"/></LinearGradientBrush.RelativeTransform>
        <GradientStop Offset="0.5" Color="#003E75"/><GradientStop Offset="1" Color="#00539F"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DesktopPrimaryButtonPressedEdgeBrush" Color="#00539F"/>
    <SolidColorBrush x:Key="DesktopCheckedButtonBrush" Color="#005FB8"/>
    <SolidColorBrush x:Key="DesktopCheckedButtonHoverBrush" Color="#196EBF"/>
    <SolidColorBrush x:Key="DesktopCheckedButtonPressedBrush" Color="#317CC4"/>
    <SolidColorBrush x:Key="DesktopCheckedButtonDisabledBrush" Color="#005FB8" Opacity="0.35"/>
    <SolidColorBrush x:Key="DesktopCheckedButtonTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DesktopCheckedButtonEdgeBrush" Color="#005FB8"/>
    <SolidColorBrush x:Key="DesktopTransparentBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="DesktopChoiceSelectedBrush" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="DesktopChoiceSelectedTextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="DesktopChoiceIndicatorBrush" Color="#005FB8"/>
    <SolidColorBrush x:Key="DesktopFieldFocusBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="DesktopClassicFieldEdgeBrush" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="DesktopClassicFieldHoverBrush" Color="#555555"/>
    <SolidColorBrush x:Key="DesktopTextFieldEdgeBrush" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="DesktopTextFieldHoverEdgeBrush" Color="#5D5D5D"/>
    <SolidColorBrush x:Key="DesktopTextFieldFocusBrush" Color="#005FB8"/>
    <Thickness x:Key="DesktopTextFieldFocusThickness">1,1,1,2</Thickness>
    <SolidColorBrush x:Key="DesktopFocusVisualBrush" Color="#1A1A1A"/>
    <Thickness x:Key="DesktopClassicFocusMargin">-4</Thickness>
    <Thickness x:Key="DesktopModernFocusMargin">2</Thickness>
    <Thickness x:Key="DesktopPaperFocusMargin">3</Thickness>
    <Thickness x:Key="DesktopFocusMargin">2</Thickness>
    <x:Boolean x:Key="DesktopUseSegmentedChoices">False</x:Boolean>
    <Thickness x:Key="DesktopButtonBorderThickness">1</Thickness>
    <Thickness x:Key="DesktopFieldBorderThickness">1</Thickness>
    <SolidColorBrush x:Key="DesktopSettingsSelectedBrush" Color="#E5E5E5" Opacity="0"/>
    <SolidColorBrush x:Key="DesktopSettingsIndicatorBrush" Color="#005FB8"/>
    <SolidColorBrush x:Key="DesktopSettingRowBrush" Color="#FFFFFF"/>
    <Thickness x:Key="DesktopSettingRowBorderThickness">1</Thickness>
    <Thickness x:Key="DesktopSettingRowPadding">20,16</Thickness>
    <Thickness x:Key="DesktopSettingRowMargin">0,0,0,8</Thickness>
    <FontFamily x:Key="DesktopSymbolFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <SolidColorBrush x:Key="DesktopSegmentTrackBrush" Color="#ECECEC"/>
    <SolidColorBrush x:Key="DesktopSegmentHoverBrush" Color="#E2E2E2"/>
    <SolidColorBrush x:Key="DesktopSegmentPressedBrush" Color="#D9D9D9"/>
    <SolidColorBrush x:Key="DesktopSegmentSelectedBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DesktopSegmentSelectedEdgeBrush" Color="#DEDEDE"/>
    <SolidColorBrush x:Key="DesktopSegmentSelectedTextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="DesktopSegmentFocusBrush" Color="#1A1A1A"/>
    <CornerRadius x:Key="DesktopControlRadius">4</CornerRadius>
    <CornerRadius x:Key="DesktopCoverRadius">6</CornerRadius>
    <CornerRadius x:Key="DesktopSegmentTrackRadius">7</CornerRadius>
    <CornerRadius x:Key="DesktopSegmentItemRadius">4</CornerRadius>
    <CornerRadius x:Key="DesktopSectionRadius">6</CornerRadius>
    <CornerRadius x:Key="DesktopNavigationRadius">5</CornerRadius>
    <FontFamily x:Key="DesktopUiFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="DesktopReadingFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <x:Double x:Key="DesktopBodySize">15</x:Double>
    <x:Double x:Key="DesktopBodyLineHeight">25.8</x:Double>
    <x:Double x:Key="DesktopControlTextSize">14</x:Double>
    <x:Double x:Key="DesktopDataTextSize">13</x:Double>
    <x:Double x:Key="DesktopTitleSize">28</x:Double>
    <x:Double x:Key="DesktopSectionSize">15</x:Double>
    <FontWeight x:Key="DesktopTitleWeight">SemiBold</FontWeight>
    <FontWeight x:Key="DesktopSectionWeight">SemiBold</FontWeight>
    <FontWeight x:Key="DesktopEmphasisWeight">SemiBold</FontWeight>
    <Thickness x:Key="DesktopCardBorderThickness">1</Thickness>
    <Style x:Key="DesktopUnderlinedSectionTabStyle" TargetType="ToggleButton" BasedOn="{StaticResource DesktopToggleButtonStyle}">
        <Setter Property="services:DesktopElementAppearance.Role" Value="UnderlinedSection"/>
        <Setter Property="Background" Value="{ThemeResource DesktopSubtleButtonBackgroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="DesktopFilledSectionTabStyle" TargetType="ToggleButton" BasedOn="{StaticResource DesktopToggleButtonStyle}">
        <Setter Property="services:DesktopElementAppearance.Role" Value="FilledSection"/>
        <Setter Property="Background" Value="{ThemeResource DesktopSubtleButtonBackgroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="AniMeidoPageTitleStyle" TargetType="TextBlock">
        <Setter Property="services:DesktopElementAppearance.Role" Value="Title"/>
        <Setter Property="FontFamily" Value="{ThemeResource DesktopUiFontFamily}"/>
        <Setter Property="FontSize" Value="{ThemeResource DesktopTitleSize}"/>
        <Setter Property="FontWeight" Value="{ThemeResource DesktopTitleWeight}"/>
        <Setter Property="Foreground" Value="{ThemeResource DesktopTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="AniMeidoSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="services:DesktopElementAppearance.Role" Value="Section"/>
        <Setter Property="FontFamily" Value="{ThemeResource DesktopUiFontFamily}"/>
        <Setter Property="FontSize" Value="{ThemeResource DesktopSectionSize}"/>
        <Setter Property="FontWeight" Value="{ThemeResource DesktopSectionWeight}"/>
        <Setter Property="Foreground" Value="{ThemeResource DesktopTextBrush}"/>
    </Style>
    <Style x:Key="AniMeidoCardStyle" TargetType="Border">
        <Setter Property="services:DesktopElementAppearance.Role" Value="SectionSurface"/>
        <Setter Property="Background" Value="{ThemeResource DesktopSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource DesktopLineBrush}"/>
        <Setter Property="BorderThickness" Value="{ThemeResource DesktopCardBorderThickness}"/>
        <Setter Property="CornerRadius" Value="{ThemeResource DesktopSectionRadius}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="AniMeidoToolbarStyle" TargetType="Border" BasedOn="{StaticResource AniMeidoCardStyle}">
        <Setter Property="Padding" Value="12"/>
    </Style>
    <Style x:Key="AniMeidoContentCardStyle" TargetType="Border" BasedOn="{StaticResource AniMeidoCardStyle}">
        <Setter Property="Background" Value="{ThemeResource DesktopCardBrush}"/>
    </Style>
    <SolidColorBrush x:Key="DesktopSwitchOffBrush" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="DesktopSwitchOffHoverBrush" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="DesktopSwitchOnBrush" Color="#237CE6"/>
    <SolidColorBrush x:Key="DesktopSwitchOnHoverBrush" Color="#206DCC"/>
    <ControlTemplate x:Key="DesktopSwitchTemplate" TargetType="ToggleSwitch">
                    <Grid x:Name="DesktopSwitchRoot" RowDefinitions="Auto,Auto">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="OuterBorder.Fill" Value="{ThemeResource DesktopSwitchOffHoverBrush}"/>
                                        <Setter Target="SwitchKnobBounds.Fill" Value="{ThemeResource DesktopSwitchOnHoverBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters><Setter Target="SwitchAreaGrid.Opacity" Value="0.8"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters><Setter Target="DesktopSwitchRoot.Opacity" Value="0.4"/></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ToggleStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="On">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.15" EnableDependentAnimation="True"/>
                                            <DoubleAnimation Storyboard.TargetName="SwitchKnobBounds" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition To="Off">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15" EnableDependentAnimation="True"/>
                                            <DoubleAnimation Storyboard.TargetName="SwitchKnobBounds" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Off"/>
                                <VisualState x:Name="Dragging"/>
                                <VisualState x:Name="On">
                                    <VisualState.Setters>
                                        <Setter Target="KnobTranslateTransform.X" Value="20"/>
                                        <Setter Target="SwitchKnobBounds.Opacity" Value="1"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="HeaderContentPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" Foreground="{TemplateBinding Foreground}" Margin="0,0,0,6"/>
                    <Grid x:Name="SwitchAreaGrid" Grid.Row="1" Width="44" Height="24" HorizontalAlignment="Left"
                          Background="Transparent" Control.IsTemplateFocusTarget="True">

                        <Rectangle x:Name="OuterBorder" Width="44" Height="24" RadiusX="12" RadiusY="12"
                                   Fill="{ThemeResource DesktopSwitchOffBrush}"/>
                        <Rectangle x:Name="SwitchKnobBounds" Width="44" Height="24" RadiusX="12" RadiusY="12"
                                   Fill="{ThemeResource DesktopSwitchOnBrush}" Opacity="0"/>
                        <Grid x:Name="SwitchKnob" Width="24" Height="24" HorizontalAlignment="Left">
                            <Grid.RenderTransform><TranslateTransform x:Name="KnobTranslateTransform"/></Grid.RenderTransform>
                            <Ellipse Width="20" Height="20" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Thumb x:Name="SwitchThumb" AutomationProperties.AccessibilityView="Raw">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent"/></ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                    </Grid>
                </ControlTemplate>
    <Style x:Key="DesktopToggleSwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="services:DesktopElementAppearance.Role" Value="Control"/>
        <Setter Property="MinWidth" Value="44"/><Setter Property="MinHeight" Value="32"/>
        <Setter Property="OnContent" Value=""/><Setter Property="OffContent" Value=""/>
        <Setter Property="Foreground" Value="{ThemeResource DesktopTextBrush}"/>
        <Setter Property="Template" Value="{StaticResource DesktopSwitchTemplate}"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource DesktopFocusVisualBrush}"/>
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource DesktopPageBrush}"/>
        <Setter Property="FocusVisualPrimaryThickness" Value="2"/><Setter Property="FocusVisualMargin" Value="3"/>
    </Style>
    <Style TargetType="ToggleSwitch" BasedOn="{StaticResource DesktopToggleSwitchStyle}"/>
    <Style x:Key="DesktopPaperToggleSwitchStyle" TargetType="ToggleSwitch" BasedOn="{StaticResource DesktopToggleSwitchStyle}"/>
    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource DesktopAccentButtonStyle}"/>
    <Style TargetType="Button" BasedOn="{StaticResource DesktopButtonStyle}">
        <Setter Property="CornerRadius" Value="{ThemeResource DesktopControlRadius}"/>
        <Setter Property="BorderThickness" Value="{ThemeResource DesktopButtonBorderThickness}"/>
    </Style>
    <Style TargetType="ToggleButton" BasedOn="{StaticResource DesktopToggleButtonStyle}"/>
    <Style TargetType="ListView" BasedOn="{StaticResource DefaultListViewStyle}">
        <Setter Property="services:DesktopElementAppearance.Role" Value="Control"/>
    </Style>
    <Style TargetType="GridView" BasedOn="{StaticResource DefaultGridViewStyle}">
        <Setter Property="services:DesktopElementAppearance.Role" Value="Control"/>
    </Style>
    <ControlTemplate x:Key="DesktopExpanderHeaderTemplate" TargetType="ToggleButton">
        <Border x:Name="ExpanderHeaderSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Control.IsTemplateFocusTarget="True">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="ExpanderHeaderSurface.Background" Value="{ThemeResource DesktopFieldHoverBrush}"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="ExpanderHeaderSurface.Background" Value="{ThemeResource DesktopButtonPressedBrush}"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="ExpanderChevron.Angle" Value="180"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="ExpanderChevron.Angle" Value="180"/><Setter Target="ExpanderHeaderSurface.Background" Value="{ThemeResource DesktopFieldHoverBrush}"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="ExpanderChevron.Angle" Value="180"/><Setter Target="ExpanderHeaderSurface.Background" Value="{ThemeResource DesktopButtonPressedBrush}"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="ExpanderHeaderSurface.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="CheckedDisabled"><VisualState.Setters><Setter Target="ExpanderChevron.Angle" Value="180"/><Setter Target="ExpanderHeaderSurface.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="{TemplateBinding Padding}">
                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/>
                <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5"><FontIcon.RenderTransform><RotateTransform x:Name="ExpanderChevron"/></FontIcon.RenderTransform></FontIcon>
            </Grid>
        </Border>
    </ControlTemplate>
    <ControlTemplate x:Key="DesktopExpanderTemplate" TargetType="Expander">
        <Grid x:Name="DesktopExpanderRoot" RowDefinitions="Auto,Auto">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ExpandDirectionStates">
                    <VisualState x:Name="Down"/>
                    <VisualState x:Name="Up"><VisualState.Setters><Setter Target="ExpanderHeader.(Grid.Row)" Value="1"/><Setter Target="ExpanderContentClip.(Grid.Row)" Value="0"/></VisualState.Setters></VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="ExpansionStates">
                    <VisualState x:Name="CollapseDown"/><VisualState x:Name="CollapseUp"/>
                    <VisualState x:Name="ExpandDown"><VisualState.Setters><Setter Target="ExpanderContentClip.Visibility" Value="Visible"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="ExpandUp"><VisualState.Setters><Setter Target="ExpanderContentClip.Visibility" Value="Visible"/></VisualState.Setters></VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ToggleButton x:Name="ExpanderHeader" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" Template="{StaticResource DesktopExpanderHeaderTemplate}" Background="{ThemeResource DesktopFieldBrush}" BorderBrush="{ThemeResource DesktopLineBrush}" BorderThickness="{ThemeResource DesktopFieldBorderThickness}" Padding="16,12" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"/>
            <Border x:Name="ExpanderContentClip" Grid.Row="1" Visibility="Collapsed">
                <Border x:Name="ExpanderContent" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Stretch"/>
                </Border>
            </Border>
        </Grid>
    </ControlTemplate>
    <Style TargetType="Expander">
        <Setter Property="Template" Value="{StaticResource DesktopExpanderTemplate}"/>
        <Setter Property="Background" Value="{ThemeResource DesktopSurfaceBrush}"/><Setter Property="Foreground" Value="{ThemeResource DesktopTextBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource DesktopLineBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="16"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="services:DesktopElementAppearance.Role" Value="Control"/>
    </Style>
    <ControlTemplate x:Key="DesktopComboBoxTemplate" TargetType="ComboBox">
        <Grid x:Name="DesktopComboRoot" RowDefinitions="Auto,*,Auto">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="ComboSurface.Background" Value="{ThemeResource DesktopFieldHoverBrush}"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="ComboSurface.Background" Value="{ThemeResource DesktopButtonPressedBrush}"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="Highlighted"/>
                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="DesktopComboRoot.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Unfocused"/>
                    <VisualState x:Name="Focused"><VisualState.Setters><Setter Target="ComboSurface.BorderBrush" Value="{ThemeResource DesktopFieldFocusBrush}"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="FocusedPressed"><VisualState.Setters><Setter Target="ComboSurface.BorderBrush" Value="{ThemeResource DesktopFieldFocusBrush}"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="FocusedDropDown"><VisualState.Setters><Setter Target="ComboSurface.BorderBrush" Value="{ThemeResource DesktopFieldFocusBrush}"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="PointerFocused"/>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter x:Name="HeaderContentPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" Foreground="{TemplateBinding Foreground}" Margin="0,0,0,6" Visibility="Collapsed"/>
            <Border x:Name="ComboSurface" Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Control.IsTemplateFocusTarget="True">
                <Grid ColumnDefinitions="*,32">
                    <ContentPresenter x:Name="ContentPresenter" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" VerticalContentAlignment="Center" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}">
                        <TextBlock x:Name="PlaceholderTextBlock" Text="{TemplateBinding PlaceholderText}" Foreground="{ThemeResource DesktopMutedBrush}"/>
                    </ContentPresenter>
                    <TextBox x:Name="EditableText" Visibility="Collapsed" BorderThickness="0"/>
                    <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False"/>
                </Grid>
            </Border>
            <ContentPresenter x:Name="DescriptionPresenter" Grid.Row="2" Content="{TemplateBinding Description}" Foreground="{ThemeResource DesktopMutedBrush}" Margin="0,4,0,0"/>
            <Popup x:Name="Popup" IsLightDismissEnabled="True">
                <Border x:Name="PopupBorder" Background="{ThemeResource DesktopOverlayBrush}" BorderBrush="{ThemeResource DesktopLineBrush}" BorderThickness="1" CornerRadius="{ThemeResource DesktopControlRadius}" Padding="4" MaxHeight="360">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsTabStop="False"><ItemsPresenter/></ScrollViewer>
                </Border>
            </Popup>
        </Grid>
    </ControlTemplate>
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{ThemeResource DesktopFieldBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource DesktopTextBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource DesktopLineBrush}"/>
