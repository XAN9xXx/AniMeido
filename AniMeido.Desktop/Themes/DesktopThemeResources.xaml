    <CornerRadius x:Key="DesktopModernDialogRadius">8</CornerRadius>
    <CornerRadius x:Key="DesktopPaperDialogRadius">6</CornerRadius>
    <CornerRadius x:Key="DesktopDialogRadius">8</CornerRadius>
