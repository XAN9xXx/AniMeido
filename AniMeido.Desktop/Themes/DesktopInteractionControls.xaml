    <Style x:Key="DesktopButtonStyle" TargetType="Button">
        <Setter Property="services:DesktopElementAppearance.Role" Value="Control"/>
        <Setter Property="Background" Value="{ThemeResource DesktopButtonBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource DesktopTextBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource DesktopButtonEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="{ThemeResource DesktopButtonBorderThickness}"/>
        <Setter Property="CornerRadius" Value="{ThemeResource DesktopControlRadius}"/>
        <Setter Property="Padding" Value="{ThemeResource DesktopControlPadding}"/>
        <Setter Property="MinHeight" Value="{ThemeResource DesktopControlMinHeight}"/>
        <Setter Property="MinWidth" Value="{ThemeResource DesktopControlMinWidth}"/>
        <Setter Property="FontFamily" Value="{ThemeResource DesktopUiFontFamily}"/>
        <Setter Property="FontSize" Value="{ThemeResource DesktopControlTextSize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="FocusVisualPrimaryThickness" Value="{ThemeResource DesktopFocusThickness}"/>
        <Setter Property="FocusVisualMargin" Value="{ThemeResource DesktopFocusMargin}"/>
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource DesktopFocusVisualBrush}"/>
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource DesktopPageBrush}"/>
        <Setter Property="Template" Value="{StaticResource DesktopButtonTemplate}"/>
    </Style>
    <Style x:Key="DesktopAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource DesktopButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource DesktopPrimaryButtonBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource DesktopOnAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource DesktopPrimaryButtonEdgeBrush}"/>
        <Setter Property="Template" Value="{StaticResource DesktopAccentButtonTemplate}"/>
    </Style>
    <Style x:Key="DesktopSubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource DesktopButtonStyle}">
        <Setter Property="services:DesktopElementAppearance.Role" Value="SubtleControl"/>
        <Setter Property="Background" Value="{ThemeResource DesktopSubtleButtonBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource DesktopSubtleButtonBackgroundBrush}"/>
        <Setter Property="BorderThickness" Value="{ThemeResource DesktopSubtleButtonBorderThickness}"/>
        <Setter Property="Template" Value="{StaticResource DesktopSubtleButtonTemplate}"/>
    </Style>
    <Style x:Key="DesktopCardButtonStyle" TargetType="Button" BasedOn="{StaticResource DesktopButtonStyle}">
        <Setter Property="services:DesktopElementAppearance.Role" Value="CardControl"/>
        <Setter Property="Background" Value="{ThemeResource DesktopCardBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource DesktopLineBrush}"/>
        <Setter Property="BorderThickness" Value="{ThemeResource DesktopCardBorderThickness}"/>
        <Setter Property="CornerRadius" Value="{ThemeResource DesktopControlRadius}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template" Value="{StaticResource DesktopCardButtonTemplate}"/>
    </Style>
    <Style x:Key="DesktopSmallActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DesktopSubtleButtonStyle}">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="MinWidth" Value="0"/>
    </Style>
    <Style x:Key="DesktopToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="services:DesktopElementAppearance.Role" Value="Control"/>
        <Setter Property="Background" Value="{ThemeResource DesktopButtonBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource DesktopTextBrush}"/>
