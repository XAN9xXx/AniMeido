        <Setter Property="CornerRadius" Value="{ThemeResource DesktopControlRadius}"/>
        <Setter Property="Padding" Value="{ThemeResource DesktopControlPadding}"/>
        <Setter Property="MinHeight" Value="{ThemeResource DesktopControlMinHeight}"/>
        <Setter Property="MinWidth" Value="{ThemeResource DesktopControlMinWidth}"/>
        <Setter Property="FontFamily" Value="{ThemeResource DesktopUiFontFamily}"/>
        <Setter Property="FontSize" Value="{ThemeResource DesktopControlTextSize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="FocusVisualPrimaryThickness" Value="{ThemeResource DesktopFocusThickness}"/>
        <Setter Property="FocusVisualMargin" Value="{ThemeResource DesktopFocusMargin}"/>
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource DesktopFocusVisualBrush}"/>
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource DesktopPageBrush}"/>
        <Setter Property="Template" Value="{StaticResource DesktopToggleButtonTemplate}"/>
    </Style>
</ResourceDictionary>
