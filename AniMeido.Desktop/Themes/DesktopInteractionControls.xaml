                            <Setter Target="Surface.BorderBrush" Value="{ThemeResource DesktopCheckedButtonEdgeBrush}"/>
                            <Setter Target="Surface.Foreground" Value="{ThemeResource DesktopCheckedButtonTextBrush}"/>
                        </VisualState.Setters>
