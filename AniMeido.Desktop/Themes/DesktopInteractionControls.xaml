                            <Setter Target="Surface.Background" Value="{ThemeResource DesktopCheckedButtonBrush}"/>
                            <Setter Target="Surface.BorderBrush" Value="{ThemeResource DesktopCheckedButtonEdgeBrush}"/>
                            <Setter Target="Surface.Foreground" Value="{ThemeResource DesktopCheckedButtonTextBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedPointerOver">
                        <VisualState.Setters>
                            <Setter Target="Surface.Background" Value="{ThemeResource DesktopCheckedButtonHoverBrush}"/>
                            <Setter Target="Surface.BorderBrush" Value="{ThemeResource DesktopCheckedButtonEdgeBrush}"/>
                            <Setter Target="Surface.Foreground" Value="{ThemeResource DesktopCheckedButtonTextBrush}"/>
