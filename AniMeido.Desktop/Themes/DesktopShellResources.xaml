<ResourceDictionary
    x:Class="AniMeido.App.Themes.DesktopShellResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AniMeido.App.Controls"
    xmlns:services="using:AniMeido.App.Services">
    <Style x:Key="DesktopShellNavigationStyle" TargetType="controls:DesktopShellNavigationItem">
        <Setter Property="services:DesktopElementAppearance.Role" Value="None"/>
        <Setter Property="Background" Value="{ThemeResource DesktopSubtleButtonBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource DesktopTextBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource DesktopFocusVisualBrush}"/>
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource DesktopNavigationBrush}"/>
        <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:DesktopShellNavigationItem">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters><Setter Target="NavigationSurface.Background" Value="{ThemeResource DesktopCardHoverBrush}"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters><Setter Target="NavigationSurface.Background" Value="{ThemeResource DesktopCardPressedBrush}"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters><Setter Target="NavigationSurface.Opacity" Value="0.4"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="NavigationSurface.Background" Value="{ThemeResource DesktopSelectedBrush}"/>
                                        <Setter Target="SelectionIndicator.Opacity" Value="1"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="NavigationSurface.Background" Value="{ThemeResource DesktopNavigationSelectedPointerOverBrush}"/>
                                        <Setter Target="SelectionIndicator.Opacity" Value="1"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="NavigationSurface.Background" Value="{ThemeResource DesktopNavigationSelectedPressedBrush}"/>
                                        <Setter Target="SelectionIndicator.Opacity" Value="1"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="NavigationSurface.Background" Value="{ThemeResource DesktopSelectedBrush}"/>
                                        <Setter Target="NavigationSurface.Opacity" Value="0.4"/>
                                        <Setter Target="SelectionIndicator.Opacity" Value="0.4"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="NavigationSurface" controls:DesktopButtonSurfaceMotion.Enable="True"
                                Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="Center"/>
                        </Border>
                        <Border x:Name="SelectionIndicator" Width="3" Height="16" Opacity="0"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{ThemeResource DesktopAccentBrush}" IsHitTestVisible="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
