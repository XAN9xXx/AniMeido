<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.App.Views.AppSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AniMeido.Plugin.Base.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="OnAppearanceLoaded" Unloaded="OnAppearanceUnloaded"
    Background="{ThemeResource DesktopPageBrush}"
    FontFamily="{ThemeResource DesktopUiFontFamily}">

    <ScrollViewer Background="Transparent">
        <StackPanel Padding="0,0,4,24"
                    Spacing="16">

            <InfoBar x:Name="DesktopSettingsSaveFailure" IsOpen="False" Visibility="Collapsed"
                     Severity="Error" IsClosable="False" Message="更改已生效，设置未能保存。">
                <InfoBar.ActionButton>
                    <Button x:Name="DesktopSettingsRetryButton" Content="重试" Click="OnRetryDesktopSettingsSave"/>
                </InfoBar.ActionButton>
            </InfoBar>

            <StackPanel x:Name="AppearanceSection" Spacing="0">
                <Border Style="{StaticResource DesktopSettingRowStyle}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                        <TextBlock Text="明暗" VerticalAlignment="Center"/>
                        <controls:DesktopChoice x:Name="ThemeCombo" Grid.Column="1" MinWidth="200" HorizontalAlignment="Right" AutomationProperties.Name="明暗"
                                 SelectionChanged="OnDesktopThemeSelectionChanged">
                            <x:String>浅色</x:String><x:String>深色</x:String><x:String>跟随系统</x:String>
                        </controls:DesktopChoice>
                    </Grid>
                </Border>
                <Border Style="{StaticResource DesktopSettingRowStyle}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                        <TextBlock Text="视觉风格" VerticalAlignment="Center"/>
                        <controls:DesktopChoice x:Name="VisualStyleChoice" Grid.Column="1" MinWidth="200" HorizontalAlignment="Right" AutomationProperties.Name="视觉风格"
                                 SelectionChanged="OnVisualStyleChanged">
                            <x:String>Fluent 10</x:String><x:String>Fluent 11</x:String><x:String>暖纸</x:String>
                        </controls:DesktopChoice>
                    </Grid>
                </Border>
                <Border Style="{StaticResource DesktopSettingRowStyle}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                        <TextBlock Text="字体" VerticalAlignment="Center"/>
                        <controls:DesktopChoice x:Name="FontStyleChoice" Grid.Column="1" MinWidth="200" HorizontalAlignment="Right" AutomationProperties.Name="字体"
                                 SelectionChanged="OnFontStyleChanged">
                            <x:String>经典黑体</x:String><x:String>现代黑体</x:String><x:String>衬线体</x:String>
                        </controls:DesktopChoice>
                    </Grid>
                </Border>
                    <Expander Header="效果预览" HorizontalAlignment="Stretch" Margin="0,8,0,0">
                        <StackPanel Spacing="12">
                            <TextBlock Text="3月的狮子" FontSize="28" TextWrapping="Wrap"/>
                            <TextBlock Text="March comes in like a lion" TextWrapping="Wrap"/>
                            <TextBlock Text="桐山零是一名独自生活的高中生，也是一位职业将棋棋士。"
                                       Style="{StaticResource DesktopReadingTextStyle}"/>
                            <TextBlock Text="我的评分 8.5"/>
                        </StackPanel>
                    </Expander>

            <TextBlock Text="页面显示" Style="{StaticResource DesktopSettingHeadingStyle}"/>
                <Border Style="{StaticResource DesktopSettingRowStyle}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                        <TextBlock Text="番剧库卡片" VerticalAlignment="Center"/>
                        <controls:DesktopChoice x:Name="CatalogCardsChoice" Grid.Column="1" MinWidth="200" HorizontalAlignment="Right" AutomationProperties.Name="番剧库卡片"
                                 SelectionChanged="OnCatalogCardsChanged">
                            <x:String>封面</x:String><x:String>详细卡片</x:String>
                        </controls:DesktopChoice>
                    </Grid>
                </Border>
                <Border Style="{StaticResource DesktopSettingRowStyle}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                        <TextBlock Text="显示补番提醒" VerticalAlignment="Center"/>
                        <ToggleSwitch x:Name="PlanRemindersToggle" Grid.Column="1" Toggled="OnPlanRemindersChanged"
                                      Style="{ThemeResource DesktopToggleSwitchStyle}" AutomationProperties.Name="显示补番提醒"/>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel x:Name="WindowSection" Spacing="16" Visibility="Collapsed">
                <TextBlock Text="关闭行为" Style="{StaticResource DesktopSettingHeadingStyle}"/>
                <Border Style="{StaticResource DesktopSettingRowStyle}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                        <TextBlock Text="关闭主窗口时驻留托盘" VerticalAlignment="Center"/>
                        <ToggleSwitch x:Name="KeepInTrayToggle" Grid.Column="1" Toggled="OnKeepInTrayToggled"
                                      Style="{ThemeResource DesktopToggleSwitchStyle}" AutomationProperties.Name="关闭主窗口时驻留托盘"/>
                    </Grid>
                </Border>
            </StackPanel>

            <ContentControl x:Name="PluginCommands" HorizontalContentAlignment="Stretch">
            <StackPanel x:Name="PluginSection" Spacing="16" Visibility="Collapsed">
            <Grid Margin="0,12,0,0"
                  ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="可选插件" Style="{StaticResource DesktopSettingHeadingStyle}" Margin="0,0,0,8"/>
                    <TextBlock Text="插件拥有本机访问权限，请仅安装你信任的插件包。"
                               Style="{StaticResource DesktopDataTextStyle}" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="InstallPluginButton"
                        Grid.Column="1"
                        Content="安装插件包"
                        Click="OnInstallPluginClick"/>
            </Grid>

            <InfoBar x:Name="PluginReloadInfoBar"
                     IsOpen="False"
                     IsClosable="False"
                     Severity="Informational"
                     Title="需要重载插件"
                     Message="重载插件后，刚才的变更才会生效。">
                <InfoBar.ActionButton>
                    <Button Content="立即重载插件"
                            Click="OnReloadPluginsClick"/>
                </InfoBar.ActionButton>
            </InfoBar>

            <TextBlock x:Name="PluginHostStatusText"
                       Style="{StaticResource DesktopDataTextStyle}"/>

            <TextBlock x:Name="NoInstalledPluginsText"
                       Text="尚未安装可选插件。"
                       Foreground="{ThemeResource DesktopMutedBrush}"/>

            <ItemsControl x:Name="InstalledPluginList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource DesktopSurfaceBrush}"
                                CornerRadius="{ThemeResource DesktopSectionRadius}"
                                Padding="16"
                                Margin="0,0,0,8">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DesktopEmphasisTextStyle}">
                                                    <Setter Property="FontSize" Value="16"/>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource DesktopDataTextStyle}" Text="{Binding PluginId}"
                                                   Foreground="{ThemeResource DesktopMutedBrush}"/>
                                        <TextBlock Style="{StaticResource DesktopDataTextStyle}" Text="{Binding SourceText}"
                                                   Foreground="{ThemeResource DesktopMutedBrush}"/>
                                        <TextBlock Style="{StaticResource DesktopDataTextStyle}" Text="{Binding LastError}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource DesktopDataTextStyle}" Text="{Binding CurrentVersion}"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Style="{StaticResource DesktopDataTextStyle}" Text="{Binding StatusText}"
                                                   Foreground="{ThemeResource DesktopMutedBrush}"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                    <Button Content="启用"
                                            Tag="{Binding PluginId}"
                                            IsEnabled="{Binding CanEnable}"
                                            Click="OnEnablePluginClick"/>
                                    <Button Content="禁用"
                                            Tag="{Binding PluginId}"
                                            IsEnabled="{Binding CanDisable}"
                                            Click="OnDisablePluginClick"/>
                                    <Button Content="回滚版本"
                                            Tag="{Binding PluginId}"
                                            IsEnabled="{Binding CanRollback}"
                                            Click="OnRollbackPluginClick"/>
                                    <Button Content="卸载"
                                            Tag="{Binding PluginId}"
                                            IsEnabled="{Binding CanUninstall}"
                                            Click="OnUninstallPluginClick"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,12,0,0">
                <TextBlock Text="内置插件"
                           Style="{StaticResource DesktopSettingHeadingStyle}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <ItemsControl x:Name="PluginList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource DesktopSurfaceBrush}"
                                CornerRadius="{ThemeResource DesktopSectionRadius}"
                                Padding="16"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DesktopEmphasisTextStyle}">
                                                <Setter Property="FontSize" Value="16"/>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource DesktopDataTextStyle}" Text="{Binding Version}"
                                               Foreground="{ThemeResource DesktopMutedBrush}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource DesktopDataTextStyle}" Grid.Column="1"
                                           Text="{Binding PluginID}"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource DesktopMutedBrush}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>

            </ContentControl>
            <StackPanel x:Name="AboutSection" Spacing="16" Visibility="Collapsed">
            <Border Background="{ThemeResource DesktopSettingRowBrush}"
                    CornerRadius="{ThemeResource DesktopSectionRadius}">
                <StackPanel>
                    <TextBlock Text="AniMeido"
                               Margin="16,12,16,4"
                               Style="{StaticResource DesktopSettingHeadingStyle}"/>

                    <Grid Margin="16,0,16,0"
                          Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource DesktopControlTextStyle}" Text="数据来源"
                                   VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource DesktopDataTextStyle}" Grid.Column="1"
                                   Text="AniMeido 资料服务（基于 Bangumi 等）"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource DesktopMutedBrush}"/>
                    </Grid>

                    <Rectangle Height="1"
                               Fill="{ThemeResource DividerStrokeColorDefault}"
                               Margin="16,0"/>

                    <Grid Margin="16,0,16,0"
                          Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource DesktopControlTextStyle}" Text="作者"
                                   VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource DesktopDataTextStyle}" Grid.Column="1"
                                   Text="XAN9x"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource DesktopMutedBrush}"/>
                    </Grid>

                    <Rectangle Height="1"
                               Fill="{ThemeResource DividerStrokeColorDefault}"
                               Margin="16,0"/>

                    <Grid Margin="16,0,16,0"
                          Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource DesktopControlTextStyle}" Text="联系方式"
                                   VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource DesktopDataTextStyle}" Grid.Column="1"
                                   Text="xan9xxx@gmail.com | QQ:3223271148"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource DesktopMutedBrush}"/>
                    </Grid>

                    <Rectangle Height="1"
                               Fill="{ThemeResource DividerStrokeColorDefault}"
                               Margin="16,0"/>

                    <Grid Margin="16,0,16,0"
                          Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource DesktopControlTextStyle}" Text="检查更新"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                            <TextBlock Style="{StaticResource DesktopDataTextStyle}" x:Name="VersionInfoText"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource DesktopMutedBrush}"/>
                            <Button x:Name="UpdateCheckButton"
                                    Content="检查"
                                    MinWidth="80"
                                    Height="32"
                                    VerticalAlignment="Center"
                                    Click="OnUpdateCheckClick"/>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1"
                               Fill="{ThemeResource DividerStrokeColorDefault}"
                               Margin="16,0"/>

                    <StackPanel x:Name="UpdateChannelPanel" Margin="16,8,16,12" Spacing="8" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DesktopControlTextStyle}" Text="更新通道" VerticalAlignment="Center"/>
                            <controls:DesktopChoice x:Name="UpdateChannelCombo" Grid.Column="1" MinWidth="160" HorizontalAlignment="Right" AutomationProperties.Name="更新通道"
                                      SelectionChanged="OnUpdateChannelSelectionChanged">
                                <x:String>稳定版</x:String>
                                <x:String>预览版</x:String>
                            </controls:DesktopChoice>
                        </Grid>
                        <TextBlock Style="{StaticResource DesktopDataTextStyle}" Text="切换到预览版会立即检查更新；切回稳定版不会降级，等待稳定版追上后再更新。已准备好的更新不会撤销。" TextWrapping="Wrap"
                                   Foreground="{ThemeResource DesktopMutedBrush}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource DesktopDataTextStyle}" x:Name="LegacyUpdateText" Margin="16,8,16,12" TextWrapping="Wrap"
                               Text="当前为旧安装方式，更新需到官网下载新安装包。"
                               Foreground="{ThemeResource DesktopMutedBrush}"/>
                    <StackPanel x:Name="RollbackDataPanel" Margin="16,8,16,12" Spacing="8" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource DesktopControlTextStyle}" Text="回滚前数据"/>
                        <TextBlock Style="{StaticResource DesktopDataTextStyle}" Text="这些数据不会自动删除。恢复将替换当前数据库，并先另存当前数据；恢复需要重启 AniMeido。" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="RollbackDataList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="8" Margin="0,0,0,12">
                                        <TextBlock Style="{StaticResource DesktopDataTextStyle}" Text="{Binding DisplayText}" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="恢复" Tag="{Binding Path}" Click="OnRestoreRollbackDataClick"/>
                                            <Button Content="打开文件夹" Tag="{Binding Path}" Click="OnOpenRollbackDataClick"/>
                                            <Button Content="删除" Tag="{Binding Path}" Click="OnDeleteRollbackDataClick"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Grid Margin="16,0,16,0"
                          Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource DesktopControlTextStyle}" Text="开源协议"
                                   VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource DesktopDataTextStyle}" Grid.Column="1"
                                   Text="GNU Affero General Public License v3.0"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource DesktopMutedBrush}"/>
                    </Grid>

                    <Rectangle Height="1"
                               Fill="{ThemeResource DividerStrokeColorDefault}"
                               Margin="16,0"/>

                    <Grid Margin="16,0,16,0"
                          Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource DesktopControlTextStyle}" Text="GitHub 仓库"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="GitHubButton"
                                Style="{StaticResource DesktopButtonStyle}"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource DesktopFieldBrush}"
                                CornerRadius="{ThemeResource DesktopControlRadius}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefault}"
                                BorderThickness="1"
                                Click="OnGitHubClick">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6"
                                        Padding="10,6">
                                <Image Source="ms-appx:///Assets/GitHub_Invertocat_Black_Clearspace.png"
                                       Width="18"
                                       Height="18"
                                       VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource DesktopEmphasisTextStyle}" Text="XAN9xXx/AniMeido"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Rectangle Height="1"
                               Fill="{ThemeResource DividerStrokeColorDefault}"
                               Margin="16,0"/>

                    <Grid Margin="16,0,16,0"
                          Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource DesktopControlTextStyle}" Text="AniMeido 官网"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="WebsiteButton"
                                Style="{StaticResource DesktopButtonStyle}"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource DesktopFieldBrush}"
                                CornerRadius="{ThemeResource DesktopControlRadius}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefault}"
                                BorderThickness="1"
                                Click="OnWebsiteClick">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6"
                                        Padding="10,6">
                                <Image Source="ms-appx:///Assets/icon.ico"
                                       Width="18"
                                       Height="18"
                                       VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource DesktopEmphasisTextStyle}" Text="animeido.com"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
