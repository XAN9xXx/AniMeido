<Page x:Class="AniMeido.App.Views.HostedPluginSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Stretch" Padding="0,0,4,24">
        <TextBlock x:Name="TitleText" Style="{StaticResource AniMeidoSectionTitleStyle}"/>
        <TextBlock x:Name="PluginText" Style="{StaticResource DesktopDataTextStyle}"/>
        <Border Style="{StaticResource AniMeidoCardStyle}" Padding="20">
            <StackPanel Spacing="14">
                <TextBlock Text="插件设置将在独立窗口中打开。" TextWrapping="Wrap" Style="{StaticResource DesktopControlTextStyle}"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="OpenButton" Content="打开插件设置" Style="{StaticResource AccentButtonStyle}" Click="OnOpenClick"/>
                    <ProgressRing x:Name="OpenProgress" Width="24" Height="24" IsActive="False" Visibility="Collapsed"/>
                </StackPanel>
                <InfoBar x:Name="StatusBar" IsClosable="True"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
