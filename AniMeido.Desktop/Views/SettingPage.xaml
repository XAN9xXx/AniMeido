<Page x:Class="AniMeido.App.Views.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AniMeido.App.Views"
    Background="{ThemeResource DesktopPageBrush}">
    <Grid RowDefinitions="Auto,Auto,*" Padding="24,20,24,24" RowSpacing="16">
        <TextBlock Text="设置" Style="{StaticResource AniMeidoPageTitleStyle}"/>
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="SectionItems">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:DesktopSettingsTarget">
                        <ToggleButton Tag="{x:Bind}" Click="OnSectionClick" Loaded="OnSectionLoaded" Unloaded="OnSectionUnloaded"
                                      Style="{StaticResource DesktopUnderlinedSectionTabStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="{x:Bind Icon}" FontSize="17" FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource DesktopControlTextStyle}"/>
                            </StackPanel>
                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Frame x:Name="SettingsFrame" Grid.Row="2" Background="{ThemeResource DesktopPageBrush}"/>
    </Grid>
</Page>
