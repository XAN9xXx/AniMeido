<Application
    x:Class="AniMeido.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:themes="using:AniMeido.App.Themes"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <themes:DesktopInteractionControls />
                <themes:DesktopThemeResources />
                <themes:DesktopWindowsSectionNavigation />
                <themes:DesktopSectionChoices />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
