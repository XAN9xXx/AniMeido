<Project Sdk="Uno.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-desktop</TargetFramework>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <AssemblyName>AniMeido.Tests</AssemblyName>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <UnoFeatures>Skia</UnoFeatures>
        <UnoDisableHotDesign>true</UnoDisableHotDesign>
        <UnoDisableMCPSupport>true</UnoDisableMCPSupport>
        <UnoDisableWinAppRunSupport>true</UnoDisableWinAppRunSupport>
        <EnableExperimentalAiTests Condition="'$(EnableExperimentalAiTests)' == ''">false</EnableExperimentalAiTests>
    </PropertyGroup>

    <PropertyGroup Condition="'$(AniMeidoUpdateTestSource)' == 'true'">
        <DefineConstants>$(DefineConstants);ANIMEIDO_UPDATE_TEST_SOURCE</DefineConstants>
    </PropertyGroup>

    <!-- 由本次构建报告路径，测试不扫描可能混有旧发布产物的 bin 目录。 -->
    <Target Name="RecordTestBuildOutputs" BeforeTargets="GetAssemblyAttributes" DependsOnTargets="ResolveProjectReferences">
        <ItemGroup>
            <TestOutputProject Include="..\AniMeido.Desktop\AniMeido.Desktop.csproj;..\Plugins\AniMeido.Plugin.Base.Desktop\AniMeido.Plugin.Base.Desktop.csproj;..\Plugins\AniMeido.Plugin.Base.Core\AniMeido.Plugin.Base.Core.csproj;..\AniMeido.Launcher\AniMeido.Launcher.csproj;..\AniMeido.PluginHost\AniMeido.PluginHost.csproj;..\Plugins\AniMeido.Plugin.AI\AniMeido.Plugin.AI.csproj" />
        </ItemGroup>
        <MSBuild Projects="@(TestOutputProject)" Targets="GetTargetPath" Properties="Configuration=$(Configuration);Platform=$(Platform)">
            <Output TaskParameter="TargetOutputs" ItemName="TestBuildOutput" />
        </MSBuild>
        <ItemGroup>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>TestBuildOutput.%(TestBuildOutput.Filename)</_Parameter1>
                <_Parameter2>%(TestBuildOutput.FullPath)</_Parameter2>
            </AssemblyAttribute>
        </ItemGroup>
    </Target>

    <ItemGroup>
        <Compile Include="../AniMeido.Desktop.Tests/UnoHeadlessTestHost.cs" Link="UnoHeadlessTestHost.cs" />
        <PackageReference Include="Uno.WinUI.Runtime.Headless" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Data.Sqlite" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\AniMeido.Contracts\AniMeido.Contracts.csproj" />
        <ProjectReference Include="..\AniMeido.Desktop\AniMeido.Desktop.csproj" />
        <ProjectReference Include="..\Plugins\AniMeido.Plugin.Base.Desktop\AniMeido.Plugin.Base.Desktop.csproj" />
        <!-- 播放器暂时下线，保留专用用例源码，不纳入基础版测试程序集。 -->
        <Compile Remove="Player\**\*.cs;App\LibMpvPreparationScriptTests.cs" />
        <ProjectReference Include="..\AniMeido.Launcher\AniMeido.Launcher.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\Plugins\AniMeido.Plugin.AI\AniMeido.Plugin.AI.csproj"
                          ReferenceOutputAssembly="false" Condition="'$(EnableExperimentalAiTests)' != 'true'" />
        <ProjectReference Include="..\Plugins\AniMeido.Plugin.AI\AniMeido.Plugin.AI.csproj"
                          Condition="'$(EnableExperimentalAiTests)' == 'true'" />
    </ItemGroup>

    <ItemGroup Condition="'$(EnableExperimentalAiTests)' != 'true'">
        <Compile Remove="Experimental\AiPluginInfrastructureTests.cs" />
        <Compile Remove="Experimental\StreamingTextBatcherTests.cs" />
        <None Include="Experimental\AiPluginInfrastructureTests.cs" />
        <None Include="Experimental\StreamingTextBatcherTests.cs" />
    </ItemGroup>

</Project>
