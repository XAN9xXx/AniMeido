<Project>
  <!--
    NuGet 中央包版本管理：所有包的版本只在这里登记，各 csproj 的 PackageReference 只写包名。
    在 VS 中通过"管理解决方案的 NuGet 程序包"升级时，修改的也是这个文件。
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Windows App SDK 与 UI -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!--
    Microsoft.Extensions：统一使用 10.0 LTS 的同一补丁版本。
    App 进程（含 Base）与 PluginHost 进程使用同一版本；Serilog.Extensions.Logging 10.x 也要求 Logging ≥ 10.0。
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <!-- 数据、日志与内容处理 -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <!-- 仅提升原生 SQLite 传递依赖，修复 CVE-2025-6965；托管 provider / core 保持不变。由直接使用 Microsoft.Data.Sqlite 的项目显式引用。 -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <PackageVersion Include="ToolGood.Words.Pinyin" Version="3.1.0.4" />
  </ItemGroup>

  <!-- Player 插件 -->
  <ItemGroup>
    <PackageVersion Include="AngleSharp" Version="1.5.2" />
    <PackageVersion Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageVersion Include="Jint" Version="4.13.0" />
  </ItemGroup>

  <!-- 测试 -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <!-- xUnit 2.8 起默认使用 conservative 并行调度，避免低核数时异步续体被新测试饿死。 -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
