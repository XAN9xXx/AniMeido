<Project Sdk="Uno.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-desktop</TargetFramework>
    <RootNamespace>AniMeido.PluginHost</RootNamespace>
    <AssemblyName>AniMeido.PluginHost</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UnoFeatures>Skia</UnoFeatures>
    <UnoDisableHotDesign>true</UnoDisableHotDesign>
    <UnoDisableMCPSupport>true</UnoDisableMCPSupport>
    <UnoDisableWinAppRunSupport>true</UnoDisableWinAppRunSupport>
    <!-- App 以 self-contained 方式发布；作为进程依赖的 Host 必须采用相同部署模型。 -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <Using Include="System.IO.FileAttributes" Alias="FileAttributes" />
    <ApplicationDefinition Include="App.xaml" />
    <None Remove="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AniMeido.Contracts\AniMeido.Contracts.csproj" />
    <ProjectReference Include="..\AniMeido.PluginProtocol\AniMeido.PluginProtocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\AppDataRoots.cs" Link="Shared\AppDataRoots.cs" />
    <Compile Include="..\Shared\DiagnosticFileStore.cs" Link="Shared\DiagnosticFileStore.cs" />
  </ItemGroup>
</Project>
