<ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

        <ResourceDictionary.ThemeDictionaries>
                <!-- ========= Light Theme ========= -->
                <ResourceDictionary x:Key="Light">
                        <!-- 页面背景 -->
                        <SolidColorBrush x:Key="AniMeidoPageBackgroundBrush"
                                         Color="#F5F5F5"/>
                        <SolidColorBrush x:Key="AniMeidoSurfaceBrush"
                                         Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AniMeidoCardBackgroundBrush"
                                         Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AniMeidoCardBorderBrush"
                                         Color="#E0E0E0"/>

                        <!-- 文字 -->
                        <SolidColorBrush x:Key="AniMeidoPrimaryTextBrush"
                                         Color="#1A1A1A"/>
                        <SolidColorBrush x:Key="AniMeidoSecondaryTextBrush"
                                         Color="#444444"/>
                        <SolidColorBrush x:Key="AniMeidoMutedTextBrush"
                                         Color="#777777"/>
                        <SolidColorBrush x:Key="AniMeidoErrorTextBrush"
                                         Color="#D32F2F"/>

                        <!-- 强调色 -->
                        <SolidColorBrush x:Key="AniMeidoAccentBrush"
                                         Color="{ThemeResource SystemAccentColor}"/>

                        <!-- 覆盖层（半透明遮罩） -->
                        <SolidColorBrush x:Key="AniMeidoOverlayScrimBrush"
                                         Color="#80FFFFFF"/>

                        <!-- 角标 -->
                        <SolidColorBrush x:Key="AniMeidoBadgeBackgroundBrush"
                                         Color="{ThemeResource SystemAccentColor}"/>
                        <SolidColorBrush x:Key="AniMeidoBadgeTextBrush"
                                         Color="#FFFFFF"/>

                        <!-- Tag -->
                        <SolidColorBrush x:Key="AniMeidoTagBackgroundBrush"
                                         Color="#E8E8E8"/>
                        <SolidColorBrush x:Key="AniMeidoTagTextBrush"
                                         Color="#1A1A1A"/>

                        <!-- 拖放 Zone -->
                        <SolidColorBrush x:Key="AniMeidoDropZoneBackgroundBrush"
                                         Color="#CCE8FF"/>
                        <SolidColorBrush x:Key="AniMeidoDropZoneBorderBrush"
                                         Color="#80B3FF"/>
                        <SolidColorBrush x:Key="AniMeidoDropZoneHoverBrush"
                                         Color="#99CCFF"/>

                        <!-- 导航 -->
                        <SolidColorBrush x:Key="AniMeidoNavTextDefaultBrush"
                                         Color="#1A1A1A"/>
                        <SolidColorBrush x:Key="AniMeidoNavTextSelectedBrush"
                                         Color="{ThemeResource SystemAccentColor}"/>
                        <SolidColorBrush x:Key="AniMeidoNavIndicatorBrush"
                                         Color="{ThemeResource SystemAccentColor}"/>
                        <SolidColorBrush x:Key="AniMeidoNavItemHoverBackgroundBrush"
                                         Color="{ThemeResource SystemAccentColor}"
                                         Opacity="0.10"/>
                        <SolidColorBrush x:Key="AniMeidoNavItemSelectedBackgroundBrush"
                                         Color="{ThemeResource SystemAccentColor}"
                                         Opacity="0.08"/>

                        <!-- 状态标记颜色 -->
                        <SolidColorBrush x:Key="AniMeidoWatchingColorBrush"
                                         Color="#4488FF"/>
                        <SolidColorBrush x:Key="AniMeidoPlanToWatchColorBrush"
                                         Color="#44FF88"/>
                        <SolidColorBrush x:Key="AniMeidoNotInterestedColorBrush"
                                         Color="#FF4444"/>
                        <SolidColorBrush x:Key="AniMeidoFollowingColorBrush"
                                         Color="#FFAA00"/>
                        <SolidColorBrush x:Key="AniMeidoCompletedColorBrush"
                                         Color="#8844FF"/>
                        <SolidColorBrush x:Key="AniMeidoDroppedColorBrush"
                                         Color="#888888"/>
                        <SolidColorBrush x:Key="AniMeidoBlockedColorBrush"
                                         Color="#444444"/>

                        <!-- 统计卡片 -->
                        <SolidColorBrush x:Key="AniMeidoStatsCardTextBrush"
                                         Color="{ThemeResource SystemAccentColor}"/>

                        <!-- 占位图 / 失败覆盖层 -->
                        <SolidColorBrush x:Key="AniMeidoPlaceholderBackgroundBrush"
                                         Color="#E8E8E8"/>
                        <SolidColorBrush x:Key="AniMeidoFailedOverlayBrush"
                                         Color="#CCE0E0E0"/>
                </ResourceDictionary>

                <!-- ========= Dark Theme ========= -->
                <ResourceDictionary x:Key="Dark">
                        <!-- 页面背景 -->
                        <SolidColorBrush x:Key="AniMeidoPageBackgroundBrush"
                                         Color="#1A1A1A"/>
                        <SolidColorBrush x:Key="AniMeidoSurfaceBrush"
                                         Color="#2A2A2A"/>
                        <SolidColorBrush x:Key="AniMeidoCardBackgroundBrush"
                                         Color="#2D2D2D"/>
                        <SolidColorBrush x:Key="AniMeidoCardBorderBrush"
                                         Color="#404040"/>

                        <!-- 文字 -->
                        <SolidColorBrush x:Key="AniMeidoPrimaryTextBrush"
                                         Color="#F0F0F0"/>
                        <SolidColorBrush x:Key="AniMeidoSecondaryTextBrush"
                                         Color="#AAAAAA"/>
                        <SolidColorBrush x:Key="AniMeidoMutedTextBrush"
                                         Color="#777777"/>
                        <SolidColorBrush x:Key="AniMeidoErrorTextBrush"
                                         Color="#EF5350"/>

                        <!-- 强调色 -->
                        <SolidColorBrush x:Key="AniMeidoAccentBrush"
                                         Color="{ThemeResource SystemAccentColor}"/>

                        <!-- 覆盖层 -->
                        <SolidColorBrush x:Key="AniMeidoOverlayScrimBrush"
                                         Color="#B0000000"/>

                        <!-- 角标 -->
                        <SolidColorBrush x:Key="AniMeidoBadgeBackgroundBrush"
                                         Color="{ThemeResource SystemAccentColor}"/>
                        <SolidColorBrush x:Key="AniMeidoBadgeTextBrush"
                                         Color="#FFFFFF"/>

                        <!-- Tag -->
                        <SolidColorBrush x:Key="AniMeidoTagBackgroundBrush"
                                         Color="#3A3A3A"/>
                        <SolidColorBrush x:Key="AniMeidoTagTextBrush"
                                         Color="#D0D0D0"/>

                        <!-- 拖放 Zone -->
                        <SolidColorBrush x:Key="AniMeidoDropZoneBackgroundBrush"
                                         Color="#332A2A6A"/>
                        <SolidColorBrush x:Key="AniMeidoDropZoneBorderBrush"
                                         Color="#664488FF"/>
                        <SolidColorBrush x:Key="AniMeidoDropZoneHoverBrush"
                                         Color="#996699FF"/>

                        <!-- 导航 -->
                        <SolidColorBrush x:Key="AniMeidoNavTextDefaultBrush"
                                         Color="#E9E9E9"/>
                        <SolidColorBrush x:Key="AniMeidoNavTextSelectedBrush"
                                         Color="{ThemeResource SystemAccentColor}"/>
                        <SolidColorBrush x:Key="AniMeidoNavIndicatorBrush"
                                         Color="{ThemeResource SystemAccentColor}"/>
                        <SolidColorBrush x:Key="AniMeidoNavItemHoverBackgroundBrush"
                                         Color="{ThemeResource SystemAccentColor}"
                                         Opacity="0.14"/>
                        <SolidColorBrush x:Key="AniMeidoNavItemSelectedBackgroundBrush"
                                         Color="{ThemeResource SystemAccentColor}"
                                         Opacity="0.10"/>

                        <!-- 状态标记颜色 -->
                        <SolidColorBrush x:Key="AniMeidoWatchingColorBrush"
                                         Color="#4488FF"/>
                        <SolidColorBrush x:Key="AniMeidoPlanToWatchColorBrush"
                                         Color="#44FF88"/>
                        <SolidColorBrush x:Key="AniMeidoNotInterestedColorBrush"
                                         Color="#FF4444"/>
                        <SolidColorBrush x:Key="AniMeidoFollowingColorBrush"
                                         Color="#FFAA00"/>
                        <SolidColorBrush x:Key="AniMeidoCompletedColorBrush"
                                         Color="#8844FF"/>
                        <SolidColorBrush x:Key="AniMeidoDroppedColorBrush"
                                         Color="#888888"/>
                        <SolidColorBrush x:Key="AniMeidoBlockedColorBrush"
                                         Color="#444444"/>

                        <!-- 统计卡片 -->
                        <SolidColorBrush x:Key="AniMeidoStatsCardTextBrush"
                                         Color="{ThemeResource SystemAccentColor}"/>

                        <!-- 占位图 / 失败覆盖层 -->
                        <SolidColorBrush x:Key="AniMeidoPlaceholderBackgroundBrush"
                                         Color="#3A3A3A"/>
                        <SolidColorBrush x:Key="AniMeidoFailedOverlayBrush"
                                         Color="#B0333333"/>
                </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>

        <!-- ========= Shared layout and component styles ========= -->
        <Style x:Key="AniMeidoPageTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="AniMeidoPageSubtitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground"
                        Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>

        <Style x:Key="AniMeidoSectionTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="AniMeidoCardStyle"
               TargetType="Border">
                <Setter Property="Background"
                        Value="{ThemeResource CardBackgroundFillColorDefault}"/>
                <Setter Property="BorderBrush"
                        Value="{ThemeResource ControlStrokeColorDefault}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="AniMeidoSectionTabStyle"
               TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="MinHeight" Value="40"/>
        </Style>

        <Style x:Key="AniMeidoEmptyStateIconStyle"
               TargetType="FontIcon">
                <Setter Property="FontSize" Value="36"/>
                <Setter Property="Foreground"
                        Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>

        <Style x:Key="AniMeidoToolbarStyle"
               TargetType="Border"
               BasedOn="{StaticResource AniMeidoCardStyle}">
                <Setter Property="Padding" Value="12"/>
                <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style x:Key="AniMeidoContentCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource AniMeidoCardStyle}">
                <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="AniMeidoDangerButtonStyle"
               TargetType="Button">
                <Setter Property="Foreground"
                        Value="{ThemeResource SystemFillColorCriticalBrush}"/>
        </Style>

        <!-- 轻量按钮：平时无底无框、次要文字色；悬停出浅底，按下底色加深。
             用于区块标题旁、面板里的次要操作，代替蓝字超链接。 -->
        <Style x:Key="AniMeidoSubtleButtonStyle"
               TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground"
                        Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="FocusVisualMargin" Value="-3"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                        <Grid Background="{TemplateBinding Background}"
                                              CornerRadius="{TemplateBinding CornerRadius}">
                                                <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                                <VisualState x:Name="Normal"/>
                                                                <VisualState x:Name="PointerOver">
                                                                        <VisualState.Setters>
                                                                                <Setter Target="HoverLayer.Opacity" Value="1"/>
                                                                                <Setter Target="Presenter.Foreground"
                                                                                        Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                                        </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="Pressed">
                                                                        <VisualState.Setters>
                                                                                <Setter Target="PressedLayer.Opacity" Value="1"/>
                                                                                <Setter Target="Presenter.Foreground"
                                                                                        Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                                        </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="Disabled">
                                                                        <VisualState.Setters>
                                                                                <Setter Target="Presenter.Foreground"
                                                                                        Value="{ThemeResource TextFillColorDisabledBrush}"/>
                                                                        </VisualState.Setters>
                                                                </VisualState>
                                                        </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <Border x:Name="HoverLayer"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="{TemplateBinding CornerRadius}"
                                                        Opacity="0"/>
                                                <Border x:Name="PressedLayer"
                                                        Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                        CornerRadius="{TemplateBinding CornerRadius}"
                                                        Opacity="0"/>
                                                <ContentPresenter x:Name="Presenter"
                                                                  Padding="{TemplateBinding Padding}"
                                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                  Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  Foreground="{TemplateBinding Foreground}"
                                                                  FontSize="{TemplateBinding FontSize}"
                                                                  AutomationProperties.AccessibilityView="Raw"/>
                                        </Grid>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <!-- 跳转按钮：轻量按钮的文字后面跟一个 ›，表示会去往别处（另一页或完整列表）。
             Content 直接写文字即可。 -->
        <Style x:Key="AniMeidoNavigateButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AniMeidoSubtleButtonStyle}">
                <Setter Property="ContentTemplate">
                        <Setter.Value>
                                <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                <FontIcon Glyph="&#xE76C;"
                                                          FontSize="10"
                                                          VerticalAlignment="Center"/>
                                        </StackPanel>
                                </DataTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <Style x:Key="AniMeidoListItemStyle"
               TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="CornerRadius" Value="8"/>
        </Style>
</ResourceDictionary>
