<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>$(AniMeidoVersion)</Version>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AniMeido.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 测试项目可访问 internal 类型 -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>AniMeido.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- WinUI 包已把所有 .xaml 作为 Page 编译；它移出 None 的规则早于 SDK 默认项执行而失效，这里补上，让 XAML 只作为 Page 存在。 -->
  <ItemGroup>
    <None Remove="**\*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Placeholder_cover.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Empty_anime.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Loading_failed.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\GitHub_Invertocat_Black_Clearspace.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Debug" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AniMeido.Contracts\AniMeido.Contracts.csproj" />
    <ProjectReference Include="..\AniMeido.PluginProtocol\AniMeido.PluginProtocol.csproj" />
    <ProjectReference Include="..\Plugins\AniMeido.Plugin.Base\AniMeido.Plugin.Base.csproj" />
    <ProjectReference Include="..\AniMeido.PluginHost\AniMeido.PluginHost.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- BasePlugin 是编译期依赖，由 ProjectReference 自动输出到根目录，无需额外复制 -->

  <!-- 复制 App.pri 到 publish 目录 -->
  <Target Name="CopyAppPri" AfterTargets="Publish">
    <Copy SourceFiles="$(OutDir)$(TargetName).pri" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    PluginHost 是独立进程：构建和发布后，把它的输出整体复制到 App 的 PluginHost\ 子目录。
    输出位置由 PluginHost 项目自己报告（GetTargetPath），这里不再手写目标框架、RID 或目录结构，
    以免 PluginHost 的输出位置变化后静默复制到旧文件或什么都不复制。
  -->
  <Target Name="ResolvePluginHostOutput">
    <MSBuild Projects="..\AniMeido.PluginHost\AniMeido.PluginHost.csproj"
             Targets="GetTargetPath"
             BuildInParallel="$(BuildInParallel)">
      <Output TaskParameter="TargetOutputs" ItemName="_PluginHostTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <_PluginHostOutputDir>@(_PluginHostTargetPath->'%(RootDir)%(Directory)')</_PluginHostOutputDir>
    </PropertyGroup>
    <ItemGroup Condition="Exists('@(_PluginHostTargetPath)')">
      <PluginHostOutput Include="$(_PluginHostOutputDir)**\*"
                        Exclude="$(_PluginHostOutputDir)**\*.pdb" />
    </ItemGroup>
  </Target>

  <Target Name="CopyPluginHostOutput" AfterTargets="Build" DependsOnTargets="ResolvePluginHostOutput">
    <Warning Condition="'@(PluginHostOutput)' == ''"
             Text="未找到 PluginHost 构建产物（@(_PluginHostTargetPath)），可选插件将无法启动。请确认 AniMeido.PluginHost 已成功构建。" />
    <Copy SourceFiles="@(PluginHostOutput)"
          DestinationFiles="@(PluginHostOutput->'$(OutDir)PluginHost\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyPluginHostPublishOutput" AfterTargets="Publish" DependsOnTargets="ResolvePluginHostOutput">
    <Error Condition="'@(PluginHostOutput)' == ''"
           Text="未找到 PluginHost 构建产物（@(_PluginHostTargetPath)），发布已中止：缺少 PluginHost 的发布目录无法运行可选插件。" />
    <Copy SourceFiles="@(PluginHostOutput)"
          DestinationFiles="@(PluginHostOutput->'$(PublishDir)PluginHost\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
