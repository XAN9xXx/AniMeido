<?xml version="1.0" encoding="utf-8"?>
<!--
  AniMeido 的发布配置（发布到本地文件夹），只在发布时使用：
    VS：右键 AniMeido.App → 发布 → 选择 win-x64（VS 会记住所选配置）。
    命令行：dotnet publish AniMeido.App -c Release -p:PublishProfile=win-x64
  命令行未指定本配置或输出目录参数时，使用 SDK 的默认发布目录。
  自包含、RID、裁剪、ReadyToRun、调试符号等设置统一写在 AniMeido.App.csproj 中，这里只保留发布动作本身的参数。
  Tools/Publish-Release.ps1 先显式指定输出目录并组装安装镜像，再传给 Installer/AniMeido.iss，不依赖下面的 PublishDir。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishDir>bin\Release\net10.0-windows10.0.19041.0\win-x64\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
