<?xml version="1.0" encoding="utf-8"?>
<!--
  AniMeido 的发布配置（发布到本地文件夹），只在发布时使用：
    VS：右键 AniMeido.App → 发布 → 选择 win-x64（VS 会记住所选配置）。
    命令行：dotnet publish AniMeido.App -c Release -p:PublishProfile=win-x64
  命令行不带 -p:PublishProfile 时会发布到默认目录（bin\x64\Release\...\publish\），安装器不会读取那里。
  自包含、RID、裁剪、ReadyToRun、调试符号等设置统一写在 AniMeido.App.csproj 中，这里只保留发布动作本身的参数。
  安装器脚本（AniMeidoInstaller\*.iss）按下面的 PublishDir 取文件；修改 PublishDir 或升级目标框架时需同步修改安装器脚本。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishDir>bin\Release\net8.0-windows10.0.19041.0\win-x64\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
