<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AniMeido.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AniMeido.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AniMeido">

    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid"
          Background="{ThemeResource LayerFillColorDefault}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <InfoBar x:Name="LegacyInstallationInfoBar"
                 Grid.Row="1"
                 Margin="8,8,8,0"
                 Visibility="Collapsed"
                 IsOpen="False"
                 IsClosable="True"
                 Severity="Warning"
                 Title="旧版 AniMeido 仍已安装"
                 Message="2.x 版本不再支持，误开旧版可能损坏升级后的数据。请卸载旧版本；追番记录等个人数据不会被旧卸载程序删除。"
                 Closed="OnLegacyInstallationInfoBarClosed">
            <InfoBar.ActionButton>
                <Button x:Name="UninstallLegacyButton"
                        Content="卸载旧版本"
                        Click="OnUninstallLegacyClick"/>
            </InfoBar.ActionButton>
        </InfoBar>
        <NavigationView x:Name="MainNaviView"
                        Grid.Row="2"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        CompactPaneLength="48"
                        OpenPaneLength="164">

            <NavigationView.Resources>
                <Style TargetType="NavigationViewItem">
                    <Setter Property="MinHeight" Value="48"/>
                    <Setter Property="CornerRadius" Value="8"/>
                    <Setter Property="FontSize" Value="14"/>
                </Style>
            </NavigationView.Resources>

            <Frame x:Name="ContentFrame"/>

        </NavigationView>

        <Grid x:Name="MigrationBlock" Grid.Row="2" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="520">
                <TextBlock Text="需要联网完成一次资料迁移" FontSize="24" TextWrapping="Wrap"/>
                <TextBlock x:Name="MigrationStatus" Text="个人记录尚未切换到公共 ID。请联网后重试；完成前不会加载资料页面。" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="MigrationRetry" Content="重试" Click="OnRetryMigrationClick"/>
                    <Button Content="打开备份文件夹" Click="OnOpenMigrationBackupsClick"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 标题栏：高 48，与系统标题栏按钮的 Tall 高度一致 -->
        <Grid Height="48"
              VerticalAlignment="Top">
            <Rectangle Height="1"
                       VerticalAlignment="Bottom"
                       Fill="{ThemeResource DividerStrokeColorDefault}"/>

            <!-- 拖动区域从返回按钮右侧开始。按钮若放在拖动区域内，
                 鼠标按下会先交给系统拖动窗口，点击时有时失效。 -->
            <Grid x:Name="AppTitleBar"
                  Margin="56,0,0,1"
                  Background="Transparent">
                <TextBlock x:Name="AppTitleText"
                           Visibility="Collapsed"
                           Margin="12,0,160,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>

            <!-- 返回按钮与左侧紧凑导航栏对齐 -->
            <Button x:Name="BackButton"
                    Width="40"
                    Height="36"
                    Margin="8,0,0,1"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    CornerRadius="8"
                    BorderThickness="0"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    AutomationProperties.Name="返回"
                    ToolTipService.ToolTip="返回"
                    Click="OnBackButtonClick">
                <FontIcon Glyph="&#xE76B;"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="14"/>
            </Button>
        </Grid>

        <Grid x:Name="SplashOverlay"
              Grid.RowSpan="3"
              Visibility="Visible"
              IsHitTestVisible="False"
              Background="#FF1A1A2E"
              VerticalAlignment="Stretch"
              HorizontalAlignment="Stretch">
            <Image x:Name="SplashImage"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
