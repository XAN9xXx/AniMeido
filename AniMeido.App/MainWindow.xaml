<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AniMeido.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AniMeido.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AniMeido">

    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid"
          Background="{ThemeResource LayerFillColorDefault}">
        <NavigationView x:Name="MainNaviView"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        CompactPaneLength="48"
                        OpenPaneLength="164"
                        Margin="0,48,0,0">

            <NavigationView.Resources>
                <Style TargetType="NavigationViewItem">
                    <Setter Property="MinHeight" Value="48"/>
                    <Setter Property="CornerRadius" Value="8"/>
                    <Setter Property="FontSize" Value="14"/>
                </Style>
            </NavigationView.Resources>

            <Frame x:Name="ContentFrame"/>

        </NavigationView>

        <!-- 标题栏：高 48，与系统标题栏按钮的 Tall 高度一致 -->
        <Grid Height="48"
              VerticalAlignment="Top">
            <Rectangle Height="1"
                       VerticalAlignment="Bottom"
                       Fill="{ThemeResource DividerStrokeColorDefault}"/>

            <!-- 拖动区域从返回按钮右侧开始。按钮若放在拖动区域内，
                 鼠标按下会先交给系统拖动窗口，点击时有时失效。 -->
            <Grid x:Name="AppTitleBar"
                  Margin="56,0,0,1"
                  Background="Transparent"/>

            <!-- 返回按钮：圆角方块，与左侧导航栏对齐 -->
            <Button x:Name="BackButton"
                    Width="40"
                    Height="36"
                    Margin="8,0,0,1"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    CornerRadius="8"
                    BorderThickness="0"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    AutomationProperties.Name="返回"
                    ToolTipService.ToolTip="返回"
                    Click="OnBackButtonClick">
                <FontIcon Glyph="&#xE76B;"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="14"/>
            </Button>
        </Grid>

        <!-- 开屏覆盖层：覆盖全窗口 -->
        <Grid x:Name="SplashOverlay"
              Visibility="Visible"
              IsHitTestVisible="False"
              Background="#FF1A1A2E"
              VerticalAlignment="Stretch"
              HorizontalAlignment="Stretch">
            <Image x:Name="SplashImage"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
