<!-- 作为本地文件加载，通过 XamlReader.Load() 解析。无 x:Class 绑定。 -->
<!-- 区域命名约定：TopBar / RoomListPanel / MessagePanel / InputPanel / FloatingSettingsPanel -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ===== TopBar：小房间标题栏 ===== -->
    <Border x:Name="TopBar"
            Grid.Row="0"
            Height="52"
            Padding="16,0"
            CornerRadius="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="10">
                <TextBlock Text="✦"
                           VerticalAlignment="Center"
                           FontSize="20"/>
                <TextBlock x:Name="CurrentRoomLabel"
                           Text="综合讨论"
                           VerticalAlignment="Center"
                           FontSize="18"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6">
                <TextBlock x:Name="ConnectionStatusDot"
                           Text="●"
                           FontSize="8"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="ConnectionStatusLabel"
                           Text="未连接"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="10">
                <TextBlock Text="访客"
                           VerticalAlignment="Center"
                           FontSize="13"/>
                <Button x:Name="SettingsButton"
                        Content="⚙"
                        FontSize="15"
                        Width="30"
                        Height="30"
                        Padding="0"
                        CornerRadius="6"/>
            </StackPanel>
        </Grid>
    </Border>

    <!-- ===== 主体区域 ===== -->
    <Grid x:Name="MainArea"
          Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== RoomListPanel：房间卡片列表 ===== -->
        <ScrollViewer x:Name="RoomListPanel"
                      Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      Padding="8,8,0,8">
            <StackPanel x:Name="RoomListContent"
                        Spacing="6"/>
        </ScrollViewer>

        <!-- 分隔装饰 -->
        <Rectangle Grid.Column="0"
                   Width="1"
                   HorizontalAlignment="Right"/>

        <!-- ===== 聊天区域 ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== MessagePanel ===== -->
            <ScrollViewer x:Name="MessagePanel"
                          Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,8,0,0">
                <StackPanel x:Name="MessageListContent"/>
            </ScrollViewer>

            <!-- ===== InputPanel：便签式输入栏 ===== -->
            <Border x:Name="InputPanel"
                    Grid.Row="1"
                    Padding="12,10"
                    CornerRadius="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="6">
                        <Button x:Name="ImageButton"
                                Content="🖼"
                                FontSize="14"
                                Width="30"
                                Height="30"
                                Padding="0"
                                CornerRadius="6"/>
                        <Button x:Name="FileButton"
                                Content="📎"
                                FontSize="14"
                                Width="30"
                                Height="30"
                                Padding="0"
                                CornerRadius="6"/>
                    </StackPanel>

                    <TextBox x:Name="MessageInput"
                             Grid.Column="1"
                             PlaceholderText="输入消息..."
                             Margin="8,0"
                             VerticalAlignment="Center"
                             CornerRadius="8"
                             Padding="10,6"/>

                    <Button x:Name="SendButton"
                            Grid.Column="2"
                            Content="➤"
                            FontSize="16"
                            Width="36"
                            Height="36"
                            Padding="0"
                            CornerRadius="8"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>

    <!-- ===== FloatingSettingsPanel：浮层卡片 ===== -->
    <Border x:Name="FloatingSettingsPanel"
            Grid.RowSpan="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,56,12,0"
            Padding="16"
            Width="220"
            CornerRadius="14"
            Visibility="Collapsed">
        <StackPanel Spacing="14">
            <StackPanel Orientation="Horizontal"
                        Spacing="6">
                <TextBlock Text="⚙"
                           FontSize="16"
                           VerticalAlignment="Center"/>
                <TextBlock Text="窗口设置"
                           FontSize="15"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Rectangle Height="1"
                       Opacity="0.3"/>

            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal"
                            Spacing="4">
                    <TextBlock Text="背景透明度"
                               VerticalAlignment="Center"
                               FontSize="13"/>
                    <TextBlock x:Name="OpacityPercentLabel"
                               Text="100%"
                               VerticalAlignment="Center"
                               FontSize="12"/>
                </StackPanel>
                <Slider x:Name="OpacitySlider"
                        Minimum="40"
                        Maximum="100"
                        SmallChange="1"
                        LargeChange="5"
                        VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <TextBlock Text="📌 置顶显示"
                           VerticalAlignment="Center"
                           FontSize="13"/>
                <ToggleSwitch x:Name="AlwaysOnTopToggle"
                              OffContent=""
                              OnContent=""/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <TextBlock Text="🖱 鼠标穿透"
                           VerticalAlignment="Center"
                           FontSize="13"/>
                <ToggleSwitch x:Name="ClickThroughToggle"
                              IsEnabled="False"
                              OffContent=""
                              OnContent=""/>
            </StackPanel>
        </StackPanel>
    </Border>
</Grid>
