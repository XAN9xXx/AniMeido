<!-- 作为本地文件加载，通过 XamlReader.Load() 解析。无 x:Class 绑定。 -->
<!-- 区域命名约定：TopBar / RoomListPanel / MessagePanel / InputPanel / FloatingSettingsPanel -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ===== TopBar ===== -->
    <Grid x:Name="TopBar"
          Grid.Row="0"
          Height="48"
          Padding="12,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="CurrentRoomLabel"
                   Grid.Column="0"
                   Text="综合讨论"
                   VerticalAlignment="Center"
                   FontSize="16"/>

        <TextBlock x:Name="ConnectionStatusLabel"
                   Grid.Column="1"
                   Text="未连接"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   FontSize="12"/>

        <Button x:Name="SettingsButton"
                Grid.Column="2"
                Content="设置"
                VerticalAlignment="Center"
                FontSize="12"/>
    </Grid>

    <!-- ===== 主体区域（房间列表 + 聊天区域） ===== -->
    <Grid x:Name="MainArea"
          Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== RoomListPanel ===== -->
        <ScrollViewer x:Name="RoomListPanel"
                      Grid.Column="0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="RoomListContent"/>
        </ScrollViewer>

        <!-- ===== 聊天区域（消息 + 输入） ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== MessagePanel ===== -->
            <ScrollViewer x:Name="MessagePanel"
                          Grid.Row="0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="MessageListContent"/>
            </ScrollViewer>

            <!-- ===== InputPanel ===== -->
            <Grid x:Name="InputPanel"
                  Grid.Row="1"
                  Height="48"
                  Padding="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageInput"
                         Grid.Column="0"
                         PlaceholderText="输入消息..."
                         VerticalAlignment="Center"/>

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="发送"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>

    <!-- ===== FloatingSettingsPanel（覆盖层，初始隐藏） ===== -->
    <Grid x:Name="FloatingSettingsPanel"
          Grid.RowSpan="2"
          HorizontalAlignment="Right"
          VerticalAlignment="Top"
          Margin="0,48,0,0"
          Padding="16"
          Width="220"
          Visibility="Collapsed">
        <StackPanel Spacing="12">
            <TextBlock Text="窗口设置"
                       FontSize="14"/>
            <!-- 透明度 -->
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <TextBlock x:Name="OpacityPercentLabel"
                           Text="100%"
                           VerticalAlignment="Center"
                           Width="36"/>
                <Slider x:Name="OpacitySlider"
                        Width="120"
                        Minimum="40"
                        Maximum="100"
                        SmallChange="1"
                        LargeChange="5"
                        VerticalAlignment="Center"/>
            </StackPanel>
            <!-- 置顶 -->
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <TextBlock Text="置顶"
                           VerticalAlignment="Center"/>
                <ToggleSwitch x:Name="AlwaysOnTopToggle"
                              OffContent=""
                              OnContent=""/>
            </StackPanel>
            <!-- 鼠标穿透（占位，暂不实现） -->
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <TextBlock Text="鼠标穿透"
                           VerticalAlignment="Center"/>
                <ToggleSwitch x:Name="ClickThroughToggle"
                              IsEnabled="False"
                              OffContent=""
                              OnContent=""/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Grid>
