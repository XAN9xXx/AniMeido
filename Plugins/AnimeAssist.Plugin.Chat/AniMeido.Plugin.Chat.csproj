<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AniMeido.Plugin.Chat</RootNamespace>
    <AssemblyName>AniMeido.Plugin.Chat</AssemblyName>
    <Version>0.2.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64</Platforms>
    <PluginPackageStage>$(BaseIntermediateOutputPath)plugin-package</PluginPackageStage>
    <PluginPackageOutput>$(MSBuildProjectDirectory)\..\..\artifacts\plugins\$(AssemblyName)-$(Version).animeido-plugin</PluginPackageOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AnimeAssist.Contracts\AniMeido.Contracts.csproj"
                      Private="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>AniMeido.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="PackPlugin" DependsOnTargets="Build">
    <RemoveDir Directories="$(PluginPackageStage)" />
    <MakeDir Directories="$(PluginPackageStage)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(PluginPackageStage)" />
    <Delete Files="$(PluginPackageOutput)" />
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\Tools\pack-plugin.ps1&quot; -PluginDir &quot;$(PluginPackageStage)&quot; -PluginId &quot;AniMeido.Plugin.Chat&quot; -DisplayName &quot;聊天室&quot; -Version &quot;$(Version)&quot; -MinAppVersion &quot;1.3.0&quot; -EntryAssembly &quot;$(AssemblyName).dll&quot; -OutputPath &quot;$(PluginPackageOutput)&quot; -ManifestTemplatePath &quot;$(MSBuildProjectDirectory)\plugin.manifest.json&quot;" />
    <Message Importance="high"
             Text="ChatPlugin package: $(PluginPackageOutput)" />
  </Target>

</Project>
