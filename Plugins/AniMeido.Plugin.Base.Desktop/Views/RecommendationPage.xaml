<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.RecommendationPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AniMeido.Plugin.Base.Views.Controls"
    xmlns:models="using:AniMeido.Plugin.Base.Models"
    xmlns:viewModels="using:AniMeido.Plugin.Base.ViewModels"
    xmlns:views="using:AniMeido.Plugin.Base.Views"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="32,28,32,32"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="16" SizeChanged="OnDesktopRecommendationSizeChanged">
        <TextBlock Text="推荐" Style="{StaticResource AniMeidoPageTitleStyle}" VerticalAlignment="Center"/>

        <InfoBar x:Name="StatusInfoBar"
                 Grid.Row="1"
                 IsClosable="True"/>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <ToggleButton x:Name="RecommendationsSectionButton"
                              Tag="recommendations"
                              Style="{StaticResource DesktopFilledSectionTabStyle}"
                              Click="OnSectionButtonClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE734;" FontSize="15"/>
                        <TextBlock Text="为你推荐"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ProfileSectionButton"
                              Tag="profile"
                              Style="{StaticResource DesktopFilledSectionTabStyle}"
                              Click="OnSectionButtonClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE77B;" FontSize="15"/>
                        <TextBlock Text="我的偏好"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="HiddenSectionButton"
                              Tag="hidden"
                              Style="{StaticResource DesktopFilledSectionTabStyle}"
                              Click="OnSectionButtonClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                        <TextBlock Text="已隐藏"/>
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
            <StackPanel x:Name="DesktopRecommendationSnapshot" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <ProgressRing Width="18" Height="18"
                              IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}"/>
                <TextBlock Text="{x:Bind ViewModel.SnapshotText, Mode=OneWay}"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="SectionBody" Grid.Row="3">
            <Grid x:Name="RecommendationsPanel"
                  RowDefinitions="Auto,*"
                  RowSpacing="16"
                  Padding="0,0,4,4">
                <ScrollViewer Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="18">
                    <Expander x:Name="ColdStartPanel" Header="选择偏好标签" IsExpanded="False" HorizontalAlignment="Stretch"
                              Visibility="{x:Bind ViewModel.IsColdStart, Mode=OneWay}">
                        <Grid x:Name="DesktopColdStartContent" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnSpacing="24">
                            <StackPanel Spacing="8">
                                <TextBlock Text="先选几个喜欢的标签"
                                           Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                                <TextBlock Text="只影响推荐，不会加进收藏标签。"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel x:Name="DesktopColdStartChoices" Grid.Column="1" Spacing="10">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SuggestedTags, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VariableSizedWrapGrid Orientation="Horizontal"
                                                           MaximumRowsOrColumns="3"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:RecommendationTagOption">
                                            <ToggleButton Content="{x:Bind Name}"
                                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                          Margin="4"
                                                          Click="OnOnboardingTagToggle"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Spacing="8">
                                    <Button Content="换一批"
                                            Style="{StaticResource DesktopSmallActionButtonStyle}"
                                            FontSize="14"
                                            Click="OnRefreshSuggestedTagsClick"/>
                                    <Button x:Name="GenerateFromTagsButton"
                                            Content="使用所选标签生成推荐"
                                            Style="{StaticResource AccentButtonStyle}"
                                            IsEnabled="False"
                                            Click="OnGenerateFromTagsClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Expander>

                <Grid x:Name="BrowseGrid" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <controls:DesktopWheelShelf x:Name="CandidateScroll" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled"
                                      VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" ViewChanged="OnCandidateScrollChanged">
                        <ItemsRepeater x:Name="RecommendationCandidates" Margin="4" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" AutomationProperties.Name="候选作品">
                            <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="12"/></ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:RecommendationItem">
                                    <controls:AnimeCard Anime="{x:Bind Anime, Mode=OneWay}" CardWidth="124" DisplayMode="Compact"
                                                        VerticalAlignment="Top" CardClicked="OnCandidateClick"
                                                        Loaded="OnCandidateLoaded" Unloaded="OnCandidateUnloaded"
                                                        DataContextChanged="OnCandidateDataContextChanged"/>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        </controls:DesktopWheelShelf>
                        <StackPanel x:Name="EmptyRecommendations" Visibility="Collapsed"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <FontIcon Glyph="&#xE734;" FontSize="30"/>
                            <TextBlock Text="本轮暂无推荐作品" FontSize="18"/>
                            <TextBlock Text="调整偏好或按 F5 刷新后再看看。"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,12">
                        <TextBlock x:Name="MoreStatusText" HorizontalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button x:Name="LoadMoreButton" Content="加载更多" HorizontalAlignment="Center" Visibility="Collapsed" Click="OnLoadMoreClick"/>
                    </StackPanel>
                    <StackPanel x:Name="DesktopRecommendationPager" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="25">
                        <Button x:Name="DesktopPreviousRecommendationButton" Content="上一部" Click="OnDesktopPreviousRecommendationClick"/>
                        <TextBlock x:Name="DesktopRecommendationPageText" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button x:Name="DesktopNextRecommendationButton" Content="下一部" Click="OnDesktopNextRecommendationClick"/>
                    </StackPanel>
                    <Border x:Name="PreviewPanel" Grid.Row="0" Grid.ColumnSpan="2" Canvas.ZIndex="2"
                            Background="{ThemeResource DesktopSurfaceBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefault}"
                            BorderThickness="1" CornerRadius="7" Padding="28">
                            <StackPanel Spacing="16">
                                <Grid x:Name="DesktopRecommendationFeature" ColumnDefinitions="*,210" ColumnSpacing="50"
                                      DataContext="{x:Bind ViewModel.SelectedItem, Mode=OneWay}">
                                        <Border x:Name="DesktopRecommendationCover" Grid.Column="1" Width="210" Height="315" CornerRadius="{ThemeResource DesktopCoverRadius}" VerticalAlignment="Top"
                                                Background="{ThemeResource DesktopCardBrush}">
                                            <Image x:Name="PreviewCover" Stretch="Uniform" Unloaded="OnCoverUnloaded"/>
                                        </Border>
                                        <StackPanel x:Name="SelectedPreviewContent" Grid.Column="0" VerticalAlignment="Top" Spacing="16">
                                            <TextBlock Text="{Binding Anime.Title}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Metadata}" TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Anime.Description}" Style="{StaticResource DesktopReadingTextStyle}" MaxLines="5" TextTrimming="CharacterEllipsis" MaxWidth="720" HorizontalAlignment="Left"/>
                                    <Expander Header="推荐依据" HorizontalAlignment="Stretch">
                                    <ItemsControl ItemsSource="{Binding Reasons}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:RecommendationReason">
                                                <Border Background="{ThemeResource DesktopCardBrush}"
                                                        CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Style="{StaticResource DesktopEmphasisTextStyle}" Text="{x:Bind Feature.DisplayName}"/>
                                                        <TextBlock Style="{StaticResource DesktopDataTextStyle}" Text="{x:Bind Text}" TextWrapping="Wrap"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </Expander>
                                    <Expander x:Name="TagPreferencesExpander" Header="标签偏好" HorizontalAlignment="Stretch">
                                    <Grid x:Name="TagPackHost" Margin="0,0,0,6">
                                        <Grid x:Name="TagPackVisual">
                                            <Border x:Name="TagPackBackdrop" CornerRadius="10" BorderThickness="1"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefault}"
                                                    Background="{ThemeResource DesktopCardBrush}" IsHitTestVisible="False"/>
                                            <Border x:Name="TagPackSurface" CornerRadius="10" Padding="12" Background="Transparent">
                                                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{x:Bind ViewModel.TagSummary, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="未设置时按你的记录自动判断" FontSize="12"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <ProgressRing x:Name="TagLoadingRing" Width="20" Height="20" MinWidth="20" MinHeight="20"
                                                                      HorizontalAlignment="Left" Visibility="Collapsed" IsActive="{x:Bind ViewModel.IsLoadingTags, Mode=OneWay}"/>
                                                        <TextBlock x:Name="TagErrorText" Visibility="Collapsed" Text="{x:Bind ViewModel.TagError, Mode=OneWay}" TextWrapping="Wrap"/>
                                                        <Button x:Name="RetryTagsButton" Visibility="Collapsed" Content="重试" Click="OnRetryTagsClick" HorizontalAlignment="Left"/>
                                                    </StackPanel>
                                                    <ScrollViewer x:Name="TagPackScroll" Grid.Row="1" MaxHeight="360" VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                                                                  VerticalScrollMode="Enabled" ZoomMode="Disabled">
                                                        <ItemsControl x:Name="TagPackList" ItemsSource="{x:Bind ViewModel.SelectedTags, Mode=OneWay}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="viewModels:RecommendationTagPreference">
                                                                    <StackPanel Padding="0,0,0,8">
                                                                        <Border CornerRadius="8" Padding="9,7" MinHeight="61"
                                                                                Background="{ThemeResource DesktopCardBrush}"
                                                                                BorderBrush="{ThemeResource ControlStrokeColorDefault}" BorderThickness="1">
                                                                            <StackPanel x:Name="CardPackFace" Spacing="5">
                                                                                <TextBlock Style="{StaticResource DesktopEmphasisTextStyle}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                                                                                <controls:DesktopChoice Tag="{x:Bind}"
                                                                                    SelectedIndex="{x:Bind viewModels:DesktopRecommendationPreference.SelectionIndex(IsLiked, IsReduced), Mode=OneWay}"
                                                                                    IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                                                                    SelectionChanged="OnDesktopTagPreferenceChanged"
                                                                                    AutomationProperties.Name="标签偏好">
                                                                                    <x:String>喜欢</x:String>
                                                                                    <x:String>未设置</x:String>
                                                                                    <x:String>减少</x:String>
                                                                                </controls:DesktopChoice>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                    </Expander>
                                    <Button x:Name="SelectedFollowButton" Content="{x:Bind ViewModel.FollowLabel, Mode=OneWay}" HorizontalAlignment="Left"
                                            Style="{StaticResource AccentButtonStyle}" Click="OnSelectedFollowClick"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="暂时跳过" Click="OnSelectedSkipClick"/>
                                        <Button x:Name="HideSelectedButton" Content="不再推荐" Click="OnSelectedHideClick"/>
                                        <Button x:Name="NotInterestedButton" Content="不感兴趣" Click="OnSelectedNotInterestedClick"/>
                                    </StackPanel>
                                    <Button Content="作品详情" HorizontalAlignment="Left" Style="{StaticResource AniMeidoNavigateButtonStyle}" Click="OnSelectedDetailsClick"/>
                                </StackPanel>
                                </Grid>
                                <TextBlock x:Name="NoSelectionText" Text="选择一部作品查看推荐依据" TextWrapping="Wrap"/>
                            </StackPanel>
                    </Border>
                </Grid>
                </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="ProfilePanel"
                  Visibility="Collapsed"
                  RowDefinitions="Auto,*"
                  RowSpacing="16"
                  Padding="0,0,4,4">
                    <Border Style="{StaticResource AniMeidoCardStyle}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="我的偏好"
                                           Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                                <TextBlock Text="根据你的评分、标记、观看进度和浏览记录自动整理，手动设置的优先。"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="清除手动设置"
                                    Click="OnClearPreferencesClick"/>
                        </Grid>
                    </Border>
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Profile, Mode=OneWay}"
                              SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DesktopListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:RecommendationFeatureProfile">
                                <Grid Padding="10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border Background="{ThemeResource DesktopCardBrush}"
                                            CornerRadius="6" Padding="8,4">
                                        <TextBlock Style="{StaticResource DesktopDataTextStyle}" Text="{x:Bind Feature.KindText}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Style="{StaticResource DesktopEmphasisTextStyle}" Text="{x:Bind Feature.DisplayName}"/>
                                        <TextBlock Style="{StaticResource DesktopDataTextStyle}" Text="{x:Bind EvidenceText}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="{x:Bind DirectionText}"
                                            Tag="{x:Bind Feature}"
                                            Click="OnPreferenceClick"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
            </Grid>

            <Grid x:Name="HiddenPanel"
                  Visibility="Collapsed"
                  RowDefinitions="Auto,*"
                  RowSpacing="16"
                  Padding="0,0,4,4">
                    <Border Style="{StaticResource AniMeidoCardStyle}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="已隐藏作品"
                                           Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                                <TextBlock Text="恢复后，刷新推荐时可能再次出现。"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="全部恢复"
                                    Click="OnClearHiddenClick"/>
                        </Grid>
                    </Border>
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.HiddenAnime, Mode=OneWay}"
                              SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DesktopListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:RecommendationHiddenAnime">
                                <Grid Padding="10" ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="3">
                                        <TextBlock Style="{StaticResource DesktopEmphasisTextStyle}" Text="{x:Bind Title}"/>
                                        <TextBlock Style="{StaticResource DesktopDataTextStyle}" Text="{x:Bind HiddenAtText}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="恢复"
                                            Tag="{x:Bind}"
                                            Click="OnRestoreClick"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
