<Page x:Class="AniMeido.Plugin.Base.Views.DragZonePreviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:AniMeido.Plugin.Base.Views.Controls"
      IsHitTestVisible="False">
    <StackPanel Spacing="12" Padding="16">
        <TextBlock Text="放送日历预览" Style="{StaticResource DesktopEmphasisTextStyle}"/>
        <ItemsControl ItemsSource="{x:Bind Samples}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><controls:AnimeCard Anime="{Binding}" DisplayMode="Poster" CardWidth="100" IsTabStop="False"/></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Page>
