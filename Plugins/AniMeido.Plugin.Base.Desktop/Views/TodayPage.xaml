<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="AniMeido.Plugin.Base.Views.TodayPage" x:Name="RootPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:AniMeido.Plugin.Base.ViewModels"
      xmlns:views="using:AniMeido.Plugin.Base.Views"
      xmlns:controls="using:AniMeido.Plugin.Base.Views.Controls"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <Style x:Key="TodaySectionCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style x:Key="TodayTileStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource DesktopCardBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style x:Key="TodayTileButtonStyle" TargetType="Button" BasedOn="{StaticResource DesktopCardButtonStyle}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- 今天的个人相关放送：封面、标题、个人状态与放送星期；日历接口不提供简介 -->
        <DataTemplate x:Key="BroadcastEntryTemplate" x:DataType="vm:TodayAnimeEntry">
            <Button Tag="{x:Bind Anime}" Click="OnAnimeButtonClick" Style="{StaticResource TodayTileButtonStyle}"
                    AutomationProperties.Name="{x:Bind Anime.Title}">
                <Grid ColumnDefinitions="56,*" ColumnSpacing="11">
                    <Border Width="56" Height="84" CornerRadius="{ThemeResource DesktopCoverRadius}" Background="{ThemeResource AniMeidoPlaceholderBackgroundBrush}">
                        <Image Tag="{x:Bind Anime}" Stretch="UniformToFill" Loaded="OnCoverLoaded" DataContextChanged="OnCoverDataContextChanged" Unloaded="OnCoverUnloaded"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{x:Bind Anime.Title}" Style="{StaticResource DesktopEmphasisTextStyle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind Badge}" Visibility="{x:Bind HasBadge}" Style="{StaticResource DesktopDataTextStyle}"/>
                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource DesktopDataTextStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- 同一标记在暖纸使用暖灰，在 Fluent 使用主题蓝色。 -->
        <DataTemplate x:Key="BroadcastDayTemplate" x:DataType="vm:TodayBroadcastDay">
            <Grid MinHeight="68" AutomationProperties.Name="{x:Bind views:TodayPage.DesktopWeekDayName(IsToday, Label, Items)}">
                <Border Style="{StaticResource TodayTileStyle}"/>
                <Border x:Name="TodayHighlight" CornerRadius="4" BorderThickness="1"
                        Background="{ThemeResource DesktopCalendarSelectedBrush}" BorderBrush="{ThemeResource DesktopCalendarSelectedEdgeBrush}"
                        Visibility="{x:Bind IsToday}" IsHitTestVisible="False"/>
                    <StackPanel Spacing="2" Margin="5">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="3">
                            <TextBlock Text="{x:Bind views:TodayPage.DesktopWeekDayLabel(IsToday, Label)}" Style="{StaticResource DesktopEmphasisDataTextStyle}"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind views:TodayPage.DesktopWeekDayCount(Items.Count)}"
                                       Style="{StaticResource DesktopDataTextStyle}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind PreviewTitles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" AutomationProperties.Name="{x:Bind}" Style="{StaticResource DesktopDataTextStyle}"
                                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{x:Bind MoreText}" Visibility="{x:Bind HasMore}" Style="{StaticResource DesktopDataTextStyle}"/>
                    </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- 作品进入详情；播放是独立操作。 -->
        <DataTemplate x:Key="PlaybackEntryTemplate" x:DataType="vm:TodayAnimeEntry">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <Button Tag="{x:Bind Anime}" Click="OnAnimeButtonClick" Style="{StaticResource TodayTileButtonStyle}" Padding="10" AutomationProperties.Name="{x:Bind Anime.Title}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Width="48" Height="68" CornerRadius="{ThemeResource DesktopCoverRadius}" Background="{ThemeResource AniMeidoPlaceholderBackgroundBrush}">
                            <Image Tag="{x:Bind Anime}" Stretch="UniformToFill" Loaded="OnCoverLoaded" DataContextChanged="OnCoverDataContextChanged" Unloaded="OnCoverUnloaded"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                            <TextBlock Text="{x:Bind Anime.Title}" Style="{StaticResource DesktopEmphasisTextStyle}" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind DisplaySubtitle}" Style="{StaticResource DesktopDataTextStyle}" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                            <ProgressBar Value="{x:Bind ProgressPercent}" Maximum="100" Visibility="{x:Bind HasProgress}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind Trailing}" Visibility="{x:Bind HasTrailing}" Style="{StaticResource DesktopDataTextStyle}" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Grid.Column="1" Visibility="{x:Bind CanPlay}" Tag="{x:Bind Anime}" Click="OnPlaybackClick" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="13"/>
                        <TextBlock Text="打开播放器"/>
                    </StackPanel>
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PlanRowCompactTemplate" x:DataType="vm:TodayPlanEntry">
            <Border x:Name="CardPackFace" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{x:Bind views:TodayPage.DesktopPlanDate(Plan.TargetStartDate)}" Style="{StaticResource DesktopEmphasisDataTextStyle}" Margin="0,4,0,0"/>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <Button Tag="{x:Bind}" Click="OnPlanDetailsClick" Style="{StaticResource DesktopSubtleButtonStyle}" Padding="0,2"
                                MinHeight="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{x:Bind Title}">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource DesktopEmphasisTextStyle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                        </Button>
                        <TextBlock Text="{x:Bind Meta}" Visibility="{x:Bind HasNormalMeta}" Style="{StaticResource DesktopDataTextStyle}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind Meta}" Visibility="{x:Bind HasOverdueMeta}" Style="{StaticResource DesktopDataTextStyle}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                        <Button Content="调整计划" Tag="{x:Bind}" Click="OnEditPlanClick" Style="{StaticResource DesktopSmallActionButtonStyle}"/>
                        <DropDownButton Content="提醒" Padding="6,2" FontSize="{ThemeResource DesktopControlTextSize}" Visibility="Collapsed" Loaded="OnDesktopReminderLoaded" Unloaded="OnDesktopReminderUnloaded">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem Text="添加提醒" Tag="{x:Bind}" Click="OnAddReminderClick"/>
                                    <MenuFlyoutItem Text="管理提醒" Tag="{x:Bind}" Click="OnManageRemindersClick"/>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 小封面复用番剧卡片；低频标记保留在右键菜单中，不遮盖封面。 -->
        <DataTemplate x:Key="ThemeRowTemplate" x:DataType="vm:TodayThemeItem">
            <Grid HorizontalAlignment="Left">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="{x:Bind PrimaryLabel, Mode=OneWay}" Tag="{x:Bind}" Visibility="{x:Bind HasPrimary, Mode=OneWay}" Opacity="{x:Bind ActionOpacity, Mode=OneWay}" Click="OnThemePrimaryClick"/>
                        <MenuFlyoutItem Text="{x:Bind SecondaryLabel, Mode=OneWay}" Tag="{x:Bind}" Visibility="{x:Bind HasSecondary, Mode=OneWay}" Opacity="{x:Bind ActionOpacity, Mode=OneWay}" Click="OnThemeSecondaryClick"/>
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <controls:AnimeCard CardWidth="92" DisplayMode="Compact" Anime="{x:Bind Anime}" CardClicked="OnDesktopThemeCardClicked"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BrowseEntryTemplate" x:DataType="vm:TodayBrowseEntry">
            <Button Tag="{x:Bind Anime}" Click="OnAnimeButtonClick" Style="{StaticResource TodayTileButtonStyle}"
                    Padding="8" Width="196" AutomationProperties.Name="{x:Bind Anime.Title}">
                <Grid ColumnDefinitions="32,*" ColumnSpacing="8">
                    <Border Width="32" Height="44" CornerRadius="{ThemeResource DesktopCoverRadius}" Background="{ThemeResource DesktopPlaceholderBrush}">
                        <Grid>
                            <TextBlock x:Name="BrowseInitial" Text="{x:Bind views:TodayPage.DesktopBrowseInitial(Anime.Title)}"
                                       Style="{StaticResource DesktopEmphasisTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="BrowseCover" Tag="{x:Bind Anime}" Stretch="UniformToFill" Opacity="0"
                                   Loaded="OnBrowseCoverLoaded" DataContextChanged="OnBrowseCoverDataContextChanged" Unloaded="OnCoverUnloaded"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="BrowseTitle" Grid.Column="1" Text="{x:Bind Anime.Title}" Style="{StaticResource DesktopControlTextStyle}"
                               VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32,23,32,35">
        <ScrollViewer x:Name="PageScroll" ViewChanged="OnPageScrollChanged" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Enabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContentPanel" Spacing="20" SizeChanged="OnContentSizeChanged">
                <!-- 页头与消息条放在无间距容器里：消息条关闭时折叠，不再留出空白 -->
                <StackPanel>
                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,18">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="13" VerticalAlignment="Bottom">
                            <TextBlock Text="今天" Style="{StaticResource AniMeidoPageTitleStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.TodayLabel, Mode=OneWay}" Style="{StaticResource DesktopDataTextStyle}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
                            <Button Click="OnRefreshClick" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                    <TextBlock Text="刷新"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    </Border>
                    <InfoBar x:Name="ErrorInfoBar" Severity="Error" IsClosable="True" Margin="0,12,0,0" Visibility="{x:Bind ErrorInfoBar.IsOpen, Mode=OneWay}"/>
                    <InfoBar x:Name="NotificationInfoBar" Severity="Informational" IsClosable="True" Margin="0,12,0,0" Visibility="{x:Bind NotificationInfoBar.IsOpen, Mode=OneWay}"/>
                </StackPanel>

                <Grid x:Name="ActivityGrid" Tag="DesktopDefault" ColumnDefinitions="1.8*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="22">
                <Border x:Name="BroadcastCard" Style="{StaticResource TodaySectionCardStyle}" Background="{ThemeResource DesktopBroadcastBrush}" BorderThickness="1" CornerRadius="6" Padding="18,17">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="24">
                        <Grid Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,0,0,14">
                            <TextBlock Text="今日放送" Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                            <Button Grid.Column="2" Content="放送日历" Style="{StaticResource AniMeidoNavigateButtonStyle}" FontSize="12" Padding="0,2" VerticalAlignment="Center" Click="OnCalendarClick"/>
                        </Grid>

                        <Grid x:Name="TodayContent" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center" SizeChanged="OnBroadcastSizeChanged">
                            <Grid MinHeight="80" Visibility="{x:Bind ViewModel.HasNoBroadcasts, Mode=OneWay}">
                                <StackPanel VerticalAlignment="Center" Spacing="5">
                                    <TextBlock Text="{x:Bind ViewModel.BroadcastMessage, Mode=OneWay}" Style="{StaticResource DesktopControlTextStyle}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind ViewModel.NextBroadcastText, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasNextBroadcast, Mode=OneWay}" Style="{StaticResource DesktopDataTextStyle}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                            <ItemsRepeater x:Name="PersonalBroadcastList" ItemsSource="{x:Bind ViewModel.PersonalBroadcasts, Mode=OneWay}"
                                           ItemTemplate="{StaticResource BroadcastEntryTemplate}" HorizontalAlignment="Left"
                                           Visibility="{x:Bind ViewModel.HasBroadcasts, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MaximumRowsOrColumns="2" MinItemWidth="205" MinItemHeight="98" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill"/>
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </Grid>

                        <ItemsRepeater x:Name="WeekStrip" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,13,0,0" VerticalAlignment="Center"
                                       SizeChanged="OnWeekSizeChanged" ItemsSource="{x:Bind ViewModel.BroadcastDays, Mode=OneWay}"
                                       ItemTemplate="{StaticResource BroadcastDayTemplate}" Visibility="{x:Bind ViewModel.HasBroadcastDays, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MaximumRowsOrColumns="7" MinItemWidth="82" MinItemHeight="68" MinColumnSpacing="5" MinRowSpacing="5" ItemsStretch="Fill"/>
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </Grid>
                </Border>

                    <Border x:Name="PlaybackCard" Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource TodaySectionCardStyle}" BorderThickness="0,1,0,0" Padding="0,14,0,0" VerticalAlignment="Top" Visibility="{x:Bind ViewModel.ShowWatchSection, Mode=OneWay}">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <TextBlock Text="最近观看" Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                            </Grid>
                            <TextBlock Text="还没有播放记录。" Visibility="{x:Bind ViewModel.HasNoRecentActivity, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.RecentActivity, Mode=OneWay}" ItemTemplate="{StaticResource PlaybackEntryTemplate}"/>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasUnstarted, Mode=OneWay}">
                                <TextBlock Text="还没开始看" Style="{StaticResource DesktopEmphasisTextStyle}"/>
                                <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ContinueWatching, Mode=OneWay}" ItemTemplate="{StaticResource PlaybackEntryTemplate}"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ThemeCard" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource TodaySectionCardStyle}" BorderThickness="0,1,0,0" Padding="0,14,0,0" VerticalAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="今日主题" Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                                <Button Grid.Column="1" Content="换一批" Command="{x:Bind ViewModel.Theme.NextBatchCommand}" Visibility="{x:Bind ViewModel.Theme.CanShowNextBatch, Mode=OneWay}" Style="{StaticResource DesktopSmallActionButtonStyle}" HorizontalAlignment="Right" FontSize="12"/>
                            </Grid>
                            <Grid x:Name="DesktopThemeLayout" ColumnDefinitions="0.65*,2.2*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16">
                                <TextBlock x:Name="DesktopThemeTitle" Text="{x:Bind ViewModel.Theme.Title, Mode=OneWay}" FontSize="22" TextWrapping="Wrap"/>
                                <ItemsRepeater x:Name="ThemeRows" Grid.Column="1" ItemsSource="{x:Bind ViewModel.Theme.Items, Mode=OneWay}" ItemTemplate="{StaticResource ThemeRowTemplate}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout x:Name="ThemeRowsLayout" MaximumRowsOrColumns="6" MinItemWidth="92" MinItemHeight="192" MinColumnSpacing="16" MinRowSpacing="12" ItemsStretch="Fill"/>
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                                <Grid x:Name="DesktopThemeStatus" Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,12,0,0" Visibility="{x:Bind ViewModel.Theme.HasStatusText, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.Theme.StatusText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Button Grid.Column="1" Content="重试" Command="{x:Bind ViewModel.Theme.RetryCommand}" Visibility="{x:Bind ViewModel.Theme.IsFailed, Mode=OneWay}" Padding="10,2" FontSize="12"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <!-- 计划保留同一实例，展开时由现有浮层接管。 -->
                    <Grid x:Name="PlanCard" Grid.Column="1" VerticalAlignment="Stretch">
                        <Grid x:Name="PlanVisual">
                            <Border x:Name="PlanBackdrop" Style="{StaticResource TodaySectionCardStyle}"
                                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" IsHitTestVisible="False"/>
                            <Border x:Name="PlanSurface" Style="{StaticResource TodaySectionCardStyle}" BorderThickness="1,0,0,0" Padding="16,17,0,0" TabFocusNavigation="Cycle">
                                <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="补番计划" Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.Plans.Count, Mode=OneWay}" Style="{StaticResource DesktopDataTextStyle}"/>
                                            <TextBlock Text="部" Style="{StaticResource DesktopDataTextStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                    <ScrollViewer x:Name="PlanScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden"
                                                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollMode="Disabled" ZoomMode="Disabled">
                                        <StackPanel>
                                            <TextBlock Text="暂无补番计划。" Visibility="{x:Bind ViewModel.HasNoPlans, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <ItemsControl x:Name="VisiblePlanList" ItemsSource="{x:Bind ViewModel.Plans, Mode=OneWay}"
                                                          ItemTemplate="{StaticResource PlanRowCompactTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><views:TodayPlanStackPanel HideRearContent="True" FanAngleStep="0" Loaded="OnPlanPanelLoaded" Tapped="OnPlanDeckTapped" Background="Transparent" IsTabStop="True" KeyDown="OnPlanDeckKeyDown"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <Button x:Name="DesktopPlanMoreButton" Grid.Row="2" Content="{x:Bind ViewModel.PlanStackHint, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.HasOverflowPlans, Mode=OneWay}" HorizontalAlignment="Left"
                                            Style="{StaticResource AniMeidoNavigateButtonStyle}" Click="OnDesktopPlanMoreClick"/>
                                    <StackPanel x:Name="PlanFooter" Grid.Row="3" Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Visibility="{x:Bind ViewModel.HasNotification, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE946;" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.NotificationMessage, Mode=OneWay}" Style="{StaticResource DesktopDataTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Content="通知设置" Style="{StaticResource AniMeidoNavigateButtonStyle}" FontSize="12" VerticalAlignment="Center" Click="OnNotificationSettingsClick"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <Border Style="{StaticResource TodaySectionCardStyle}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="最近浏览" Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                            <Button Grid.Column="1" Content="清空" Click="OnClearBrowseHistoryClick" Style="{StaticResource DesktopSmallActionButtonStyle}" FontSize="12" Visibility="{x:Bind ViewModel.HasBrowsed, Mode=OneWay}"/>
                        </Grid>
                        <TextBlock Text="还没有浏览记录。" Visibility="{x:Bind ViewModel.HasNoBrowsed, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <controls:DesktopWheelShelf x:Name="RecentBrowseScroll" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.RecentBrowsed, Mode=OneWay}" ItemTemplate="{StaticResource BrowseEntryTemplate}">
                                <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="7"/></ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </controls:DesktopWheelShelf>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <!-- 展开时迁入同一个 PlanSurface；没有第二套列表或卡片。 -->
        <Popup x:Name="PlanStackPopup" IsLightDismissEnabled="True">
            <Canvas x:Name="PlanDismissCanvas"/>
        </Popup>
    </Grid>
</Page>
