<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.GlobalSearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AniMeido.Plugin.Base.Views"
    xmlns:controls="using:AniMeido.Plugin.Base.Views.Controls"
    xmlns:vm="using:AniMeido.Plugin.Base.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- 形态筛选标签：带已加载结果中的数量 -->
        <DataTemplate x:Key="FormatChipTemplate" x:DataType="vm:PastSeasonFormatChip">
            <ToggleButton Tag="{x:Bind}"
                          IsChecked="{x:Bind IsSelected}"
                          Click="OnFormatChipClick"
                          CornerRadius="{ThemeResource ControlCornerRadius}"
                          Padding="12,4"
                          AutomationProperties.Name="{x:Bind Label}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{x:Bind Label}"/>
                    <TextBlock Style="{StaticResource DesktopDataTextStyle}" Text="{x:Bind Count}" Opacity="0.7" VerticalAlignment="Center"/>
                </StackPanel>
            </ToggleButton>
        </DataTemplate>

        <!-- “我的番剧”里匹配的作品：横向排列的小卡 -->
        <DataTemplate x:Key="LocalMatchTemplate" x:DataType="vm:PastSeasonEntry">
            <Button Margin="0,0,0,8"
                    Padding="8"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinWidth="0"
                    Tag="{x:Bind}"
                    Click="OnLocalMatchClick"
                    AutomationProperties.Name="{x:Bind Anime.Title}">
                <Grid ColumnDefinitions="40,*" ColumnSpacing="10">
                    <Border Width="40" Height="60"
                            CornerRadius="{ThemeResource DesktopCoverRadius}"
                            Background="{ThemeResource AniMeidoPlaceholderBackgroundBrush}">
                        <Image x:Name="LocalMatchCover" Stretch="UniformToFill"
                               Loaded="OnLocalCoverLoaded"
                               DataContextChanged="OnLocalCoverChanged"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Style="{StaticResource DesktopEmphasisTextStyle}" Text="{x:Bind Anime.Title}"
                                   MaxLines="2"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Style="{StaticResource DesktopDataTextStyle}" Text="{x:Bind vm:MineBrowse.StatusLabel(Status)}"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ResultCardTemplate" x:DataType="vm:PastSeasonEntry">
            <StackPanel Margin="0,0,14,14">
            <controls:AnimeCard Anime="{x:Bind Anime}"
                                DisplayMode="Poster"
                                ShowQuickActions="False"
                                TrackingStatus="{x:Bind Status}"
                                ShowMediaFormatBadge="True"
                                CardClicked="OnAnimeCardClicked"/>
            <TextBlock Style="{StaticResource DesktopDataTextStyle}" Text="{x:Bind MatchedName}" MaxLines="1"
                       MinHeight="18" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="RecentChipTemplate" x:DataType="x:String">
            <Button Margin="0,0,6,0"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Padding="12,4"
                    Content="{x:Bind}"
                    Tag="{x:Bind}"
                    Click="OnRecentSearchClick"/>
        </DataTemplate>

        <DataTemplate x:Key="SavedTagChipTemplate" x:DataType="x:String">
            <Button Margin="0,0,6,0"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Padding="12,4"
                    Tag="{x:Bind}"
                    Click="OnSavedTagClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8EC;" FontSize="12"/>
                    <TextBlock Text="{x:Bind}"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <Style x:Key="SearchPanelStyle" TargetType="Border" BasedOn="{StaticResource AniMeidoContentCardStyle}">
            <Setter Property="Padding" Value="19,17"/>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid"
          Padding="32,29,32,0"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="0"
          Loaded="OnPageLoaded" Unloaded="OnPageUnloaded">
        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,0,0,16">
            <TextBlock Text="搜索" Style="{StaticResource AniMeidoPageTitleStyle}"/>

        </StackPanel>

        <Border x:Name="SearchFormHost" Grid.Row="1" BorderBrush="{ThemeResource DesktopLineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,18">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MaxWidth="800" HorizontalAlignment="Stretch">
                <AutoSuggestBox x:Name="SearchBox"
                                QueryIcon="Find"
                                PlaceholderText="作品名或别名"
                                FontSize="15"
                                VerticalAlignment="Center"
                                QuerySubmitted="OnSearchQuerySubmitted"
                                TextChanged="OnSearchTextChanged"
                                AutomationProperties.Name="搜索作品"/>
                <Button Grid.Column="1"
                        Content="搜索"
                        Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Center"
                        Click="OnSearchClick"/>
            </Grid>
        </Border>

        <!-- 未搜索：最近搜索与收藏的标签 -->
        <ScrollViewer x:Name="LandingScroll" Grid.Row="2"
                      Margin="0,24,0,0"
                      Padding="0,0,0,24"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{x:Bind ViewModel.IsLanding, Mode=OneWay}">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="24" MaxWidth="800" HorizontalAlignment="Stretch">
                <Border Style="{StaticResource SearchPanelStyle}" Visibility="{x:Bind ViewModel.HasRecentSearches, Mode=OneWay}">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="10" ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE81C;" FontSize="14"/>
                            <TextBlock Text="最近搜索" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="清除记录" Style="{StaticResource AniMeidoNavigateButtonStyle}" Click="OnClearRecentClick"/>
                        <controls:DesktopWheelShelf Grid.Row="1"
                                      Grid.ColumnSpan="2"
                                      HorizontalScrollMode="Auto"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.RecentSearches}" ItemTemplate="{StaticResource RecentChipTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </controls:DesktopWheelShelf>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource SearchPanelStyle}" Visibility="{x:Bind ViewModel.HasSavedTags, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8EC;" FontSize="14"/>
                            <TextBlock Text="收藏的标签" FontWeight="SemiBold"/>

                        </StackPanel>
                        <controls:DesktopWheelShelf HorizontalScrollMode="Auto"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SavedTags}" ItemTemplate="{StaticResource SavedTagChipTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </controls:DesktopWheelShelf>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="2" Margin="0,24,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource AniMeidoMutedTextBrush}"
                           Text="输入作品名开始搜索"
                           Visibility="{x:Bind local:GlobalSearchPage.NoLandingVisibility(ViewModel.HasLandingContent), Mode=OneWay}"/>
            </Grid>
        </ScrollViewer>

        <!-- 搜索后：我的番剧中的匹配、搜索结果；页头随结果一起滚动 -->
        <Grid Grid.Row="2" x:Name="SearchResultsLayout" ColumnDefinitions="Auto,*" RowDefinitions="Auto,*"
              Margin="0,24,0,0" Visibility="{x:Bind ViewModel.HasSearched, Mode=OneWay}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="SearchNarrow">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PersonalMatchesPanel.Width" Value="NaN"/>
                            <Setter Target="PersonalMatchesPanel.(Grid.ColumnSpan)" Value="2"/>
                            <Setter Target="PersonalMatchesPanel.Margin" Value="0,0,0,16"/>
                            <Setter Target="LocalMatchesList.MaxHeight" Value="180"/>
                            <Setter Target="ResultGrid.(Grid.Row)" Value="1"/>
                            <Setter Target="ResultGrid.(Grid.RowSpan)" Value="1"/>
                            <Setter Target="ResultGrid.(Grid.Column)" Value="0"/>
                            <Setter Target="ResultGrid.(Grid.ColumnSpan)" Value="2"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="SearchWide">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1080"/></VisualState.StateTriggers>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
                    <StackPanel x:Name="PersonalMatchesPanel" Width="258" Margin="0,0,24,0" Spacing="12" Visibility="{x:Bind ViewModel.HasLocalMatches, Mode=OneWay}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                            <TextBlock Text="在我的番剧中" Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,2"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ViewModel.LocalSummary, Mode=OneWay}"/>
                            <Button Grid.Row="1" Grid.ColumnSpan="2"
                                    Content="在“我的番剧”中查看"
                                    Style="{StaticResource AniMeidoNavigateButtonStyle}"
                                    VerticalAlignment="Center"
                                    Click="OnOpenMineClick"/>
                        </Grid>
                        <ListView x:Name="LocalMatchesList"
                                  MaxHeight="520"
                                  ItemsSource="{x:Bind ViewModel.LocalMatches}"
                                  ItemTemplate="{StaticResource LocalMatchTemplate}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  Padding="0,0,0,6"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollMode="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.Resources>
                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent"/>
                            </ListView.Resources>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DesktopListViewItemStyle}">
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinWidth" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="IsFocusEngagementEnabled" Value="True"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                        </ListView>
                    </StackPanel>
        <GridView x:Name="ResultGrid"
                  Grid.RowSpan="2"
                  Grid.Column="1"
                  Padding="0,0,0,24"
                  ItemsSource="{x:Bind ViewModel.Results}"
                  ItemTemplate="{StaticResource ResultCardTemplate}"
                  SelectionMode="None"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Visibility="{x:Bind ViewModel.HasSearched, Mode=OneWay}">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem" BasedOn="{StaticResource DesktopGridViewItemStyle}">
                    <Setter Property="UseSystemFocusVisuals" Value="False"/>
                    <Setter Property="IsTabStop" Value="False"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.Header>
                <StackPanel Spacing="12" Margin="0,0,0,8">


                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="搜索结果" Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                        <TextBlock VerticalAlignment="Bottom"
                                   Margin="0,0,0,2"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"/>
                        <ProgressRing Width="16" Height="16"
                                      VerticalAlignment="Center"
                                      IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"/>
                    </StackPanel>

                    <CheckBox x:Name="IncludeLowVotes" Content="包含评分人数较少的作品"
                              Checked="OnIncludeLowVotesChanged" Unchecked="OnIncludeLowVotesChanged"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <controls:DesktopWheelShelf HorizontalScrollMode="Auto"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.FormatChips, Mode=OneWay}" ItemTemplate="{StaticResource FormatChipTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </controls:DesktopWheelShelf>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <ComboBox x:Name="SortComboBox" MinWidth="110" AutomationProperties.Name="排序方式"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.IsError, Mode=OneWay}" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{ThemeResource AniMeidoMutedTextBrush}"/>
                        <Button Content="重试" HorizontalAlignment="Center" Click="OnRetryClick"/>
                    </StackPanel>

                    <TextBlock Margin="0,24,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource AniMeidoMutedTextBrush}"
                               Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.HasNoResults, Mode=OneWay}"/>
                </StackPanel>
            </GridView.Header>
            <GridView.Footer>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="10"
                            Margin="0,12,0,0">
                    <Button Content="加载更多"
                            Click="OnLoadMoreClick"
                            Visibility="{x:Bind ViewModel.CanLoadMore, Mode=OneWay}"
                            IsEnabled="{x:Bind local:GlobalSearchPage.NotLoadingMore(ViewModel.IsLoadingMore), Mode=OneWay}"/>
                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}"/>
                </StackPanel>
            </GridView.Footer>
        </GridView>

        </Grid>

        <Canvas Grid.RowSpan="3"
                x:Name="DragOverlay"
                Visibility="Collapsed"
                Background="Transparent"
                AllowDrop="True"/>
    </Grid>
</Page>
