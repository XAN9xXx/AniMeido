<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.PastSeasonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AniMeido.Plugin.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:controls="using:AniMeido.Plugin.Base.Views.Controls"
    xmlns:vm="using:AniMeido.Plugin.Base.ViewModels">

    <Page.Resources>
        <!-- 形态筛选标签：带本季数量，选中时为强调色 -->
        <DataTemplate x:Key="FormatChipTemplate" x:DataType="vm:DesktopCatalogFormatChip">
            <ToggleButton Tag="{x:Bind Chip, Mode=OneWay}"
                          IsChecked="{x:Bind Chip.IsSelected, Mode=OneWay}"
                          IsEnabled="{x:Bind CanSelect, Mode=OneWay}"
                          Click="OnFormatChipClick"
                          CornerRadius="{ThemeResource ControlCornerRadius}"
                          Padding="9,4"
                          AutomationProperties.Name="{x:Bind Chip.Label}">
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4">
                    <TextBlock Text="{x:Bind Chip.Label}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource DesktopDataTextStyle}"
                               Text="{x:Bind Chip.Count, Mode=OneWay}" Opacity="0.7" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <!-- 用同字号的数字占位，换季时计数位数变化也不推挤后面的按钮。 -->
                    <TextBlock Grid.Column="1" Style="{StaticResource DesktopDataTextStyle}" Text="8888" Opacity="0"
                               IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
                </Grid>
            </ToggleButton>
        </DataTemplate>

        <Style x:Key="SeasonPickButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0,6"/>
        </Style>
        <DataTemplate x:Key="DesktopPosterTemplate" x:DataType="vm:PastSeasonEntry">
            <controls:AnimeCard Anime="{x:Bind Anime}"
                                DisplayMode="Poster"
                                ShowQuickActions="False"
                                TrackingStatus="{x:Bind Status}"
                                ShowMediaFormatBadge="True"
                                ShowSeasonDate="True"
                                Loading="OnCatalogCardLoading" Unloaded="OnCatalogCardUnloaded"
                                CardClicked="OnAnimeCardClicked"
                                VerticalAlignment="Top" Margin="0,0,16,20"/>
        </DataTemplate>
        <DataTemplate x:Key="DesktopDetailedTemplate" x:DataType="vm:PastSeasonEntry">
            <controls:AnimeCard Anime="{Binding Anime, Mode=OneWay}"
                                DisplayMode="Detailed"
                                Loading="OnCatalogCardLoading" Unloaded="OnCatalogCardUnloaded"
                                ShowQuickActions="False"
                                TrackingStatus="{Binding Status, Mode=OneWay}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                CardClicked="OnAnimeCardClicked"/>
        </DataTemplate>
        <DataTemplate x:Key="DesktopDetailedRowTemplate" x:DataType="vm:DesktopCatalogRow">
            <Grid x:Name="DetailedRow" ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,0,0,20">
                <ContentPresenter Grid.ColumnSpan="{Binding DataContext.FirstColumnSpan, ElementName=DetailedRow}"
                                  Content="{Binding DataContext.First, ElementName=DetailedRow}" DataContext="{Binding DataContext.First, ElementName=DetailedRow}" ContentTemplate="{StaticResource DesktopDetailedTemplate}"
                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <ContentPresenter Grid.Column="1" Content="{Binding DataContext.Second, ElementName=DetailedRow}" DataContext="{Binding DataContext.Second, ElementName=DetailedRow}"
                                  ContentTemplate="{StaticResource DesktopDetailedTemplate}"
                                  Visibility="{Binding DataContext.HasSecond, ElementName=DetailedRow}"
                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="DesktopPosterRowTemplate" x:DataType="vm:DesktopCatalogPosterRow">
            <ItemsControl ItemsSource="{x:Bind Entries}" MinHeight="{x:Bind MinimumHeight, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentPresenter Content="{Binding}" DataContext="{Binding}" ContentTemplate="{StaticResource DesktopPosterTemplate}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootGrid"
          AllowDrop="True"
          Padding="32,29,32,0"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          RowDefinitions="Auto,Auto,Auto,*"
          Loaded="OnPageLoaded"
          Unloaded="OnPageUnloaded"
          KeyDown="OnRootKeyDown"
          KeyboardAcceleratorPlacementMode="Hidden">
        <!-- 快捷键挂在整页上，不显示悬停提示，否则鼠标移到页面任何位置都会弹出“Ctrl+F”。 -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFindAcceleratorInvoked"/>
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshInvoked"/>
        </Grid.KeyboardAccelerators>

        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,0,0,24">
            <TextBlock Text="番剧库" Style="{StaticResource AniMeidoPageTitleStyle}"/>
            <TextBlock x:Name="SeasonSummary"
                       Style="{StaticResource AniMeidoPageSubtitleStyle}"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,4"/>
            <TextBlock x:Name="SeasonSwitchHint" Text="正在切换季度…" Visibility="Collapsed"
                       Style="{StaticResource AniMeidoPageSubtitleStyle}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
        </StackPanel>

        <!-- 意外错误（刷新缓存失败等）；数据源失败显示在内容区 -->
        <InfoBar x:Name="ErrorInfoBar"
                 Grid.Row="1"
                 Severity="Error"
                 IsClosable="True"
                 IsOpen="False"
                 Margin="0,0,0,12"/>

        <!-- 工具栏：宽时一行；窄时季度与形态一行，其余一行（由 code-behind 按宽度切换） -->
        <Border x:Name="Toolbar"
                Grid.Row="2"
                Background="Transparent" BorderThickness="0" Padding="0">
            <Grid x:Name="ToolbarGrid" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                <Border Grid.ColumnSpan="2" BorderBrush="{ThemeResource DesktopLineBrush}"
                        BorderThickness="0,0,0,1" Padding="0,0,0,16">
                <Grid x:Name="PrimaryTools" ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <!-- 季度切换器：左右逐季翻，点中间选年份与季度 -->
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="PrevSeasonButton"
                                Click="OnPrevSeasonClick"
                                Padding="8,7"
                                AutomationProperties.Name="上一季">
                            <FontIcon Glyph="&#xE76B;" FontSize="12"/>
                        </Button>
                        <Button x:Name="SeasonPickerButton" MinWidth="140" AutomationProperties.Name="选择季度">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="SeasonLabel" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SeasonMonthsLabel"
                                           Visibility="Collapsed"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <controls:DesktopDisclosureChevron FontSize="10" VerticalAlignment="Center" PaperOnly="True"
                                    Flyout="{Binding Flyout, ElementName=SeasonPickerButton}"/>
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout x:Name="SeasonFlyout" Placement="BottomEdgeAlignedLeft" Opening="OnSeasonFlyoutOpening">
                                    <StackPanel Width="272" Spacing="12">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <Button x:Name="FlyoutPrevYearButton"
                                                    Click="OnFlyoutPrevYearClick"
                                                    Padding="8,7"
                                                    AutomationProperties.Name="上一年">
                                                <FontIcon Glyph="&#xE76B;" FontSize="12"/>
                                            </Button>
                                            <NumberBox x:Name="FlyoutYearBox"
                                                       Grid.Column="1"
                                                       SpinButtonPlacementMode="Hidden"
                                                       ValidationMode="InvalidInputOverwritten"
                                                       ValueChanged="OnFlyoutYearChanged"
                                                       AutomationProperties.Name="年份"/>
                                            <Button x:Name="FlyoutNextYearButton"
                                                    Grid.Column="2"
                                                    Click="OnFlyoutNextYearClick"
                                                    Padding="8,7"
                                                    AutomationProperties.Name="下一年">
                                                <FontIcon Glyph="&#xE76C;" FontSize="12"/>
                                            </Button>
                                        </Grid>
                                        <Grid x:Name="FlyoutSeasonGrid" ColumnDefinitions="*,*,*,*" ColumnSpacing="6"/>
                                        <Grid ColumnDefinitions="*,Auto">

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Button Content="最新一季" Click="OnLatestSeasonClick"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="NextSeasonButton"
                                Click="OnNextSeasonClick"
                                Padding="8,7"
                                AutomationProperties.Name="下一季">
                            <FontIcon Glyph="&#xE76C;" FontSize="12"/>
                        </Button>
                    </StackPanel>

                    <!-- 形态标签；放不下时横向滚动 -->
                    <controls:DesktopWheelShelf Grid.Column="1"
                                  HorizontalScrollMode="Auto"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{x:Bind FormatChipSlots}"
                                      ItemTemplate="{StaticResource FormatChipTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </controls:DesktopWheelShelf>
                </Grid>
                </Border>

                <Grid x:Name="SecondaryTools" Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <ComboBox x:Name="SortComboBox" MinWidth="112" AutomationProperties.Name="排序方式"/>
                        <Button x:Name="SortDirectionButton" Click="OnSortDirectionClick" Padding="8,7">
                            <FontIcon x:Name="SortDirectionIcon" FontSize="14"/>
                        </Button>
                    </StackPanel>
                    <ToggleSwitch x:Name="HideCompletedSwitch"
                                  Grid.Column="1"
                                  Header="隐藏看过"
                                  MinWidth="0"
                                  VerticalAlignment="Center"
                                  Toggled="OnHideCompletedToggled">
                        <ToggleSwitch.Resources>
                            <x:Double x:Key="ToggleSwitchThemeMinWidth">0</x:Double>
                        </ToggleSwitch.Resources>
                    </ToggleSwitch>
                    <AutoSuggestBox x:Name="FilterBox"
                                    Grid.Column="0"
                                    MinWidth="180" MaxWidth="360" HorizontalAlignment="Stretch"
                                    QueryIcon="Find"
                                    PlaceholderText="在本季中搜索"
                                    VerticalAlignment="Center"
                                    TextChanged="OnFilterTextChanged"
                                    AutomationProperties.Name="在本季中搜索"/>

                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,20,0,0">
            <ScrollViewer x:Name="CatalogScroller" Padding="0,0,0,24"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Disabled" SizeChanged="OnCatalogSizeChanged"
                          ViewChanged="OnCatalogViewChanged" LayoutUpdated="OnCatalogLayoutUpdated">
                <ItemsRepeater x:Name="CatalogRows" ItemTemplate="{StaticResource DesktopPosterRowTemplate}">
                    <ItemsRepeater.Layout><StackLayout Orientation="Vertical"/></ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- 加载超过片刻才显示骨架，工具栏在加载时保持可用 -->
            <ItemsRepeater x:Name="SkeletonRepeater" Visibility="Collapsed" IsHitTestVisible="False">
                <ItemsRepeater.Layout>
                    <UniformGridLayout x:Name="SkeletonLayout"
                                       MinItemWidth="166"
                                       MinItemHeight="290"
                                       MinColumnSpacing="0"
                                       MinRowSpacing="0"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="x:Int32">
                        <Grid Margin="6,6,10,14" RowDefinitions="*,Auto" RowSpacing="10">
                            <Border CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource AniMeidoPlaceholderBackgroundBrush}"/>
                            <StackPanel Grid.Row="1" Spacing="6" Padding="4,0">
                                <Border Height="12" CornerRadius="4" Background="{ThemeResource AniMeidoPlaceholderBackgroundBrush}"/>
                                <Border Height="10" Width="72" HorizontalAlignment="Left" CornerRadius="4" Background="{ThemeResource AniMeidoPlaceholderBackgroundBrush}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- 空结果：筛选造成的可以一键清除 -->
            <StackPanel Visibility="{x:Bind ViewModel.HasNoResults, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        Margin="0,48,0,0"
                        Spacing="12">
                <FontIcon Glyph="&#xE11A;" Style="{StaticResource AniMeidoEmptyStateIconStyle}"/>
                <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <Button Content="清除筛选"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.CanClearFilters, Mode=OneWay}"
                        Click="OnClearFiltersClick"/>
            </StackPanel>

            <!-- 数据源失败：说明原因并可重试 -->
            <StackPanel Visibility="{x:Bind ViewModel.IsError, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        Margin="0,48,0,0"
                        MaxWidth="360"
                        Spacing="12">
                <Image
                       Width="64"
                       Height="64"
                       Stretch="Uniform">
                    <Image.Source>
                        <BitmapImage DecodePixelType="Logical" DecodePixelHeight="64" UriSource="ms-appx:///Assets/Loading_failed.png"/>
                    </Image.Source>
                </Image>
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{ThemeResource AniMeidoMutedTextBrush}"/>
                <Button Content="重试" HorizontalAlignment="Center" Click="OnRetryClick"/>
            </StackPanel>
        </Grid>

        <Canvas x:Name="DragOverlay"
                Grid.RowSpan="4"
                Visibility="Collapsed"
                Background="Transparent"
                AllowDrop="True"/>
    </Grid>
</Page>
