<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.PersonSearchResultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AniMeido.Plugin.Base.Views"
    xmlns:controls="using:AniMeido.Plugin.Base.Views.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <DataTemplate x:Key="DesktopPersonWorkTemplate" x:DataType="local:DesktopPersonWork">
            <StackPanel Width="170" Spacing="4" Margin="0,0,16,18">
                <controls:AnimeCard Anime="{x:Bind Anime}" DisplayMode="Poster" ShowQuickActions="False" CardClicked="OnAnimeCardClicked" CardWidth="170"/>
                <TextBlock Text="{x:Bind Role}" Style="{StaticResource DesktopDataTextStyle}" Margin="2,0" MaxLines="2" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PersonRowTemplate" x:DataType="local:DesktopPersonRow">
            <StackPanel>
                <TextBlock Style="{StaticResource AniMeidoSectionTitleStyle}" Text="{x:Bind YearLabel}" Margin="0,8,0,14"
                           Visibility="{x:Bind HasYearLabel}" Foreground="{ThemeResource DesktopAccentBrush}"/>
                <ItemsControl ItemsSource="{x:Bind Works}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding}" DataContext="{Binding}" ContentTemplate="{StaticResource DesktopPersonWorkTemplate}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>
    <Grid x:Name="RootGrid" AllowDrop="True" Padding="32,29,32,24" Loaded="OnPageLoaded" Unloaded="OnPageUnloaded" RowDefinitions="Auto,*" RowSpacing="19">
        <Border BorderBrush="{ThemeResource DesktopLineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,17">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <TextBlock x:Name="TitleBlock" Style="{StaticResource AniMeidoPageTitleStyle}" TextWrapping="Wrap"/>
            <TextBlock x:Name="ResultCount" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,3"
                       MaxWidth="320" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
        </Border>
        <ScrollViewer x:Name="ResultScroller" Grid.Row="1" Padding="0,0,0,16" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      SizeChanged="OnResultSizeChanged" ViewChanged="OnResultViewChanged" LayoutUpdated="OnResultLayoutUpdated">
            <ItemsRepeater x:Name="ResultRows" ItemTemplate="{StaticResource PersonRowTemplate}">
                <ItemsRepeater.Layout><StackLayout Orientation="Vertical"/></ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>
        <Grid Grid.Row="1" x:Name="LoadingOverlay" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <ProgressRing x:Name="LoadingRing" Width="32" Height="32" HorizontalAlignment="Center"/>
                <TextBlock x:Name="LoadingText" Text="正在读取…" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>
        <Canvas x:Name="DragOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="Transparent" AllowDrop="True"/>
    </Grid>
</Page>
