<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.TagSearchResultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contracts="using:AniMeido.Contracts.Models"
    xmlns:controls="using:AniMeido.Plugin.Base.Views.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid x:Name="RootGrid" Padding="32,29,32,24" RowDefinitions="Auto,*" RowSpacing="19" Loaded="OnPageLoaded" Unloaded="OnPageUnloaded">
        <Border BorderBrush="{ThemeResource DesktopLineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,17">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
            <TextBlock Style="{StaticResource AniMeidoPageTitleStyle}" TextWrapping="Wrap">
                <Run x:Name="TagTitle"/>
            </TextBlock>
            <TextBlock x:Name="ResultCount" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,3"
                       MaxWidth="320" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="FavoriteTagButton" Content="收藏标签" Click="OnFavoriteClick" IsEnabled="False"/>
                <TextBlock x:Name="FavoriteMessage" TextWrapping="Wrap" MaxWidth="220" Foreground="{ThemeResource DesktopMutedBrush}"/>
            </StackPanel>
        </Grid>
        </Border>
        <Grid Grid.Row="1" x:Name="TagWorkspace" ColumnDefinitions="270,*" RowDefinitions="Auto,*" ColumnSpacing="24" RowSpacing="16">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="TagNarrow">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="TagFilterPanel.(Grid.ColumnSpan)" Value="2"/>
                            <Setter Target="ResultGrid.(Grid.Column)" Value="0"/>
                            <Setter Target="ResultGrid.(Grid.Row)" Value="1"/>
                            <Setter Target="ResultGrid.(Grid.ColumnSpan)" Value="2"/>
                            <Setter Target="ResultGrid.(Grid.RowSpan)" Value="1"/>
                            <Setter Target="LoadingOverlay.(Grid.Column)" Value="0"/>
                            <Setter Target="LoadingOverlay.(Grid.Row)" Value="1"/>
                            <Setter Target="LoadingOverlay.(Grid.ColumnSpan)" Value="2"/>
                            <Setter Target="LoadingOverlay.(Grid.RowSpan)" Value="1"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="TagWide">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1060"/></VisualState.StateTriggers>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="TagFilterPanel" VerticalAlignment="Top" Style="{StaticResource AniMeidoContentCardStyle}" Background="{ThemeResource DesktopNavigationBrush}" Padding="15">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="开播年份"/>
                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="6">
                            <ComboBox x:Name="YearFromCombo" SelectedIndex="0" SelectionChanged="OnYearRangeChanged" HorizontalAlignment="Stretch" MinWidth="0" AutomationProperties.Name="起始年份"/>
                            <TextBlock Grid.Column="1" Text="至" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="YearToCombo" Grid.Column="2" SelectedIndex="0" SelectionChanged="OnYearRangeChanged" HorizontalAlignment="Stretch" MinWidth="0" AutomationProperties.Name="结束年份"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="排序"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <ComboBox x:Name="SortSelector" SelectedIndex="0" SelectionChanged="OnSortChanged" HorizontalAlignment="Stretch" MinWidth="0" AutomationProperties.Name="排序方式">
                                <ComboBoxItem Tag="rank">评分</ComboBoxItem>
                                <ComboBoxItem Tag="date">开播日期</ComboBoxItem>
                            </ComboBox>
                            <ToggleButton x:Name="SortOrderToggle" Grid.Column="1" Content="↓" IsChecked="True" Click="OnSortOrderToggle" MinWidth="32" AutomationProperties.Name="切换升降序"/>
                        </Grid>
                    </StackPanel>
                    <CheckBox x:Name="IncludeLowVotesCheckBox" Click="OnIncludeLowVotesChanged">
                        <TextBlock Text="包含评分人数较少的作品" TextWrapping="Wrap"/>
                    </CheckBox>
                </StackPanel>
            </Border>
            <GridView x:Name="ResultGrid" Grid.Column="1" Grid.RowSpan="2" SelectionMode="None" Padding="0,0,0,12"
                      ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Disabled">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem" BasedOn="{StaticResource DesktopGridViewItemStyle}">
                        <Setter Property="UseSystemFocusVisuals" Value="False"/>
                        <Setter Property="IsTabStop" Value="False"/>
                        <Setter Property="Margin" Value="0,0,16,20"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Top"/>
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <controls:AnimeCard Anime="{Binding}" DisplayMode="Poster" ShowQuickActions="False" CardClicked="OnAnimeCardClicked"/>
                    </DataTemplate>
                </GridView.ItemTemplate>
                <GridView.Footer>
                    <Border x:Name="PaginationBar" Visibility="Collapsed" Padding="0,20">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                            <Button x:Name="PrevButton" Content="上一页" Click="OnPrevPage"/>
                            <TextBlock x:Name="PageInfo" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Button x:Name="NextButton" Content="下一页" Click="OnNextPage"/>
                        </StackPanel>
                    </Border>
                </GridView.Footer>
            </GridView>
            <Grid Grid.Column="1" Grid.RowSpan="2" x:Name="LoadingOverlay" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                    <ProgressRing x:Name="LoadingRing" Width="32" Height="32" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LoadingText" Text="正在读取…" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Canvas x:Name="DragOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="Transparent" AllowDrop="True"/>
    </Grid>
</Page>
