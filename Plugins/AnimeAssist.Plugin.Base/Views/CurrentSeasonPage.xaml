<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.CurrentSeasonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AniMeido.Plugin.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:AniMeido.Plugin.Base.Views.Controls"
    xmlns:vm="using:AniMeido.Plugin.Base.ViewModels"
    xmlns:contracts="using:AniMeido.Contracts.Models">

    <Grid AllowDrop="True"
          Padding="24,20,24,24"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          Loaded="OnPageLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Spacing="12"
                    Margin="0,0,0,16">
            <StackPanel Spacing="2">
                <TextBlock Text="放送日历"
                           Style="{StaticResource AniMeidoPageTitleStyle}"/>
                <TextBlock Text="按星期浏览本季正在放送的动画"
                           Style="{StaticResource AniMeidoPageSubtitleStyle}"/>
            </StackPanel>
            <InfoBar x:Name="ErrorInfoBar"
                     Severity="Error"
                     IsClosable="True"
                     IsOpen="False"/>
            <Border Style="{StaticResource AniMeidoToolbarStyle}">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="8">
                    <FontIcon Glyph="&#xE721;"
                              FontSize="14"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="FilterBox"
                             Grid.Column="1"
                             PlaceholderText="搜索本季番剧"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="14"
                             TextChanged="OnFilterTextChanged"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- 内容区域：加载完成时可见 -->
        <ScrollViewer Grid.Row="1"
                      x:Name="RootScrollViewer">
            <Grid>

                <StackPanel x:Name="EmptyState"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            Margin="0,40,0,0">
                    <FontIcon Glyph="&#xE11A;"
                              Style="{StaticResource AniMeidoEmptyStateIconStyle}"/>
                    <TextBlock Text="当季暂无新番数据"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"/>
                    <TextBlock Text="稍后刷新，或检查网络和 Bangumi 数据源"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 按星期分组展示当季番剧 -->
                <ItemsRepeater x:Name="WeekdayRepeater"
                               ItemsSource="{x:Bind ViewModel.WeekdayGroups}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="12"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:WeekdayGroup">
                            <Border Style="{StaticResource AniMeidoContentCardStyle}"
                                    Padding="16">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind WeekdayName}"
                                               Style="{StaticResource AniMeidoSectionTitleStyle}"
                                               Margin="0,0,0,12"/>
                                    <GridView ItemsSource="{x:Bind Items}"
                                              SelectionMode="None"
                                              ScrollViewer.HorizontalScrollMode="Disabled"
                                              ScrollViewer.VerticalScrollMode="Disabled">
                                        <GridView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </GridView.ItemsPanel>
                                        <GridView.ItemContainerStyle>
                                            <Style TargetType="GridViewItem">
                                                <Setter Property="UseSystemFocusVisuals"
                                                        Value="False"/>
                                                <Setter Property="IsTabStop"
                                                        Value="False"/>
                                                <Setter Property="Margin"
                                                        Value="0,0,4,8"/>
                                            </Style>
                                        </GridView.ItemContainerStyle>
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="contracts:Anime">
                                                <controls:AnimeCard CardClicked="OnAnimeCardClicked"/>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </ScrollViewer>

        <!-- 加载/重试覆盖层：加载中或出错时覆盖内容区域 -->
        <Grid Grid.Row="1"
              x:Name="LoadingOverlay"
              Visibility="Collapsed"
              Background="{ThemeResource AniMeidoOverlayScrimBrush}"
              Tapped="OnLoadingOverlayTapped">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <ProgressRing x:Name="LoadingRing"
                              Height="40"
                              Width="40"
                              HorizontalAlignment="Center"
                              IsActive="True"/>
                <Image x:Name="LoadingFailedImage"
                       Source="ms-appx:///Assets/Loading_failed.png"
                       Width="80"
                       Height="80"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed"/>
                <TextBlock x:Name="LoadingHint"
                           FontSize="14"
                           Foreground="{ThemeResource AniMeidoMutedTextBrush}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="300"
                           TextAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 拖放目标覆盖层：拖放开始时显示，动态生成 zone -->
        <Canvas x:Name="DragOverlay"
                Grid.RowSpan="2"
                Visibility="Collapsed"
                Background="Transparent"
                AllowDrop="True"/>
    </Grid>
</Page>

