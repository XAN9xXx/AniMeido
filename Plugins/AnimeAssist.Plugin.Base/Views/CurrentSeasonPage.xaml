<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.CurrentSeasonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AniMeido.Plugin.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:AniMeido.Plugin.Base.Views.Controls"
    xmlns:contracts="using:AniMeido.Contracts.Models">

    <ScrollViewer>
        <StackPanel>
            <ProgressRing x:Name="LoadingRing" IsActive="{x:Bind ViewModel.IsLoading}" 
                  Height="40" Width="40"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Button Content="重试" 
            Command="{x:Bind ViewModel.RetryLoadCommand}"/>
            <GridView ItemsSource="{x:Bind ViewModel.AnimeList}"
                      IsItemClickEnabled="True"
                      ItemClick="OnItemClick">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="contracts:Anime">
                        <controls:AnimeCard />
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>
    </ScrollViewer>
</Page>