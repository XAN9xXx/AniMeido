<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.CurrentSeasonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AniMeido.Plugin.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:AniMeido.Plugin.Base.Views.Controls"
    xmlns:vm="using:AniMeido.Plugin.Base.ViewModels"
    xmlns:contracts="using:AniMeido.Contracts.Models">

    <Grid AllowDrop="True"
          Loaded="OnPageLoaded"
          PointerMoved="OnRootPointerMoved">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 错误提示 + 搜索过滤 (固定在顶部) -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,12">
            <InfoBar x:Name="ErrorInfoBar"
                     Severity="Error"
                     IsClosable="True"
                     IsOpen="False"
                     Margin="0,0,0,12"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8"
                    Padding="12,6">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="8">
                    <TextBlock Text="&#xE71A;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="FilterBox"
                             Grid.Column="1"
                             PlaceholderText="搜索当前季番剧…"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="14"
                             TextChanged="OnFilterTextChanged"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- 内容区域：加载完成时可见 -->
        <ScrollViewer Grid.Row="1"
                      x:Name="RootScrollViewer">
            <StackPanel>

                <!-- 空状态提示 -->
                <StackPanel x:Name="EmptyState"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            Margin="0,40,0,0">
                    <Image Source="ms-appx:///Assets/Empty_anime.png"
                           Width="120"
                           Height="120"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"/>
                    <TextBlock Text="当季暂无新番数据"
                               FontSize="16"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"/>
                </StackPanel>

                <!-- 按星期分组展示当季番剧 -->
                <ItemsControl x:Name="WeekdayRepeater"
                              ItemsSource="{x:Bind ViewModel.WeekdayGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WeekdayGroup">
                            <Border Background="{ThemeResource SolidBackgroundFillColorSecondary}"
                                    CornerRadius="8"
                                    Margin="0,0,0,12"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind WeekdayName}"
                                               Style="{StaticResource SubtitleTextBlockStyle}"
                                               Margin="0,0,0,8"/>
                                    <GridView ItemsSource="{x:Bind Items}"
                                              IsItemClickEnabled="True"
                                              ItemClick="OnWeekdayItemClick"
                                              SelectionMode="None"
                                              ScrollViewer.HorizontalScrollMode="Disabled"
                                              ScrollViewer.VerticalScrollMode="Disabled">
                                        <GridView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </GridView.ItemsPanel>
                                        <GridView.ItemContainerStyle>
                                            <Style TargetType="GridViewItem">
                                                <Setter Property="UseSystemFocusVisuals"
                                                        Value="False"/>
                                                <Setter Property="IsTabStop"
                                                        Value="False"/>
                                                <Setter Property="Margin"
                                                        Value="0,0,4,8"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="GridViewItem">
                                                            <ContentPresenter
                                                                Content="{TemplateBinding Content}"
                                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                Margin="0"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GridView.ItemContainerStyle>
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="contracts:Anime">
                                                <controls:AnimeCard/>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- 加载/重试覆盖层：加载中或出错时覆盖内容区域 -->
        <Grid Grid.Row="1"
              x:Name="LoadingOverlay"
              Visibility="Collapsed"
              Background="#B0000000"
              Tapped="OnLoadingOverlayTapped">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <ProgressRing x:Name="LoadingRing"
                              Height="40"
                              Width="40"
                              HorizontalAlignment="Center"
                              IsActive="True"/>
                <Image x:Name="LoadingFailedImage"
                       Source="ms-appx:///Assets/Loading_failed.png"
                       Width="80"
                       Height="80"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed"/>
                <TextBlock x:Name="LoadingHint"
                           FontSize="14"
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="300"
                           TextAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 拖放目标覆盖层：拖放开始时显示，动态生成 zone -->
        <Canvas x:Name="DragOverlay"
                Grid.RowSpan="2"
                Visibility="Collapsed"
                Background="Transparent"
                AllowDrop="True"
                PointerMoved="OnRootPointerMoved"/>
    </Grid>
</Page>