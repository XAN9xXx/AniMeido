<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AnimeAssist.Plugin.Base.Views.CurrentSeasonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AnimeAssist.Plugin.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008">

    <Page.Resources>
        <DataTemplate x:Key="ImageTemplate" xmlns:contracts="using:AnimeAssist.Contracts.Models" x:DataType="contracts:Anime">
            <Grid Width="120" Height="150">
                <Image Source="{x:Bind CoverURL}" Stretch="UniformToFill"/>
                <TextBlock Text="{x:Bind Title}" Margin="0,125,0,0"/>
                <TextBlock Text="{x:Bind AirDate}" Margin="0,145,0,0"/>
                <TextBlock Text="{x:Bind Description}" Margin="0,165,0,0"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <GridView
        x:Name="BasicGridView"
        ItemTemplate="{StaticResource ImageTemplate}"/>
    
</Page>