<Page
    x:Class="AniMeido.Plugin.Base.Views.DataManagementSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24"
                    Spacing="16">

            <TextBlock Text="数据管理"
                       FontSize="20"
                       FontWeight="Bold"/>

            <!-- 本地缓存 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="本地缓存"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="番剧数据缓存到本地后可离线浏览，减少重复请求。"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="WrapWholeWords"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CacheInfoText"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button x:Name="ClearCacheButton"
                                Grid.Column="1"
                                Content="清理缓存"
                                Height="32"
                                MinWidth="80"
                                Click="OnClearCacheClick"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 数据路径 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="数据路径"
                               Margin="16,12,16,4"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Grid Margin="16,0,16,0"
                            Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="数据库路径"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="DbPathText"
                                    FontSize="13"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="打开文件夹"
                                Height="32"
                                VerticalAlignment="Center"
                                Click="OnOpenDbDirClick"/>
                    </Grid>
                    <Rectangle Height="1"
                            Fill="{ThemeResource DividerStrokeColorDefault}"
                            Margin="16,0"/>
                    <Grid Margin="16,0,16,0"
                            Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="备份路径"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="BackupPathText"
                                    FontSize="13"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="打开文件夹"
                                Height="32"
                                VerticalAlignment="Center"
                                Click="OnOpenBackupDirClick"/>
                    </Grid>
                    <Rectangle Height="1"
                            Fill="{ThemeResource DividerStrokeColorDefault}"
                            Margin="16,0"/>
                    <Grid Margin="16,0,16,0"
                            Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="日志路径"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="LogPathText"
                                    FontSize="13"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="打开文件夹"
                                Height="32"
                                VerticalAlignment="Center"
                                Click="OnOpenLogDirClick"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 备份 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="备份与恢复"
                               Margin="16,12,16,4"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Grid Margin="16,0,16,0"
                            Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="立即备份"
                                VerticalAlignment="Center"
                                FontSize="15"/>
                        <Button Grid.Column="1"
                                x:Name="BackupNowButton"
                                Content="备份"
                                Height="32"
                                VerticalAlignment="Center"
                                Click="OnBackupNowClick"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 导入导出 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="导入导出"
                               Margin="16,12,16,4"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Grid Margin="16,0,16,0"
                            Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="导出追番数据"
                                VerticalAlignment="Center"
                                FontSize="15"/>
                        <Button Grid.Column="1"
                                x:Name="ExportButton"
                                Content="导出"
                                Height="32"
                                VerticalAlignment="Center"
                                Click="OnExportClick"/>
                    </Grid>
                    <Rectangle Height="1"
                            Fill="{ThemeResource DividerStrokeColorDefault}"
                            Margin="16,0"/>
                    <Grid Margin="16,0,16,0"
                            Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="导入追番数据"
                                VerticalAlignment="Center"
                                FontSize="15"/>
                        <Button Grid.Column="1"
                                x:Name="ImportButton"
                                Content="导入"
                                Height="32"
                                VerticalAlignment="Center"
                                Click="OnImportClick"/>
                    </Grid>
                    <Rectangle Height="1"
                            Fill="{ThemeResource DividerStrokeColorDefault}"
                            Margin="16,0"/>
                    <Grid Margin="16,0,16,0"
                          MinHeight="56">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="完整档案 ZIP"
                                       FontSize="15"/>
                            <TextBlock Text="包含截图原图、元数据和 SHA-256 清单"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button x:Name="ExportBundleButton"
                                    Content="导出 ZIP"
                                    Click="OnExportBundleClick"/>
                            <Button x:Name="ImportBundleButton"
                                    Content="导入 ZIP"
                                    Click="OnImportBundleClick"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
