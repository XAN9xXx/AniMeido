<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.ManagementPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contracts="using:AniMeido.Contracts.Models"
    xmlns:local="using:AniMeido.Plugin.Base.Views"
    xmlns:services="using:AniMeido.Plugin.Base.Services"
    xmlns:vm="using:AniMeido.Plugin.Base.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="OnPageLoaded">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.ColumnSpan="2"
            Margin="0,0,0,12"
            IsClosable="True"
            Severity="Error"/>

        <StackPanel
            Grid.Column="0"
            Margin="0,0,16,0"
            Spacing="8">
            <TextBlock
                Margin="0,0,0,4"
                FontSize="20"
                FontWeight="Bold"
                Text="关注管理"/>

            <Border
                Padding="8,4"
                Background="{ThemeResource CardBackgroundFillColorDefault}"
                CornerRadius="6">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="&#xE71A;"/>
                    <TextBox
                        x:Name="SearchBox"
                        Grid.Column="1"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        KeyDown="OnSearchKeyDown"
                        PlaceholderText="搜索我的番剧…"/>
                </Grid>
            </Border>

            <ListView
                x:Name="StatusNavigation"
                ItemsSource="{x:Bind ViewModel.StatusSections, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedSection, Mode=OneWay}"
                SelectionChanged="OnStatusSelectionChanged"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TrackingStatusSection">
                        <Grid
                            Height="36"
                            Padding="4,0"
                            ColumnDefinitions="22,*"
                            ColumnSpacing="8">
                            <FontIcon
                                FontSize="15"
                                Glyph="{x:Bind Glyph}"/>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="{x:Bind Header, Mode=OneWay}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button
                x:Name="TagNavigationButton"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Click="OnTagNavigationClick">
                <Grid ColumnDefinitions="22,*" ColumnSpacing="8">
                    <FontIcon FontSize="15" Glyph="&#xE8EC;"/>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="Tag 管理"/>
                </Grid>
            </Button>
        </StackPanel>

        <Grid Grid.Column="1">
            <ListView
                x:Name="SearchResultPanel"
                Padding="0,0,8,0"
                IsItemClickEnabled="True"
                ItemClick="OnSearchResultClick"
                ItemsSource="{x:Bind _searchResults}"
                SelectionMode="None"
                Visibility="Collapsed">
                <ListView.Header>
                    <TextBlock
                        x:Name="SearchResultCount"
                        Margin="0,0,0,8"
                        FontSize="16"
                        FontWeight="SemiBold"/>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="services:SearchResult">
                        <Border
                            Margin="0,0,0,8"
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefault}"
                            CornerRadius="8">
                            <Grid ColumnDefinitions="64,*" ColumnSpacing="12">
                                <Image
                                    Width="64"
                                    Height="90"
                                    Source="{x:Bind CoverImage}"
                                    Stretch="UniformToFill"/>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Anime.Title}"
                                        TextTrimming="CharacterEllipsis"/>
                                    <Border
                                        Padding="6,2"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource SystemAccentColor}"
                                        CornerRadius="4">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource AniMeidoBadgeTextBrush}"
                                            Text="{x:Bind StatusLabel}"/>
                                    </Border>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        MaxLines="2"
                                        Text="{x:Bind Anime.Description}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="WrapWholeWords"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ScrollViewer
                x:Name="StatusPanel"
                Padding="0,0,8,0">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.SelectedSection.Header, Mode=OneWay}"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedSection.Items, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="contracts:Anime">
                                <Border
                                    Margin="0,0,0,10"
                                    Background="{ThemeResource CardBackgroundFillColorDefault}"
                                    CornerRadius="10"
                                    PointerEntered="OnAnimeCardEntered"
                                    PointerExited="OnAnimeCardExited">
                                    <Grid
                                        Height="80"
                                        ColumnDefinitions="64,*,40"
                                        Tapped="OnAnimeTapped">
                                        <Border
                                            Background="{ThemeResource SolidBackgroundFillColorTertiary}"
                                            CornerRadius="10,0,0,10">
                                            <Image
                                                Source="{x:Bind local:ManagementPage.GetCoverSource(ID, CoverURL)}"
                                                Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="14,0,0,0"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                MaxLines="2"
                                                Text="{x:Bind Title}"
                                                TextTrimming="CharacterEllipsis"/>
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind AirDate}"/>
                                        </StackPanel>
                                        <Button
                                            Grid.Column="2"
                                            Width="32"
                                            Height="32"
                                            Margin="0,0,4,0"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Background="Transparent"
                                            Command="{Binding ElementName=RootPage, Path=ViewModel.RemoveFromStatusCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTipService.ToolTip="取消标记">
                                            <FontIcon
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE711;"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Margin="0,12,0,0"
                        Foreground="{ThemeResource AniMeidoMutedTextBrush}"
                        Text="{x:Bind ViewModel.SelectedSection.EmptyMessage, Mode=OneWay}"
                        Visibility="{x:Bind local:ManagementPage.EmptyVisibility(ViewModel.SelectedSection.HasItems), Mode=OneWay}"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer
                x:Name="TagPanel"
                Padding="0,0,8,0"
                Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="Tag 管理"/>
                    <ProgressRing
                        Width="20"
                        Height="20"
                        IsActive="{x:Bind ViewModel.IsTagLoading, Mode=OneWay}"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.TagList, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid
                                    MaximumRowsOrColumns="4"
                                    Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TagItem">
                                <Border
                                    Margin="0,0,6,6"
                                    Padding="14,6"
                                    Background="{ThemeResource CardBackgroundFillColorDefault}"
                                    CornerRadius="14"
                                    Tapped="OnTagItemTapped">
                                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Text="{x:Bind TagName}"/>
                                        <Button
                                            Grid.Column="1"
                                            Width="20"
                                            Height="20"
                                            Padding="0"
                                            Background="Transparent"
                                            Command="{Binding ElementName=RootPage, Path=ViewModel.DeleteTagCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTipService.ToolTip="删除此 Tag">
                                            <FontIcon
                                                FontSize="8"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE711;"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.TagAnimeList, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="contracts:Anime">
                                <Border
                                    Margin="0,0,0,6"
                                    Padding="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefault}"
                                    CornerRadius="8"
                                    Tapped="OnTagAnimeTapped">
                                    <Grid Height="48" ColumnDefinitions="40,*,Auto" ColumnSpacing="8">
                                        <Image
                                            Width="40"
                                            Height="48"
                                            Source="{x:Bind local:ManagementPage.GetCoverSource(ID, CoverURL)}"
                                            Stretch="UniformToFill"/>
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"/>
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind AirDate}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        x:Name="TagEmptyText"
                        Margin="0,12,0,0"
                        Foreground="{ThemeResource AniMeidoMutedTextBrush}"
                        Text="暂无收藏的 Tag"/>
                </StackPanel>
            </ScrollViewer>

            <Grid
                x:Name="LoadingOverlay"
                Background="Transparent"
                Visibility="Collapsed">
                <ProgressRing
                    x:Name="LoadingRing"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
