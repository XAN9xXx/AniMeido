<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.ManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contracts="using:AniMeido.Contracts.Models"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <SolidColorBrush x:Key="TabIndicatorBrush" Color="{ThemeResource SystemAccentColor}"/>
        <SolidColorBrush x:Key="TabTextSelectedBrush" Color="{ThemeResource SystemAccentColor}"/>
        <SolidColorBrush x:Key="TabTextDefaultBrush" Color="#E9E9E9"/>
    </Page.Resources>

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <InfoBar Grid.ColumnSpan="2" x:Name="ErrorInfoBar"
                 Severity="Error" IsClosable="True"
                 IsOpen="False" Visibility="Collapsed" Margin="0,0,0,12"/>

        <StackPanel Grid.Column="0" Margin="0,0,16,0" Spacing="0">
            <TextBlock Text="关注管理" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
            <Border x:Name="WatchingCard" Padding="12,10,12,10" Height="40"
                    Tapped="OnTabClicked" PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited">
                <Grid ColumnDefinitions="3,*">
                    <Rectangle x:Name="WatchingIndicator" Width="3" Height="20" Fill="{ThemeResource TabIndicatorBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="WatchingLabel" Grid.Column="1" Text="追番中" FontSize="14" Foreground="{ThemeResource TabTextSelectedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Border>
            <Border x:Name="PlanToWatchCard" Padding="12,10,12,10" Height="40"
                    Tapped="OnTabClicked" PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited">
                <Grid ColumnDefinitions="3,*">
                    <Rectangle x:Name="PlanToWatchIndicator" Width="3" Height="20" Fill="Transparent" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PlanToWatchLabel" Grid.Column="1" Text="补番中" FontSize="14" Foreground="{ThemeResource TabTextDefaultBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Border>
            <Border x:Name="NotInterestedCard" Padding="12,10,12,10" Height="40"
                    Tapped="OnTabClicked" PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited">
                <Grid ColumnDefinitions="3,*">
                    <Rectangle x:Name="NotInterestedIndicator" Width="3" Height="20" Fill="Transparent" VerticalAlignment="Center"/>
                    <TextBlock x:Name="NotInterestedLabel" Grid.Column="1" Text="不感兴趣" FontSize="14" Foreground="{ThemeResource TabTextDefaultBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Column="1">
            <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="Transparent">
                <ProgressRing x:Name="LoadingRing" Width="32" Height="32" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>

            <ScrollViewer x:Name="WatchingPanel" Visibility="Visible" Padding="0,0,8,0">
                <StackPanel>
                    <TextBlock x:Name="WatchingCountText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding WatchingList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="contracts:Anime">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefault}" CornerRadius="10" Padding="0" Margin="0,0,0,10"
                                        PointerEntered="OnCardEntered" PointerExited="OnCardExited"
                                        PointerPressed="OnCardPressed" PointerReleased="OnCardReleased">
                                    <Grid Height="80" Tapped="OnItemTapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="10,0,0,10" Background="{ThemeResource SolidBackgroundFillColorTertiary}">
                                            <Image Source="{Binding CoverURL}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" MaxLines="2" LineHeight="20"/>
                                            <TextBlock Text="{Binding AirDate}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Width="32" Height="32" Margin="0,0,4,0" VerticalAlignment="Top" HorizontalAlignment="Center" Background="Transparent" Padding="0" ToolTipService.ToolTip="取消标记" Click="OnRemoveClick" Tag="Watching">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="WatchingEmpty" Text="暂无追番标记" Foreground="Gray" Margin="0,12,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="PlanToWatchPanel" Visibility="Collapsed" Padding="0,0,8,0">
                <StackPanel>
                    <TextBlock x:Name="PlanToWatchCountText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding PlanToWatchList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="contracts:Anime">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefault}" CornerRadius="10" Padding="0" Margin="0,0,0,10"
                                        PointerEntered="OnCardEntered" PointerExited="OnCardExited"
                                        PointerPressed="OnCardPressed" PointerReleased="OnCardReleased">
                                    <Grid Height="80" Tapped="OnItemTapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="10,0,0,10" Background="{ThemeResource SolidBackgroundFillColorTertiary}">
                                            <Image Source="{Binding CoverURL}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" MaxLines="2" LineHeight="20"/>
                                            <TextBlock Text="{Binding AirDate}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Width="32" Height="32" Margin="0,0,4,0" VerticalAlignment="Top" HorizontalAlignment="Center" Background="Transparent" Padding="0" ToolTipService.ToolTip="取消标记" Click="OnRemoveClick" Tag="PlanToWatch">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="PlanToWatchEmpty" Text="暂无补番标记" Foreground="Gray" Margin="0,12,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="NotInterestedPanel" Visibility="Collapsed" Padding="0,0,8,0">
                <StackPanel>
                    <TextBlock x:Name="NotInterestedCountText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding NotInterestedList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="contracts:Anime">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefault}" CornerRadius="10" Padding="0" Margin="0,0,0,10"
                                        PointerEntered="OnCardEntered" PointerExited="OnCardExited"
                                        PointerPressed="OnCardPressed" PointerReleased="OnCardReleased">
                                    <Grid Height="80" Tapped="OnItemTapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="10,0,0,10" Background="{ThemeResource SolidBackgroundFillColorTertiary}">
                                            <Image Source="{Binding CoverURL}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" MaxLines="2" LineHeight="20"/>
                                            <TextBlock Text="{Binding AirDate}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Width="32" Height="32" Margin="0,0,4,0" VerticalAlignment="Top" HorizontalAlignment="Center" Background="Transparent" Padding="0" ToolTipService.ToolTip="取消标记" Click="OnRemoveClick" Tag="NotInterested">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NotInterestedEmpty" Text="暂无不感兴趣标记" Foreground="Gray" Margin="0,12,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>