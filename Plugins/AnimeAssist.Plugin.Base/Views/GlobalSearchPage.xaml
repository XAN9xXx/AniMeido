<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.GlobalSearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AniMeido.Plugin.Base.Views.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid x:Name="RootGrid"
          Loaded="OnPageLoaded"
          PointerMoved="OnRootPointerMoved">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 搜索栏 -->
        <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                CornerRadius="8"
                Margin="24,16,24,0"
                Padding="16,12">
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox"
                             PlaceholderText="搜索番剧..."
                             FontSize="16"
                             VerticalAlignment="Center"
                             KeyDown="OnSearchKeyDown"/>
                    <Button Grid.Column="1"
                            Content="搜索"
                            Click="OnSearchClick"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="ResultCount"
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- 结果列表 -->
        <ScrollViewer Grid.Row="1"
                      Margin="24,12,24,0">
            <GridView x:Name="ResultGrid"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="OnResultItemClick"
                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      Padding="0,0,0,8">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal"
                                       HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="UseSystemFocusVisuals"
                                Value="False"/>
                        <Setter Property="IsTabStop"
                                Value="False"/>
                        <Setter Property="Margin"
                                Value="0,0,4,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridViewItem">
                                    <ContentPresenter
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Margin="0"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <controls:AnimeCard/>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </ScrollViewer>

        <!-- 翻页栏 -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefault}"
                CornerRadius="8"
                Margin="24,8,24,16"
                Padding="12,8"
                Visibility="Collapsed"
                x:Name="PaginationBar">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="12">
                <Button x:Name="PrevButton"
                        Content="← 上一页"
                        Click="OnPrevPage"/>
                <TextBlock x:Name="PageInfo"
                           VerticalAlignment="Center"
                           FontSize="14"/>
                <Button x:Name="NextButton"
                        Content="下一页 →"
                        Click="OnNextPage"/>
            </StackPanel>
        </Border>

        <!-- 加载覆盖层 -->
        <Grid Grid.RowSpan="3"
              x:Name="LoadingOverlay"
              Visibility="Collapsed"
              Background="{ThemeResource AniMeidoOverlayScrimBrush}">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="8">
                <ProgressRing x:Name="LoadingRing"
                              Width="32"
                              Height="32"
                              HorizontalAlignment="Center"
                              IsActive="True"/>
                <TextBlock x:Name="LoadingText"
                           Text="正在搜索..."
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 拖放覆盖层 -->
        <Canvas Grid.RowSpan="3"
                x:Name="DragOverlay"
                Visibility="Collapsed"
                Background="Transparent"
                AllowDrop="True"
                PointerMoved="OnRootPointerMoved"/>
    </Grid>
</Page>

