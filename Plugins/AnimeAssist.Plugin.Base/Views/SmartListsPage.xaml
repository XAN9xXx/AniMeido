<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.SmartListsPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AniMeido.Plugin.Base.Models"
    xmlns:vm="using:AniMeido.Plugin.Base.ViewModels">

    <Grid ColumnDefinitions="280,*" ColumnSpacing="16">
        <StackPanel Spacing="10">
            <TextBlock Text="智能列表"
                       Style="{StaticResource TitleTextBlockStyle}"/>
            <ListView ItemsSource="{x:Bind ViewModel.Definitions}"
                      SelectedItem="{x:Bind ViewModel.SelectedDefinition, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SmartListDefinition">
                        <TextBlock Text="{x:Bind Name}"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button Content="新建"
                    Click="OnNewClick"/>
            <Button Content="删除所选"
                    Command="{x:Bind ViewModel.DeleteCommand}"/>
        </StackPanel>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="12" Padding="0,0,0,24">
                <InfoBar x:Name="ErrorInfoBar"
                         Severity="Error"
                         IsClosable="True"/>
                <TextBox Header="名称"
                         Text="{x:Bind ViewModel.Name, Mode=TwoWay}"/>
                <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="8">
                    <ComboBox Header="根条件组"
                              ItemsSource="{x:Bind ViewModel.GroupModes}"
                              SelectedItem="{x:Bind ViewModel.RootMode, Mode=TwoWay}"/>
                    <ComboBox Grid.Column="1"
                              Header="第二层条件组"
                              ItemsSource="{x:Bind ViewModel.GroupModes}"
                              SelectedItem="{x:Bind ViewModel.NestedMode, Mode=TwoWay}"/>
                    <ComboBox Grid.Column="2"
                              Header="排序"
                              ItemsSource="{x:Bind ViewModel.Fields}"
                              SelectedItem="{x:Bind ViewModel.SortField, Mode=TwoWay}"/>
                    <CheckBox Grid.Column="3"
                              Content="降序"
                              IsChecked="{x:Bind ViewModel.SortDescending, Mode=TwoWay}"
                              VerticalAlignment="Bottom"
                              Margin="0,0,0,8"/>
                </Grid>

                <ItemsControl ItemsSource="{x:Bind ViewModel.Conditions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SmartConditionEditor">
                            <Grid ColumnDefinitions="100,*,*,2*,Auto"
                                  ColumnSpacing="8"
                                  Margin="0,0,0,8">
                                <NumberBox Value="{x:Bind GroupDepth, Mode=TwoWay}"
                                           Minimum="0"
                                           Maximum="1"
                                           Header="层级"/>
                                <ComboBox Grid.Column="1"
                                          Header="字段"
                                          ItemsSource="{Binding ViewModel.Fields, ElementName=RootPage}"
                                          SelectedItem="{x:Bind Field, Mode=TwoWay}"/>
                                <ComboBox Grid.Column="2"
                                          Header="运算符"
                                          ItemsSource="{Binding ViewModel.Operators, ElementName=RootPage}"
                                          SelectedItem="{x:Bind Operator, Mode=TwoWay}"/>
                                <TextBox Grid.Column="3"
                                         Header="值"
                                         Text="{x:Bind Value, Mode=TwoWay}"/>
                                <Button Grid.Column="4"
                                        Content="删除"
                                        VerticalAlignment="Bottom"
                                        Command="{Binding ViewModel.RemoveConditionCommand, ElementName=RootPage}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="添加条件"
                            Command="{x:Bind ViewModel.AddConditionCommand}"/>
                    <Button Content="预览"
                            Command="{x:Bind ViewModel.EvaluateCommand}"/>
                    <Button Content="保存"
                            Command="{x:Bind ViewModel.SaveCommand}"
                            Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>

                <TextBlock Text="结果"
                           Style="{StaticResource SubtitleTextBlockStyle}"/>
                <ListView ItemsSource="{x:Bind ViewModel.Results}"
                          IsItemClickEnabled="True"
                          ItemClick="OnResultClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SmartListCandidate">
                            <Grid ColumnDefinitions="*,Auto" Padding="8">
                                <TextBlock Text="{x:Bind Title}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind PlaybackSummary}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
