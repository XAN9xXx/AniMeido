<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.AnimeDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:contracts="using:AniMeido.Contracts.Models"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 错误提示 -->
        <InfoBar x:Name="ErrorInfoBar"
                 Grid.Row="0"
                 Severity="Error"
                 IsClosable="True"
                 IsOpen="False"/>

        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1"
                      x:Name="ContentScrollViewer">
            <Grid Padding="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"
                                      MaxWidth="400"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左列：封面图 -->
                <Border Grid.Column="0"
                        CornerRadius="12"
                        Margin="0,0,32,0"
                        MaxWidth="400"
                        VerticalAlignment="Top"
                        Background="{ThemeResource CardBackgroundFillColorDefault}">
                    <Image x:Name="DetailCoverImage"
                           Source="{Binding AnimeDetail.CoverURL}"
                           Stretch="Uniform"
                           ImageFailed="OnDetailCoverImageFailed"/>
                </Border>

                <!-- 右列：信息 -->
                <StackPanel Grid.Column="1"
                            Spacing="12">

                    <!-- 标题 -->
                    <TextBlock Text="{Binding AnimeDetail.Title}"
                               FontSize="26"
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>

                    <!-- 制作/原作 -->
                    <TextBlock x:Name="DetailStudio"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="Collapsed"/>

                    <!-- 分割线 -->
                    <Border Height="1"
                            Background="{ThemeResource DividerStrokeColorDefault}"/>

                    <!-- 放送日期 -->
                    <TextBlock Text="{Binding AnimeDetail.AirDate}"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <!-- 评分 -->
                    <TextBlock x:Name="DetailScore"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="Collapsed"/>

                    <!-- 分割线 -->
                    <Border Height="1"
                            Background="{ThemeResource DividerStrokeColorDefault}"/>

                    <!-- 简介 -->
                    <TextBlock Text="{Binding AnimeDetail.Description}"
                               FontSize="15"
                               TextWrapping="Wrap"
                               LineHeight="24">
                    </TextBlock>

                    <!-- 角色区 -->
                    <StackPanel x:Name="CharacterSection"
                                Visibility="Collapsed"
                                Spacing="8">
                        <TextBlock Text="角色"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                        <ScrollViewer HorizontalScrollMode="Auto"
                                      VerticalScrollMode="Disabled"
                                      HorizontalScrollBarVisibility="Hidden">
                            <StackPanel x:Name="CharacterPanel"
                                        Orientation="Horizontal"
                                        Spacing="8"/>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- 分割线 -->
                    <Border Height="1"
                            Background="{ThemeResource DividerStrokeColorDefault}"/>

                    <!-- 关注状态按钮 -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <Button x:Name="WatchingBtn"
                                Command="{Binding SetWatchingCommand}"
                                IsEnabled="{Binding HasData}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefault}"
                                BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefault}"
                                CornerRadius="6"
                                Padding="14,8"
                                Visibility="Collapsed"
                                PointerEntered="OnTrackingBtnEntered"
                                PointerExited="OnTrackingBtnExited">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">
                                <FontIcon x:Name="WatchingIcon"
                                          Glyph="&#xE8FB;"
                                          FontSize="14"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="WatchingText"
                                           Text="追番"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="PlanToWatchBtn"
                                Command="{Binding SetPlanToWatchCommand}"
                                IsEnabled="{Binding HasData}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefault}"
                                BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefault}"
                                CornerRadius="6"
                                Padding="14,8"
                                Visibility="Collapsed"
                                PointerEntered="OnTrackingBtnEntered"
                                PointerExited="OnTrackingBtnExited">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">
                                <FontIcon x:Name="PlanToWatchIcon"
                                          Glyph="&#xE1D4;"
                                          FontSize="14"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="PlanToWatchText"
                                           Text="补番"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NotInterestedBtn"
                                Command="{Binding SetNotInterestedCommand}"
                                IsEnabled="{Binding HasData}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefault}"
                                BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefault}"
                                CornerRadius="6"
                                Padding="14,8"
                                PointerEntered="OnTrackingBtnEntered"
                                PointerExited="OnTrackingBtnExited">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">
                                <FontIcon x:Name="NotInterestedIcon"
                                          Glyph="&#xE711;"
                                          FontSize="14"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="NotInterestedText"
                                           Text="不感兴趣"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="FollowingBtn"
                                Command="{Binding SetFollowingCommand}"
                                IsEnabled="{Binding HasData}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefault}"
                                BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefault}"
                                CornerRadius="6"
                                Padding="14,8"
                                PointerEntered="OnTrackingBtnEntered"
                                PointerExited="OnTrackingBtnExited">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">
                                <FontIcon x:Name="FollowingIcon"
                                          Glyph="&#xE1CE;"
                                          FontSize="14"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="FollowingText"
                                           Text="关注"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CompletedBtn"
                                Command="{Binding SetCompletedCommand}"
                                IsEnabled="{Binding HasData}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefault}"
                                BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefault}"
                                CornerRadius="6"
                                Padding="14,8"
                                PointerEntered="OnTrackingBtnEntered"
                                PointerExited="OnTrackingBtnExited">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">
                                <FontIcon x:Name="CompletedIcon"
                                          Glyph="&#xE930;"
                                          FontSize="14"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="CompletedText"
                                           Text="已看完"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="DroppedBtn"
                                Command="{Binding SetDroppedCommand}"
                                IsEnabled="{Binding HasData}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefault}"
                                BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefault}"
                                CornerRadius="6"
                                Padding="14,8"
                                PointerEntered="OnTrackingBtnEntered"
                                PointerExited="OnTrackingBtnExited">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">
                                <FontIcon x:Name="DroppedIcon"
                                          Glyph="&#xE74C;"
                                          FontSize="14"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DroppedText"
                                           Text="弃番"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BlockedBtn"
                                Command="{Binding SetBlockedCommand}"
                                IsEnabled="{Binding HasData}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefault}"
                                BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefault}"
                                CornerRadius="6"
                                Padding="14,8"
                                PointerEntered="OnTrackingBtnEntered"
                                PointerExited="OnTrackingBtnExited">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">
                                <FontIcon x:Name="BlockedIcon"
                                          Glyph="&#xE76C;"
                                          FontSize="14"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="BlockedText"
                                           Text="屏蔽"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 当前状态提示 -->
                    <TextBlock x:Name="StatusHint"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="Collapsed"/>

                    <!-- 分割线 -->
                    <Border Height="1"
                            Background="{ThemeResource DividerStrokeColorDefault}"/>

                    <!-- 标签区域 -->
                    <TextBlock Text="Bangumi 标签"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel x:Name="TagContainer"
                                Orientation="Horizontal"
                                Visibility="Collapsed">
                    </StackPanel>

                    <!-- 分割线 -->
                    <Border Height="1"
                            Background="{ThemeResource DividerStrokeColorDefault}"/>

                    <!-- Bangumi 百科入口 -->
                    <Border x:Name="BangumiCard"
                            Background="{ThemeResource CardBackgroundFillColorDefault}"
                            CornerRadius="8"
                            BorderBrush="{ThemeResource ControlStrokeColorDefault}"
                            BorderThickness="1"
                            Padding="14,10"
                            IsTapEnabled="True"
                            Tapped="OnBangumiCardTapped"
                            PointerEntered="OnBangumiPointerEntered"
                            PointerExited="OnBangumiPointerExited"
                            PointerPressed="OnBangumiPointerPressed"
                            PointerReleased="OnBangumiPointerReleased"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <FontIcon Glyph="&#xE774;"
                                      FontSize="14"
                                      Foreground="{ThemeResource SystemAccentColor}"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="查看 Bangumi 百科条目"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                            <FontIcon Glyph="&#xE2B1;"
                                      FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- 加载/重试覆盖层 -->
        <Grid Grid.Row="1"
              x:Name="LoadingOverlay"
              Visibility="Collapsed"
              Background="Transparent"
              Tapped="OnLoadingOverlayTapped">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <ProgressRing x:Name="LoadingRing"
                              Height="40"
                              Width="40"
                              HorizontalAlignment="Center"/>
                <Image x:Name="LoadingFailedImage"
                       Source="ms-appx:///Assets/Loading_failed.png"
                       Width="80"
                       Height="80"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed"/>
                <TextBlock x:Name="LoadingHint"
                           FontSize="14"
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="300"
                           TextAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>