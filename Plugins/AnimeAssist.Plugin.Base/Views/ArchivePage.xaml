<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.ArchivePage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,*" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
                <TextBlock Text="个人动画档案馆"
                           Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="笔记、感想、观看记录与本地截图"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="刷新"
                    Click="OnRefreshClick"/>
        </Grid>

        <InfoBar x:Name="StatusInfoBar"
                 Grid.Row="1"
                 VerticalAlignment="Top"
                 IsClosable="True"/>

        <NavigationView x:Name="SectionNavigation"
                        Grid.Row="1"
                        Margin="0,42,0,0"
                        PaneDisplayMode="Top"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="OnSectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="档案" Tag="archives">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="统计" Tag="statistics">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="年度回顾" Tag="review">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="截图" Tag="screenshots">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE722;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid x:Name="ArchivesPanel"
                      ColumnDefinitions="320,*"
                      ColumnSpacing="16">
                    <StackPanel Spacing="8">
                        <TextBox x:Name="ArchiveFilter"
                                 PlaceholderText="筛选标题或标签"
                                 TextChanged="OnArchiveFilterChanged"/>
                        <ComboBox x:Name="StatusFilter"
                                  Header="追番状态"
                                  SelectionChanged="OnArchiveOptionChanged">
                            <x:String>全部状态</x:String>
                            <x:String>追番中</x:String>
                            <x:String>补番中</x:String>
                            <x:String>不感兴趣</x:String>
                            <x:String>关注</x:String>
                            <x:String>已看完</x:String>
                            <x:String>弃坑</x:String>
                        </ComboBox>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <NumberBox x:Name="MinimumRatingFilter"
                                       Header="最低评分"
                                       Minimum="0.5"
                                       Maximum="10"
                                       SmallChange="0.5"
                                       ValueChanged="OnArchiveNumberFilterChanged"/>
                            <NumberBox x:Name="ArchiveYearFilter"
                                       Grid.Column="1"
                                       Header="建档年份"
                                       Minimum="2000"
                                       Maximum="2100"
                                       ValueChanged="OnArchiveNumberFilterChanged"/>
                        </Grid>
                        <ListView x:Name="ArchiveList"
                                  SelectionChanged="OnArchiveSelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4" Spacing="3">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Metadata}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding TagSummary}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                    <ScrollViewer Grid.Column="1">
                        <StackPanel Spacing="10" Padding="4">
                            <TextBlock x:Name="ArchiveTitle"
                                       Text="选择一部番剧"
                                       Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <NumberBox x:Name="RatingBox"
                                       Header="个人评分（0.5–10）"
                                       Minimum="0.5"
                                       Maximum="10"
                                       SmallChange="0.5"
                                       SpinButtonPlacementMode="Compact"/>
                            <TextBox x:Name="TagsBox"
                                     Header="个人标签"
                                     PlaceholderText="使用逗号分隔"/>
                            <TextBox x:Name="SummaryBox"
                                     Header="概要笔记"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="120"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="保存档案"
                                        Click="OnSaveArchiveClick"/>
                                <Button Content="追加感想"
                                        Click="OnAddEntryClick"/>
                                <Button Content="编辑感想"
                                        Click="OnEditEntryClick"/>
                                <Button Content="删除感想"
                                        Click="OnDeleteEntryClick"/>
                                <Button Content="补录观看事件"
                                        Click="OnAddManualEventClick"/>
                            </StackPanel>
                            <TextBlock Text="感想时间线"
                                       Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <ListView x:Name="EntryList"
                                      SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                                                CornerRadius="8"
                                                Padding="10"
                                                Margin="0,0,0,6">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding DisplayTime}"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="{Binding EpisodeText}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Body}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock Text="观看历史"
                                       Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <ListView x:Name="WatchHistoryList"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="140,100,100,*"
                                              ColumnSpacing="8"
                                              Padding="4">
                                            <TextBlock Text="{Binding TimeText}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding EpisodeText}"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding SourceText}"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Note}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <StackPanel x:Name="StatisticsPanel"
                            Visibility="Collapsed"
                            Spacing="12">
                    <TextBlock Text="个人统计"
                               Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock x:Name="StatisticsText"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="观看时长为播放器完成事件与手工补录的估算值。"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <StackPanel x:Name="ReviewPanel"
                            Visibility="Collapsed"
                            Spacing="12">
                    <TextBlock Text="年度回顾"
                               Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <NumberBox x:Name="ReviewYear"
                               Header="年份"
                               Minimum="2000"
                               Maximum="2100"
                               ValueChanged="OnReviewYearChanged"/>
                    <TextBlock x:Name="ReviewText"
                               TextWrapping="Wrap"/>
                    <Button Content="导出自包含 HTML"
                            HorizontalAlignment="Left"
                            Click="OnExportReviewClick"/>
                </StackPanel>

                <StackPanel x:Name="ScreenshotsPanel"
                            Visibility="Collapsed"
                            Spacing="10">
                    <Grid ColumnDefinitions="*,180" ColumnSpacing="8">
                        <TextBox x:Name="ScreenshotFilter"
                                 PlaceholderText="筛选番剧、场合、进程或标签"
                                 TextChanged="OnScreenshotFilterChanged"/>
                        <NumberBox x:Name="ScreenshotYearFilter"
                                   Grid.Column="1"
                                   PlaceholderText="年份"
                                   Minimum="2000"
                                   Maximum="2100"
                                   ValueChanged="OnScreenshotYearFilterChanged"/>
                    </Grid>
                    <Grid ColumnDefinitions="*"
                          RowDefinitions="Auto,Auto"
                          RowSpacing="8">
                        <TextBlock Text="截图管理"
                                   Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    Spacing="8">
                        <Button
                                Content="打开"
                                Click="OnOpenScreenshotClick"/>
                        <Button
                                Content="编辑"
                                Click="OnEditScreenshotClick"/>
                        <Button
                                Content="批量加标签"
                                Click="OnTagScreenshotsClick"/>
                        <Button
                                Content="导出原图"
                                Click="OnExportScreenshotsClick"/>
                        <Button
                                Content="移入回收站"
                                Click="OnDeleteScreenshotClick"/>
                        <Button
                                Content="清理缺失记录"
                                Click="OnCleanupScreenshotsClick"/>
                        <Button
                                Content="截图设置"
                                Click="OnScreenshotSettingsClick"/>
                        </StackPanel>
                    </Grid>
                    <GridView x:Name="ScreenshotList"
                              SelectionMode="Multiple">
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="240" Spacing="5">
                                    <Image Source="{Binding FilePath}"
                                           Width="240"
                                           Height="135"
                                           Stretch="UniformToFill"/>
                                    <TextBlock Text="{Binding AnimeTitle}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ContextNote}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </Grid>
        </NavigationView>
    </Grid>
</Page>
