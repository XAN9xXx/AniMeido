<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.ArchivePage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <MenuFlyout x:Key="ScreenshotMoreActionsFlyout">
            <MenuFlyoutItem Text="移入回收站"
                            Click="OnDeleteScreenshotClick"/>
            <MenuFlyoutItem Text="清理缺失记录"
                            Click="OnCleanupScreenshotsClick"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="截图设置"
                            Click="OnScreenshotSettingsClick"/>
        </MenuFlyout>
    </Page.Resources>

    <Grid Padding="24,20,24,24"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto"
              VerticalAlignment="Center">
            <StackPanel Spacing="2">
                <TextBlock Text="个人动画档案馆"
                           Style="{StaticResource AniMeidoPageTitleStyle}"/>
                <TextBlock Text="整理评分、笔记、观看记忆与截图"
                           Style="{StaticResource AniMeidoPageSubtitleStyle}"/>
            </StackPanel>
            <Button Grid.Column="1"
                    ToolTipService.ToolTip="刷新档案数据"
                    Click="OnRefreshClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                    <TextBlock Text="刷新"/>
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar x:Name="StatusInfoBar"
                 Grid.Row="1"
                 IsClosable="True"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="4">
            <ToggleButton x:Name="ArchivesSectionButton"
                          Tag="archives"
                          Style="{StaticResource AniMeidoSectionTabStyle}"
                          Click="OnSectionButtonClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8F1;" FontSize="15"/>
                    <TextBlock Text="番剧档案"/>
                </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="StatisticsSectionButton"
                          Tag="statistics"
                          Style="{StaticResource AniMeidoSectionTabStyle}"
                          Click="OnSectionButtonClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE9D2;" FontSize="15"/>
                    <TextBlock Text="统计"/>
                </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="ReviewSectionButton"
                          Tag="review"
                          Style="{StaticResource AniMeidoSectionTabStyle}"
                          Click="OnSectionButtonClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE787;" FontSize="15"/>
                    <TextBlock Text="年度回顾"/>
                </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="ScreenshotsSectionButton"
                          Tag="screenshots"
                          Style="{StaticResource AniMeidoSectionTabStyle}"
                          Click="OnSectionButtonClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE722;" FontSize="15"/>
                    <TextBlock Text="截图"/>
                </StackPanel>
            </ToggleButton>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid x:Name="ArchivesPanel"
                  ColumnDefinitions="360,*"
                  ColumnSpacing="16">
                <Border Style="{StaticResource AniMeidoCardStyle}">
                    <Grid RowDefinitions="Auto,Auto,*"
                          RowSpacing="12">
                        <StackPanel Spacing="8">
                            <TextBox x:Name="ArchiveFilter"
                                     PlaceholderText="搜索标题或个人标签"
                                     TextChanged="OnArchiveFilterChanged">
                                <TextBox.Header>
                                    <TextBlock Text="查找档案"
                                               FontWeight="SemiBold"/>
                                </TextBox.Header>
                            </TextBox>
                            <Expander Header="更多筛选">
                                <StackPanel Spacing="10" Padding="0,8,0,4">
                                    <ComboBox x:Name="StatusFilter"
                                              Header="追番状态"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="OnArchiveOptionChanged">
                                        <x:String>全部状态</x:String>
                                        <x:String>追番中</x:String>
                                        <x:String>补番中</x:String>
                                        <x:String>不感兴趣</x:String>
                                        <x:String>关注</x:String>
                                        <x:String>已看完</x:String>
                                        <x:String>弃坑</x:String>
                                    </ComboBox>
                                    <Grid ColumnDefinitions="*,*"
                                          ColumnSpacing="8">
                                        <NumberBox x:Name="MinimumRatingFilter"
                                                   Header="最低评分"
                                                   Minimum="0.5"
                                                   Maximum="10"
                                                   SmallChange="0.5"
                                                   ValueChanged="OnArchiveNumberFilterChanged"/>
                                        <NumberBox x:Name="ArchiveYearFilter"
                                                   Grid.Column="1"
                                                   Header="建档年份"
                                                   Minimum="2000"
                                                   Maximum="2100"
                                                   ValueChanged="OnArchiveNumberFilterChanged"/>
                                    </Grid>
                                    <Button Content="清除筛选"
                                            HorizontalAlignment="Left"
                                            Click="OnClearArchiveFiltersClick"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                            <TextBlock Text="档案列表"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="ArchiveResultCount"
                                       Grid.Column="1"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>

                        <Grid Grid.Row="2">
                            <ListView x:Name="ArchiveList"
                                      SelectionMode="Single"
                                      SelectionChanged="OnArchiveSelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="4,6" Spacing="4">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Metadata}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding TagSummary}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel x:Name="ArchiveListEmptyState"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8">
                                <FontIcon Glyph="&#xE11A;"
                                          Style="{StaticResource AniMeidoEmptyStateIconStyle}"/>
                                <TextBlock Text="没有符合条件的档案"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="尝试清除筛选，或先在番剧详情中建立档案"
                                           MaxWidth="260"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Border x:Name="ArchiveSelectionEmptyState"
                            Style="{StaticResource AniMeidoCardStyle}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="10">
                            <FontIcon Glyph="&#xE8F1;"
                                      Style="{StaticResource AniMeidoEmptyStateIconStyle}"/>
                            <TextBlock Text="选择一部番剧开始整理"
                                       Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                            <TextBlock Text="左侧只负责查找和选择；评分、笔记、感想与观看记录会在这里集中显示。"
                                       MaxWidth="440"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer x:Name="ArchiveDetailPanel"
                                  Visibility="Collapsed">
                        <StackPanel Spacing="16" Padding="0,0,4,4">
                            <Border Style="{StaticResource AniMeidoCardStyle}">
                                <StackPanel Spacing="14">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Name="ArchiveTitle"
                                                       Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                                            <TextBlock Text="个人档案"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="保存更改"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Click="OnSaveArchiveClick"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="220,*"
                                          ColumnSpacing="12">
                                        <NumberBox x:Name="RatingBox"
                                                   Header="个人评分"
                                                   Minimum="0.5"
                                                   Maximum="10"
                                                   SmallChange="0.5"
                                                   SpinButtonPlacementMode="Compact"/>
                                        <TextBox x:Name="TagsBox"
                                                 Grid.Column="1"
                                                 Header="个人标签"
                                                 PlaceholderText="例如：治愈、作画、年度候选（用逗号分隔）"/>
                                    </Grid>
                                    <TextBox x:Name="SummaryBox"
                                             Header="概要笔记"
                                             PlaceholderText="记录整体印象、推荐理由或以后想重看的原因"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="120"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource AniMeidoCardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Text="感想时间线"
                                                       Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                                            <TextBlock Text="按观看时刻记录多条感想"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Click="OnAddEntryClick">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE710;" FontSize="13"/>
                                                <TextBlock Text="新增感想"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <ListView x:Name="EntryList"
                                              MinHeight="100"
                                              MaxHeight="300"
                                              SelectionMode="Single"
                                              SelectionChanged="OnEntrySelectionChanged">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="4,6"
                                                      ColumnDefinitions="6,*"
                                                      ColumnSpacing="10">
                                                    <Border CornerRadius="3"
                                                            Background="{ThemeResource AniMeidoAccentBrush}"/>
                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                        <TextBlock Text="{Binding DisplayTime}"
                                                                   FontSize="12"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding EpisodeText}"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Body}"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Spacing="8">
                                        <Button x:Name="EditEntryButton"
                                                Content="编辑所选"
                                                IsEnabled="False"
                                                Click="OnEditEntryClick"/>
                                        <Button x:Name="DeleteEntryButton"
                                                Content="删除所选"
                                                IsEnabled="False"
                                                Click="OnDeleteEntryClick"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource AniMeidoCardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Text="观看历史"
                                                       Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                                            <TextBlock Text="播放器事实与手工补录分开记录"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="补录观看"
                                                Click="OnAddManualEventClick"/>
                                    </Grid>
                                    <ListView x:Name="WatchHistoryList"
                                              MinHeight="100"
                                              MaxHeight="280"
                                              SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="140,100,100,*"
                                                      ColumnSpacing="8"
                                                      Padding="4,7">
                                                    <TextBlock Text="{Binding TimeText}"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding EpisodeText}"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding SourceText}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding Note}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <ScrollViewer x:Name="StatisticsPanel" Visibility="Collapsed">
                <StackPanel MaxWidth="920"
                            HorizontalAlignment="Left"
                            Spacing="16">
                    <StackPanel>
                        <TextBlock Text="个人统计"
                                   Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                        <TextBlock Text="只汇总 AniMeido 实际记录的数据"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Border Style="{StaticResource AniMeidoCardStyle}">
                        <TextBlock x:Name="StatisticsText"
                                   FontSize="16"
                                   LineHeight="28"
                                   TextWrapping="Wrap"/>
                    </Border>
                    <InfoBar IsOpen="True"
                             IsClosable="False"
                             Severity="Informational"
                             Message="观看时长来自播放器完成事件与手工补录，是估算值。"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ReviewPanel" Visibility="Collapsed">
                <StackPanel MaxWidth="920"
                            HorizontalAlignment="Left"
                            Spacing="16">
                    <Grid ColumnDefinitions="*,200">
                        <StackPanel>
                            <TextBlock Text="年度回顾"
                                       Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                            <TextBlock Text="回看这一年留下的观看记录与个人内容"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <NumberBox x:Name="ReviewYear"
                                   Grid.Column="1"
                                   Header="年份"
                                   Minimum="2000"
                                   Maximum="2100"
                                   ValueChanged="OnReviewYearChanged"/>
                    </Grid>
                    <Border Style="{StaticResource AniMeidoCardStyle}">
                        <TextBlock x:Name="ReviewText"
                                   FontSize="16"
                                   LineHeight="28"
                                   TextWrapping="Wrap"/>
                    </Border>
                    <Button Content="导出为自包含 HTML"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Left"
                            Click="OnExportReviewClick"/>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="ScreenshotsPanel"
                  Visibility="Collapsed"
                  RowDefinitions="Auto,*"
                  RowSpacing="12">
                <Border Style="{StaticResource AniMeidoCardStyle}">
                    <Grid ColumnDefinitions="*,150,Auto" ColumnSpacing="8">
                        <TextBox x:Name="ScreenshotFilter"
                                 PlaceholderText="搜索番剧、场合、进程或标签"
                                 TextChanged="OnScreenshotFilterChanged"/>
                        <NumberBox x:Name="ScreenshotYearFilter"
                                   Grid.Column="1"
                                   PlaceholderText="年份"
                                   Minimum="2000"
                                   Maximum="2100"
                                   ValueChanged="OnScreenshotYearFilterChanged"/>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8">
                            <Button Content="打开"
                                    Click="OnOpenScreenshotClick"/>
                            <Button Content="编辑"
                                    Click="OnEditScreenshotClick"/>
                            <Button Content="加标签"
                                    Click="OnTagScreenshotsClick"/>
                            <Button Content="导出"
                                    Click="OnExportScreenshotsClick"/>
                            <Button Content="更多"
                                    FlyoutBase.AttachedFlyout="{StaticResource ScreenshotMoreActionsFlyout}"
                                    Click="OnShowScreenshotMoreActionsClick"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <GridView x:Name="ScreenshotList"
                          Grid.Row="1"
                          SelectionMode="Multiple">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border Width="260"
                                    Style="{StaticResource AniMeidoCardStyle}"
                                    Padding="0">
                                <StackPanel>
                                    <Image Source="{Binding FilePath}"
                                           Width="260"
                                           Height="146"
                                           Stretch="UniformToFill"/>
                                    <StackPanel Padding="12" Spacing="5">
                                        <TextBlock Text="{Binding AnimeTitle}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ContextNote}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
        </Grid>
    </Grid>
</Page>
