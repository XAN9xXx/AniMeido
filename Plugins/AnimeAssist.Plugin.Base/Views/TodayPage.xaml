<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.TodayPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AniMeido.Plugin.Base.Views.Controls"
    xmlns:contracts="using:AniMeido.Contracts.Models"
    xmlns:vm="using:AniMeido.Plugin.Base.ViewModels">

    <Grid>
        <ScrollViewer>
            <StackPanel Spacing="18" Padding="0,0,0,24">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Text="今天"
                                   Style="{StaticResource TitleTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.TodayLabel}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="刷新"
                            Click="OnRefreshClick"
                            VerticalAlignment="Center"/>
                </Grid>

                <InfoBar x:Name="ErrorInfoBar"
                         Severity="Error"
                         IsClosable="True"/>
                <InfoBar x:Name="NotificationInfoBar"
                         Severity="Warning"
                         IsClosable="True"
                         ActionButton="{x:Bind NotificationSettingsButton}"/>

                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              HorizontalAlignment="Left"/>

                <StackPanel Spacing="8"
                            Visibility="{x:Bind ViewModel.IsPlaybackAvailable, Mode=OneWay}">
                    <TextBlock Text="继续观看"
                               Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <ListView x:Name="ContinueList"
                              ItemsSource="{x:Bind ViewModel.ContinueWatching}"
                              IsItemClickEnabled="True"
                              ItemClick="OnAnimeEntryClick"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TodayAnimeEntry">
                                <Grid ColumnDefinitions="*,Auto" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Anime.Title}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind Subtitle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <FontIcon Grid.Column="1"
                                              Glyph="&#xE768;"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="我的今日放送"
                               Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <GridView ItemsSource="{x:Bind ViewModel.PersonalBroadcasts}"
                              SelectionMode="None">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="contracts:Anime">
                                <controls:AnimeCard CardClicked="OnAnimeCardClicked"/>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="8">
                        <TextBlock Text="补番计划"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="编辑"
                                Click="OnEditPlanClick"/>
                        <Button Grid.Column="2"
                                Content="添加提醒"
                                Click="OnAddReminderClick"/>
                        <Button Grid.Column="3"
                                Content="管理提醒"
                                Click="OnManageRemindersClick"/>
                        <Button Grid.Column="4"
                                Content="开始补番"
                                Click="OnStartPlanClick"/>
                        <Button Grid.Column="5"
                                Content="智能列表"
                                Click="OnSmartListsClick"/>
                    </Grid>
                    <ListView x:Name="PlanList"
                              ItemsSource="{x:Bind ViewModel.Plans}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TodayPlanEntry">
                                <Grid ColumnDefinitions="*,Auto" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Title}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind Subtitle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind PriorityText}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <Expander Header="查看本季全部今日放送">
                    <GridView ItemsSource="{x:Bind ViewModel.AllBroadcasts}"
                              SelectionMode="None">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="contracts:Anime">
                                <controls:AnimeCard CardClicked="OnAnimeCardClicked"/>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Expander>

                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="最近浏览"/>
                        <Button
                            Grid.Column="1"
                            Click="OnClearBrowseHistoryClick"
                            Content="清空"/>
                    </Grid>
                    <ListView
                        ItemsSource="{x:Bind ViewModel.RecentBrowsed}"
                        IsItemClickEnabled="True"
                        ItemClick="OnBrowseEntryClick"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TodayBrowseEntry">
                                <Grid Padding="8" ColumnDefinitions="*,Auto">
                                    <StackPanel>
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Anime.Title}"/>
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Subtitle}"/>
                                    </StackPanel>
                                    <FontIcon
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Glyph="&#xE9D2;"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <StackPanel Spacing="8"
                            Visibility="{x:Bind ViewModel.IsPlaybackAvailable, Mode=OneWay}">
                    <TextBlock Text="最近观看"
                               Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.RecentActivity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TodayAnimeEntry">
                                <TextBlock>
                                    <Run Text="{x:Bind Anime.Title}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{x:Bind Subtitle}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
