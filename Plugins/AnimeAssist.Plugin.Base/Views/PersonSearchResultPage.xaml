<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.PersonSearchResultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contracts="using:AniMeido.Contracts.Models"
    xmlns:controls="using:AniMeido.Plugin.Base.Views.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid AllowDrop="True"
          Padding="24,20,24,24"
          Loaded="OnPageLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Style="{StaticResource AniMeidoToolbarStyle}">
            <StackPanel Spacing="4">
                <TextBlock x:Name="TitleBlock"
                           Style="{StaticResource AniMeidoSectionTitleStyle}"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="ResultCount"
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- 结果列表 -->
        <ScrollViewer Grid.Row="1"
                      Margin="0,12,0,0">
            <GridView x:Name="ResultGrid"
                      SelectionMode="None"
                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      Padding="0,0,0,8">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal"
                                       HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="UseSystemFocusVisuals"
                                Value="False"/>
                        <Setter Property="IsTabStop"
                                Value="False"/>
                        <Setter Property="Margin"
                                Value="0,0,4,8"/>
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <controls:AnimeCard CardClicked="OnAnimeCardClicked"/>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </ScrollViewer>

        <!-- 加载覆盖层 -->
        <Grid Grid.RowSpan="2"
              x:Name="LoadingOverlay"
              Visibility="Collapsed"
              Background="Transparent">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="8">
                <ProgressRing x:Name="LoadingRing"
                              Width="32"
                              Height="32"
                              HorizontalAlignment="Center"/>
                <TextBlock x:Name="LoadingText"
                           Text="正在加载..."
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 拖放覆盖层 -->
        <Canvas Grid.RowSpan="2"
                x:Name="DragOverlay"
                Visibility="Collapsed"
                Background="Transparent"
                AllowDrop="True"/>
    </Grid>
</Page>
