<Page
    x:Class="AniMeido.Plugin.Base.Views.BrowseHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="OnPageLoaded"
    xmlns:controls="using:AniMeido.Plugin.Base.Views.Controls"
    xmlns:contracts="using:AniMeido.Contracts.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <StackPanel Grid.Row="0"
                    Spacing="4"
                    Margin="0,0,0,12">
            <TextBlock Text="浏览记录"
                       FontSize="24"
                       FontWeight="Bold"/>
            <TextBlock Text="最近查看过的番剧详情页"
                       FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1">
            <StackPanel>

                <!-- 加载中 -->
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading}"
                              Height="40"
                              Width="40"
                              HorizontalAlignment="Center"
                              Margin="0,40,0,0"/>

                <!-- 空状态 -->
                <StackPanel x:Name="EmptyPanel"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            Margin="0,60,0,0"
                            Spacing="12">
                    <TextBlock Text="暂无浏览记录"
                               FontSize="18"
                               Foreground="{ThemeResource AniMeidoMutedTextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="查看番剧详情后将自动记录"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 操作按钮 -->
                <Button x:Name="ClearButton"
                        Content="清空记录"
                        HorizontalAlignment="Right"
                        Height="32"
                        FontSize="13"
                        Margin="0,0,0,8"
                        Click="OnClearClick"/>

                <!-- 番剧列表 -->
                <GridView ItemsSource="{x:Bind ViewModel.HistoryList, Mode=OneWay}"
                          SelectionMode="None">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="UseSystemFocusVisuals"
                                    Value="False"/>
                            <Setter Property="IsTabStop"
                                    Value="False"/>
                            <Setter Property="Margin"
                                    Value="0,0,4,8"/>
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="contracts:Anime">
                            <controls:AnimeCard CardClicked="OnAnimeCardClicked"/>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

