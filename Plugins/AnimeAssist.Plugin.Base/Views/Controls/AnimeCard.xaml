<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AniMeido.Plugin.Base.Views.Controls.AnimeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AniMeido.Plugin.Base.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    CanDrag="True"
    DragStarting="OnBodyDragStarting">

    <Grid Width="150"
          Margin="6">
        <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                BorderBrush="{ThemeResource ControlStrokeColorDefault}"
                BorderThickness="1"
                CornerRadius="10"
                Translation="0,0,32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 封面图片 + 重试加载环 -->
                <Grid Grid.Row="0"
                      Height="200">
                    <Border CornerRadius="10,10,0,0"
                            Height="200">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,150,200"/>
                        </Border.Clip>
                        <Image x:Name="CoverImage"
                               Height="200"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center"/>
                    </Border>
                    <!-- 封面重试加载环 -->
                    <Grid x:Name="RetryOverlay"
                          Visibility="Collapsed"
                          Background="{ThemeResource AniMeidoFailedOverlayBrush}">
                        <ProgressRing x:Name="RetryRing"
                                      Width="24"
                                      Height="24"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource SystemAccentColor}"/>
                    </Grid>
                </Grid>

                <!-- 星期放送角标（补番页使用，默认隐藏） -->
                <Border x:Name="WeekdayBadge"
                        Background="{ThemeResource SystemAccentColor}"
                        CornerRadius="0,0,10,0"
                        Padding="8,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Visibility="Collapsed">
                    <TextBlock x:Name="WeekdayBadgeText"
                               Text=""
                               Foreground="{ThemeResource AniMeidoBadgeTextBrush}"
                               FontSize="12"
                               FontWeight="Bold"/>
                </Border>

                <!-- 动画形态角标（番剧库使用，默认隐藏） -->
                <Border x:Name="MediaFormatBadge"
                        Background="{ThemeResource SystemAccentColor}"
                        CornerRadius="0,0,10,0"
                        Padding="8,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Visibility="Collapsed">
                    <TextBlock x:Name="MediaFormatBadgeText"
                               Foreground="{ThemeResource AniMeidoBadgeTextBrush}"
                               FontSize="12"
                               FontWeight="Bold"/>
                </Border>

                <!-- 评分角标（封面右下角） -->
                <Border x:Name="ScoreBadge"
                        Background="{ThemeResource SystemAccentColor}"
                        CornerRadius="10,0,0,0"
                        Padding="6,3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ScoreText"
                               Foreground="{ThemeResource AniMeidoBadgeTextBrush}"
                               FontSize="12"
                               FontWeight="Bold"/>
                </Border>

                <!-- 文字信息 -->
                <StackPanel Grid.Row="1"
                            Padding="10,8">
                    <TextBlock Text="{Binding Title}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="2"
                               Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding AirDate}"
                               FontSize="12"
                               Foreground="{ThemeResource AniMeidoMutedTextBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>


