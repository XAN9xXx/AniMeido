<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.RecommendationPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AniMeido.Plugin.Base.Views.Controls"
    xmlns:models="using:AniMeido.Plugin.Base.Models"
    xmlns:viewModels="using:AniMeido.Plugin.Base.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24,20,24,24"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel Spacing="2">
                <TextBlock Text="为你推荐"
                           Style="{StaticResource AniMeidoPageTitleStyle}"/>
                <TextBlock Text="基于本地记录生成，可查看和修正每一项依据"
                           Style="{StaticResource AniMeidoPageSubtitleStyle}"/>
            </StackPanel>
            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    Click="OnRefreshClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                    <TextBlock Text="刷新推荐"/>
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar x:Name="StatusInfoBar"
                 Grid.Row="1"
                 IsClosable="True"/>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <ToggleButton x:Name="RecommendationsSectionButton"
                              Tag="recommendations"
                              Style="{StaticResource AniMeidoSectionTabStyle}"
                              Click="OnSectionButtonClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE734;" FontSize="15"/>
                        <TextBlock Text="为你推荐"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ProfileSectionButton"
                              Tag="profile"
                              Style="{StaticResource AniMeidoSectionTabStyle}"
                              Click="OnSectionButtonClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE77B;" FontSize="15"/>
                        <TextBlock Text="偏好画像"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="HiddenSectionButton"
                              Tag="hidden"
                              Style="{StaticResource AniMeidoSectionTabStyle}"
                              Click="OnSectionButtonClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xED1A;" FontSize="15"/>
                        <TextBlock Text="已隐藏"/>
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <ProgressRing Width="18" Height="18"
                              IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}"/>
                <TextBlock Text="{x:Bind ViewModel.SnapshotText, Mode=OneWay}"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <ScrollViewer x:Name="RecommendationsPanel">
                <StackPanel Spacing="16" Padding="0,0,4,4">
                    <Border x:Name="ColdStartPanel"
                            Style="{StaticResource AniMeidoCardStyle}"
                            Visibility="{x:Bind ViewModel.IsColdStart, Mode=OneWay}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                            <StackPanel Spacing="8">
                                <TextBlock Text="先告诉我你喜欢什么"
                                           Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                                <TextBlock Text="选择几个标签即可开始。这些选择只用于推荐，不会加入收藏标签。"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="10">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SuggestedTags, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal"
                                                           MaximumRowsOrColumns="3"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:RecommendationTagOption">
                                            <ToggleButton Content="{x:Bind Name}"
                                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                          Margin="4"
                                                          Click="OnOnboardingTagToggle"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Spacing="8">
                                    <Button Content="换一批"
                                            Click="OnRefreshSuggestedTagsClick"/>
                                    <Button x:Name="GenerateFromTagsButton"
                                            Content="使用所选标签生成推荐"
                                            Style="{StaticResource AccentButtonStyle}"
                                            IsEnabled="False"
                                            Click="OnGenerateFromTagsClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource AniMeidoCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="推荐流"
                                       Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                            <TextBlock Text="主推荐流不会包含已有追番标记或已屏蔽的作品。"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <ListView ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="False">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,12"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:RecommendationItem">
                                <Border Style="{StaticResource AniMeidoCardStyle}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                                        <controls:AnimeCard DataContext="{x:Bind Anime}"
                                                            CardClicked="OnAnimeCardClicked"/>
                                        <StackPanel Grid.Column="1" Spacing="10" Margin="0,8,0,8">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{x:Bind Anime.Title}"
                                                           FontSize="20"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind Metadata}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="推荐依据"
                                                       FontWeight="SemiBold"/>
                                            <ItemsControl ItemsSource="{x:Bind Reasons}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:RecommendationReason">
                                                        <Button Tag="{x:Bind Feature}"
                                                                HorizontalAlignment="Left"
                                                                Margin="0,0,0,6"
                                                                Click="OnReasonClick">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <FontIcon Glyph="&#xE8EC;" FontSize="12"/>
                                                                <TextBlock Text="{x:Bind Text}"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Spacing="8">
                                            <Button Content="查看详情"
                                                    Tag="{x:Bind}"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Click="OnViewDetailsClick"/>
                                            <Button Content="不再推荐"
                                                    Tag="{x:Bind}"
                                                    Click="OnHideClick"/>
                                            <Button Content="不感兴趣"
                                                    Tag="{x:Bind}"
                                                    Click="OnNotInterestedClick"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ProfilePanel" Visibility="Collapsed">
                <StackPanel Spacing="16" Padding="0,0,4,4">
                    <Border Style="{StaticResource AniMeidoCardStyle}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="偏好画像"
                                           Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                                <TextBlock Text="画像来自评分、追番、计划、进度与浏览记录；手工选择会优先影响排序。"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="清除全部手工偏好"
                                    Click="OnClearPreferencesClick"/>
                        </Grid>
                    </Border>
                    <ListView ItemsSource="{x:Bind ViewModel.Profile, Mode=OneWay}"
                              SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:RecommendationFeatureProfile">
                                <Grid Padding="10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="6" Padding="8,4">
                                        <TextBlock Text="{x:Bind Feature.KindText}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{x:Bind Feature.DisplayName}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind EvidenceText}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="{x:Bind DirectionText}"
                                            Tag="{x:Bind Feature}"
                                            Click="OnPreferenceClick"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="HiddenPanel" Visibility="Collapsed">
                <StackPanel Spacing="16" Padding="0,0,4,4">
                    <Border Style="{StaticResource AniMeidoCardStyle}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="已隐藏作品"
                                           Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                                <TextBlock Text="恢复后，作品会在下一次重新评分时重新参与推荐。"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="全部恢复"
                                    Click="OnClearHiddenClick"/>
                        </Grid>
                    </Border>
                    <ListView ItemsSource="{x:Bind ViewModel.HiddenAnime, Mode=OneWay}"
                              SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:RecommendationHiddenAnime">
                                <Grid Padding="10" ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind HiddenAtText}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="恢复"
                                            Tag="{x:Bind}"
                                            Click="OnRestoreClick"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
