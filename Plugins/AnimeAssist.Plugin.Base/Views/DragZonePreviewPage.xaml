<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.DragZonePreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsHitTestVisible="False"
    IsEnabled="False">

    <Page.Resources>
        <DataTemplate x:Key="PreviewCardTemplate">
            <Border Width="160"
                    Height="240"
                    Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="10">
                <StackPanel>
                    <Border Height="160"
                            CornerRadius="10,10,0,0"
                            Background="{ThemeResource SolidBackgroundFillColorTertiary}">
                        <Image Source="ms-appx:///Assets/Placeholder_cover.png"
                               Stretch="UniformToFill"
                               Width="160"
                                Height="160"/>
                    </Border>
                    <StackPanel Padding="8,6"
                            Spacing="4">
                        <Border Height="12"
                                CornerRadius="2"
                                Background="{ThemeResource ControlStrokeColorDefault}"
                                Opacity="0.5"/>
                        <Border Height="12"
                                Width="80"
                                CornerRadius="2"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource ControlStrokeColorDefault}"
                                Opacity="0.3"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 星期分组标识 -->
        <StackPanel Orientation="Horizontal"
                Spacing="8"
                Margin="4,4,0,8">
            <Border Padding="10,4"
                    CornerRadius="4"
                    Background="{ThemeResource SystemAccentColor}"
                    Opacity="0.2">
                <TextBlock Text="周一"
                        FontSize="11"
                           Foreground="{ThemeResource SystemAccentColor}"
                           FontWeight="SemiBold"/>
            </Border>
            <Border Padding="10,4"
                    CornerRadius="4"
                    Background="{ThemeResource CardBackgroundFillColorDefault}">
                <TextBlock Text="周二"
                        FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Border>
            <Border Padding="10,4"
                    CornerRadius="4"
                    Background="{ThemeResource CardBackgroundFillColorDefault}">
                <TextBlock Text="周三"
                        FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Border>
        </StackPanel>

        <!-- 静态卡片网格 -->
        <ScrollViewer Grid.Row="1"
                VerticalScrollMode="Disabled"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Hidden">
            <StackPanel Spacing="8">
                <StackPanel>
                    <TextBlock Text="周一 6月26日"
                            FontSize="12"
                            FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="4,0,0,4"/>
                    <ItemsControl ItemsSource="{x:Bind _sampleCard}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"
                                               HorizontalAlignment="Left"
                                               ItemWidth="160"
                                        ItemHeight="240"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="PreviewCardTemplate"/>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
