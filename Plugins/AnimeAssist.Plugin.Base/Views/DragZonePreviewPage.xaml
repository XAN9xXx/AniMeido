<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.DragZonePreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsHitTestVisible="False"
    IsEnabled="False">

    <Page.Resources>
        <DataTemplate x:Key="MiniCard">
            <Border Width="120"
                    Height="180"
                    Style="{StaticResource AniMeidoContentCardStyle}"
                    CornerRadius="10"
                    Padding="0"
                    Margin="0,0,4,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="140"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            CornerRadius="10,10,0,0"
                            Background="{ThemeResource SolidBackgroundFillColorTertiary}">
                        <Image Source="ms-appx:///Assets/Placeholder_cover.png"
                               Stretch="UniformToFill"
                               Width="120"
                               Height="140"/>
                    </Border>
                    <StackPanel Grid.Row="1"
                                Padding="8,4"
                                Spacing="2">
                        <Border Height="8"
                                CornerRadius="2"
                                Background="{ThemeResource ControlStrokeColorDefault}"
                                Opacity="0.4"/>
                        <Border Height="6"
                                Width="50"
                                CornerRadius="2"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource ControlStrokeColorDefault}"
                                Opacity="0.2"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollMode="Disabled"
                  VerticalScrollBarVisibility="Hidden"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Hidden"
                  Padding="12,8">
        <StackPanel Spacing="12">
            <!-- 星期分组 1 -->
            <Border Style="{StaticResource AniMeidoContentCardStyle}"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="周一"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="4,0,0,4"/>
                    <ItemsControl ItemsSource="{x:Bind _sampleCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"
                                               HorizontalAlignment="Left"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="MiniCard"/>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 星期分组 2 -->
            <Border Style="{StaticResource AniMeidoContentCardStyle}"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="周二"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="4,0,0,4"/>
                    <ItemsControl ItemsSource="{x:Bind _sampleCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"
                                               HorizontalAlignment="Left"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="MiniCard"/>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
