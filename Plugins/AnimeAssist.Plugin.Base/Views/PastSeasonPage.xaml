<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.PastSeasonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AniMeido.Plugin.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:controls="using:AniMeido.Plugin.Base.Views.Controls"
    xmlns:contracts="using:AniMeido.Contracts.Models">

    <Grid AllowDrop="True"
          Padding="24,20,24,24"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          Loaded="OnPageLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 错误提示 (始终在顶部) -->
        <InfoBar x:Name="ErrorInfoBar"
                 Grid.Row="0"
                 Severity="Error"
                 IsClosable="True"
                 IsOpen="False"
                 Margin="0,0,0,12"/>
        <!-- 固定顶部区域：搜索过滤 + 年份季度选择器 -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,16"
                    Spacing="12">
            <StackPanel Spacing="2">
                <TextBlock Text="番剧库"
                           Style="{StaticResource AniMeidoPageTitleStyle}"/>
                <TextBlock Text="按年份、季度与形态浏览全部动画"
                           Style="{StaticResource AniMeidoPageSubtitleStyle}"/>
            </StackPanel>
            <!-- 搜索过滤 -->
            <Border x:Name="FilterCard"
                    Style="{StaticResource AniMeidoToolbarStyle}"
                    Visibility="Collapsed">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="8">
                    <FontIcon Glyph="&#xE721;"
                              FontSize="14"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="FilterBox"
                             Grid.Column="1"
                             PlaceholderText="搜索当前列表…"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="14"
                             TextChanged="OnFilterTextChanged"/>
                </Grid>
            </Border>
            <!-- 年份季度选择器 (固定) -->
            <Border Style="{StaticResource AniMeidoToolbarStyle}">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="12">
                    <ComboBox x:Name="YearComboBox"
                              Header="年份"
                              Width="140"/>
                    <ComboBox x:Name="SeasonComboBox"
                              Grid.Column="1"
                              Header="季度"
                              Width="140"/>
                    <ComboBox x:Name="MediaFormatComboBox"
                              Grid.Column="2"
                              Header="动画形态"
                              Width="160"
                              SelectionChanged="OnMediaFormatSelectionChanged"/>
                    <Button x:Name="RefreshButton"
                            Grid.Column="3"
                            Content="刷新当前季度"
                            Click="OnRefreshClick"
                            VerticalAlignment="Bottom"/>
                    <TextBlock Grid.Column="4"
                               Text="选择季度后自动加载"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,8"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
            </Border>
        </StackPanel>
        <!-- 内容区域 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

                <!-- 统计信息 -->
                <Border x:Name="StatsCard"
                        Style="{StaticResource AniMeidoContentCardStyle}"
                        Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                        <TextBlock Text="当前显示"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TotalCountText"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="部动画"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 空状态提示 -->
                <StackPanel x:Name="EmptyState"
                            Grid.Row="1"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            Margin="0,40,0,0">
                    <FontIcon Glyph="&#xE11A;"
                              Style="{StaticResource AniMeidoEmptyStateIconStyle}"/>
                    <TextBlock x:Name="EmptyStateText"
                               Text="该季度暂无番剧数据"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"/>
                </StackPanel>

                <!-- 番剧网格 -->
                <GridView x:Name="AnimeGridView"
                          Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.AnimeList, Mode=OneWay}"
                          SelectionMode="None"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="UseSystemFocusVisuals"
                                    Value="False"/>
                            <Setter Property="IsTabStop"
                                    Value="False"/>
                            <Setter Property="Margin"
                                    Value="0,0,4,8"/>
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="contracts:Anime">
                            <controls:AnimeCard ShowMediaFormatBadge="True"
                                                CardClicked="OnAnimeCardClicked"/>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

        </Grid>

        <!-- 加载/重试覆盖层 -->
        <Grid Grid.Row="1"
              x:Name="LoadingOverlay"
              Visibility="Collapsed"
              Background="{ThemeResource AniMeidoOverlayScrimBrush}"
              Tapped="OnLoadingOverlayTapped">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <ProgressRing x:Name="LoadingRing"
                              Height="40"
                              Width="40"
                              HorizontalAlignment="Center"
                              IsActive="True"/>
                <Image x:Name="LoadingFailedImage"
                       Source="ms-appx:///Assets/Loading_failed.png"
                       Width="80"
                       Height="80"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed"/>
                <TextBlock x:Name="LoadingHint"
                           FontSize="14"
                           Foreground="{ThemeResource AniMeidoMutedTextBrush}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="300"
                           TextAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Canvas x:Name="DragOverlay"
                Grid.RowSpan="2"
                Visibility="Collapsed"
                Background="Transparent"
                AllowDrop="True"/>
    </Grid>
</Page>


