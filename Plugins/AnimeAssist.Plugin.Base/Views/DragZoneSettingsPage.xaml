<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.DragZoneSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24"
                    Spacing="16">

            <TextBlock Text="拖放标记"
                       FontSize="20"
                       FontWeight="Bold"/>

            <TextBlock Text="在预览区拖拽区域可移动位置，拖拽右下角手柄调整大小，点击区域切换动作。可添加或删除区域。"
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="WrapWholeWords"/>

            <!-- 可视化预览区 -->
            <Border x:Name="PreviewBorder"
                    Height="360"
                    MaxHeight="400"
                    MinHeight="200"
                    Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="12"
                    BorderBrush="{ThemeResource ControlStrokeColorDefault}"
                    BorderThickness="1"
                    Padding="0"
                    SizeChanged="OnPreviewBorderSizeChanged">
                <Grid>
                    <Frame x:Name="PreviewFrame"
                           IsHitTestVisible="False"/>
                    <!-- 动态 zone 覆盖层由代码生成，放置于此 Grid -->
                </Grid>
            </Border>

            <!-- 添加区域按钮 -->
            <Button x:Name="AddZoneButton"
                    Content="＋ 添加区域"
                    HorizontalAlignment="Left"
                    Click="OnAddZone"
                    Height="32"
                    FontSize="13"/>

            <!-- 动态区域配置列表 -->
            <TextBlock Text="区域列表"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,8,0,0"/>
            <ItemsControl x:Name="ZoneConfigList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="120,*,32"
                              ColumnSpacing="8"
                              Margin="0,4">
                            <TextBlock Text="{Binding Label}"
                                       VerticalAlignment="Center"
                                       FontSize="14"/>
                            <ComboBox Grid.Column="1"
                                      SelectedIndex="{Binding ActionIndex, Mode=TwoWay}"
                                      SelectionChanged="OnConfigComboChanged"
                                      Tag="{Binding Id}">
                                <x:String>禁用</x:String>
                                <x:String>追番</x:String>
                                <x:String>补番</x:String>
                                <x:String>不感兴趣</x:String>
                            </ComboBox>
                            <Button Grid.Column="2"
                                    Content="×"
                                    Width="32"
                                    Height="32"
                                    FontSize="14"
                                    Click="OnDeleteZone"
                                    Tag="{Binding Id}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="恢复默认"
                    HorizontalAlignment="Right"
                    Click="OnResetDragZones"
                    Height="32"
                    FontSize="13"
                    Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
