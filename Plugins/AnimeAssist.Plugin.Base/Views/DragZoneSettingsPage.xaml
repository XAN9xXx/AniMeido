<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.DragZoneSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24"
                    Spacing="16">

            <TextBlock Text="拖放标记"
                       FontSize="20"
                       FontWeight="Bold"/>

            <TextBlock Text="将番剧卡片拖拽到屏幕四角区域快速标记状态。拖动区域右下角手柄调整大小，点击区域切换动作。"
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="WrapWholeWords"/>

            <!-- 可视化预览区 -->
            <Border x:Name="PreviewBorder"
                    Height="360"
                    MaxHeight="400"
                    MinHeight="200"
                    Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="12"
                    BorderBrush="{ThemeResource ControlStrokeColorDefault}"
                    BorderThickness="1"
                    Padding="0"
                    SizeChanged="OnPreviewBorderSizeChanged">
                <!-- 底层：预览页面，四角目标区覆盖其上 -->
                <Grid>
                    <Frame x:Name="PreviewFrame"
                           IsHitTestVisible="False"/>
                    <!-- 左上角 -->
                    <Border x:Name="PreviewTL"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="100"
                            Height="80"
                            Background="#FF4488"
                            CornerRadius="8"
                            Tapped="OnPreviewZoneTapped"
                            Tag="TopLeft">
                        <Grid>
                            <TextBlock x:Name="PreviewTLText"
                                       Text="禁用"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="8,6,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"/>
                            <Border x:Name="HandleTL"
                                    Width="16"
                                    Height="16"
                                    Background="#CCFFFFFF"
                                    CornerRadius="3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    PointerPressed="OnHandlePointerPressed"
                                    PointerMoved="OnHandlePointerMoved"
                                    PointerReleased="OnHandlePointerReleased"/>
                        </Grid>
                    </Border>

                    <!-- 右上角 -->
                    <Border x:Name="PreviewTR"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Width="100"
                            Height="80"
                            Background="#FF8844"
                            CornerRadius="8"
                            Tapped="OnPreviewZoneTapped"
                            Tag="TopRight">
                        <Grid>
                            <TextBlock x:Name="PreviewTRText"
                                       Text="追番"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="8,6,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"/>
                            <Border x:Name="HandleTR"
                                    Width="16"
                                    Height="16"
                                    Background="#CCFFFFFF"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    PointerPressed="OnHandlePointerPressed"
                                    PointerMoved="OnHandlePointerMoved"
                                    PointerReleased="OnHandlePointerReleased"/>
                        </Grid>
                    </Border>

                    <!-- 左下角 -->
                    <Border x:Name="PreviewBL"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Width="100"
                            Height="80"
                            Background="#44FF88"
                            CornerRadius="8"
                            Tapped="OnPreviewZoneTapped"
                            Tag="BottomLeft">
                        <Grid>
                            <TextBlock x:Name="PreviewBLText"
                                       Text="补番"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="8,0,0,6"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Bottom"/>
                            <Border x:Name="HandleBL"
                                    Width="16"
                                    Height="16"
                                    Background="#CCFFFFFF"
                                    CornerRadius="3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    PointerPressed="OnHandlePointerPressed"
                                    PointerMoved="OnHandlePointerMoved"
                                    PointerReleased="OnHandlePointerReleased"/>
                        </Grid>
                    </Border>

                    <!-- 右下角 -->
                    <Border x:Name="PreviewBR"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Width="100"
                            Height="80"
                            Background="#888888"
                            CornerRadius="8"
                            Tapped="OnPreviewZoneTapped"
                            Tag="BottomRight">
                        <Grid>
                            <TextBlock x:Name="PreviewBRText"
                                       Text="禁用"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="8,0,0,6"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Bottom"/>
                            <Border x:Name="HandleBR"
                                    Width="16"
                                    Height="16"
                                    Background="#CCFFFFFF"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    PointerPressed="OnHandlePointerPressed"
                                    PointerMoved="OnHandlePointerMoved"
                                    PointerReleased="OnHandlePointerReleased"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 四个角的详细配置 -->
            <TextBlock Text="详细配置"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,8,0,0"/>

            <Grid ColumnDefinitions="120,*,80"
                  ColumnSpacing="8">
                <TextBlock Text="左上角"
                           VerticalAlignment="Center"
                           FontSize="14"/>
                <ComboBox x:Name="TopLeftAction"
                          Grid.Column="1"
                          SelectedIndex="3"
                          SelectionChanged="OnDragZoneChanged">
                    <x:String>禁用</x:String>
                    <x:String>追番</x:String>
                    <x:String>补番</x:String>
                    <x:String>不感兴趣</x:String>
                </ComboBox>
                <Slider x:Name="TopLeftSize"
                        Grid.Column="2"
                        Minimum="15"
                        Maximum="40"
                        Value="25"
                        TickFrequency="5"
                        ValueChanged="OnDragZoneSliderChanged"/>
            </Grid>

            <Grid ColumnDefinitions="120,*,80"
                  ColumnSpacing="8">
                <TextBlock Text="右上角"
                           VerticalAlignment="Center"
                           FontSize="14"/>
                <ComboBox x:Name="TopRightAction"
                          Grid.Column="1"
                          SelectedIndex="2"
                          SelectionChanged="OnDragZoneChanged">
                    <x:String>禁用</x:String>
                    <x:String>追番</x:String>
                    <x:String>补番</x:String>
                    <x:String>不感兴趣</x:String>
                </ComboBox>
                <Slider x:Name="TopRightSize"
                        Grid.Column="2"
                        Minimum="15"
                        Maximum="40"
                        Value="25"
                        TickFrequency="5"
                        ValueChanged="OnDragZoneSliderChanged"/>
            </Grid>

            <Grid ColumnDefinitions="120,*,80"
                  ColumnSpacing="8">
                <TextBlock Text="左下角"
                           VerticalAlignment="Center"
                           FontSize="14"/>
                <ComboBox x:Name="BottomLeftAction"
                          Grid.Column="1"
                          SelectedIndex="3"
                          SelectionChanged="OnDragZoneChanged">
                    <x:String>禁用</x:String>
                    <x:String>追番</x:String>
                    <x:String>补番</x:String>
                    <x:String>不感兴趣</x:String>
                </ComboBox>
                <Slider x:Name="BottomLeftSize"
                        Grid.Column="2"
                        Minimum="15"
                        Maximum="40"
                        Value="25"
                        TickFrequency="5"
                        ValueChanged="OnDragZoneSliderChanged"/>
            </Grid>

            <Grid ColumnDefinitions="120,*,80"
                  ColumnSpacing="8">
                <TextBlock Text="右下角"
                           VerticalAlignment="Center"
                           FontSize="14"/>
                <ComboBox x:Name="BottomRightAction"
                          Grid.Column="1"
                          SelectedIndex="0"
                          SelectionChanged="OnDragZoneChanged">
                    <x:String>禁用</x:String>
                    <x:String>追番</x:String>
                    <x:String>补番</x:String>
                    <x:String>不感兴趣</x:String>
                </ComboBox>
                <Slider x:Name="BottomRightSize"
                        Grid.Column="2"
                        Minimum="15"
                        Maximum="40"
                        Value="25"
                        TickFrequency="5"
                        ValueChanged="OnDragZoneSliderChanged"/>
            </Grid>

            <Button Content="恢复默认"
                    HorizontalAlignment="Right"
                    Click="OnResetDragZones"
                    Height="32"
                    FontSize="13"
                    Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
