<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.DragZoneSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24"
                    Spacing="16">

            <TextBlock Text="拖放标记"
                       FontSize="20"
                       FontWeight="Bold"/>

            <TextBlock Text="在预览区拖拽区域可移动位置，拖拽右下角手柄调整大小，点击区域切换动作。可添加或删除区域。"
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="WrapWholeWords"/>

            <!-- 缓存管理 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="本地缓存"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="番剧数据缓存到本地后可离线浏览，减少重复请求。"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="WrapWholeWords"/>
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <TextBlock x:Name="CacheInfoText"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button x:Name="ClearCacheButton"
                                Grid.Column="1"
                                Content="清理缓存"
                                Height="32"
                                MinWidth="80"
                                Click="OnClearCacheClick"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 可视化预览区 -->
            <Border x:Name="PreviewBorder"
                    Height="360"
                    MaxHeight="400"
                    MinHeight="200"
                    Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="12"
                    BorderBrush="{ThemeResource ControlStrokeColorDefault}"
                    BorderThickness="1"
                    Padding="0"
                    SizeChanged="OnPreviewBorderSizeChanged">
                <Grid>
                    <Frame x:Name="PreviewFrame"
                           IsHitTestVisible="False"/>
                    <!-- 动态 zone 覆盖层由代码生成，放置于此 Grid -->
                </Grid>
            </Border>

            <!-- 添加区域按钮 -->
            <Button x:Name="AddZoneButton"
                    Content="＋ 添加区域"
                    HorizontalAlignment="Left"
                    Click="OnAddZone"
                    Height="32"
                    FontSize="13"/>

            <!-- 动态区域配置列表 -->
            <TextBlock Text="区域列表"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,8,0,0"/>
            <ItemsControl x:Name="ZoneConfigList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="120,*,32"
                              ColumnSpacing="8"
                              Margin="0,4">
                            <TextBlock Text="{Binding Label}"
                                       VerticalAlignment="Center"
                                       FontSize="14"/>
                            <ComboBox Grid.Column="1"
                                      SelectedIndex="{Binding ActionIndex, Mode=TwoWay}"
                                      SelectionChanged="OnConfigComboChanged"
                                      Tag="{Binding Id}">
                                <x:String>禁用</x:String>
                                <x:String>追番</x:String>
                                <x:String>补番</x:String>
                                <x:String>不感兴趣</x:String>
                                <x:String>关注</x:String>
                                <x:String>已看完</x:String>
                                <x:String>已弃番</x:String>
                                <x:String>屏蔽</x:String>
                            </ComboBox>
                            <Button Grid.Column="2"
                                    Content="×"
                                    Width="32"
                                    Height="32"
                                    FontSize="14"
                                    Click="OnDeleteZone"
                                    Tag="{Binding Id}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="恢复默认"
                    HorizontalAlignment="Right"
                    Click="OnResetDragZones"
                    Height="32"
                    FontSize="13"
                    Margin="0,8,0,0"/>

            <!-- 数据管理 -->
            <TextBlock Text="数据管理"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,24,0,0"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="数据路径"
                               Margin="16,12,16,4"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <Grid Margin="16,0,16,0"
                            Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="数据库路径"
                                    FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="DbPathText"
                                    FontSize="13"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="打开文件夹"
                                Height="32"
                                VerticalAlignment="Center"
                                Click="OnOpenDbDirClick"/>
                    </Grid>

                    <Rectangle Height="1"
                            Fill="{ThemeResource DividerStrokeColorDefault}"
                            Margin="16,0"/>

                    <Grid Margin="16,0,16,0"
                            Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="备份路径"
                                    FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="BackupPathText"
                                    FontSize="13"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="打开文件夹"
                                Height="32"
                                VerticalAlignment="Center"
                                Click="OnOpenBackupDirClick"/>
                    </Grid>

                    <Rectangle Height="1"
                            Fill="{ThemeResource DividerStrokeColorDefault}"
                            Margin="16,0"/>

                    <Grid Margin="16,0,16,0"
                            Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="日志路径"
                                    FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="LogPathText"
                                    FontSize="13"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="打开文件夹"
                                Height="32"
                                VerticalAlignment="Center"
                                Click="OnOpenLogDirClick"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="备份与恢复"
                               Margin="16,12,16,4"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <Grid Margin="16,0,16,0"
                            Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="立即备份"
                                VerticalAlignment="Center"
                                FontSize="15"/>
                        <Button Grid.Column="1"
                                x:Name="BackupNowButton"
                                Content="备份"
                                Height="32"
                                VerticalAlignment="Center"
                                Click="OnBackupNowClick"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="导入导出"
                               Margin="16,12,16,4"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <Grid Margin="16,0,16,0"
                            Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="导出追番数据"
                                VerticalAlignment="Center"
                                FontSize="15"/>
                        <Button Grid.Column="1"
                                x:Name="ExportButton"
                                Content="导出"
                                Height="32"
                                VerticalAlignment="Center"
                                Click="OnExportClick"/>
                    </Grid>

                    <Rectangle Height="1"
                            Fill="{ThemeResource DividerStrokeColorDefault}"
                            Margin="16,0"/>

                    <Grid Margin="16,0,16,0"
                            Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="导入追番数据"
                                VerticalAlignment="Center"
                                FontSize="15"/>
                        <Button Grid.Column="1"
                                x:Name="ImportButton"
                                Content="导入"
                                Height="32"
                                VerticalAlignment="Center"
                                Click="OnImportClick"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
