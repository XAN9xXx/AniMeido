<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.DragZoneSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <StackPanel Spacing="12">

            <TextBlock Text="拖放标记"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,8"/>

            <TextBlock Text="将番剧卡片拖拽到屏幕四角区域快速标记状态"
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,8"/>

            <Grid ColumnDefinitions="120,*,80"
                  ColumnSpacing="8">
                <TextBlock Text="左上角"
                           VerticalAlignment="Center"
                           FontSize="14"/>
                <ComboBox x:Name="TopLeftAction"
                          Grid.Column="1"
                          SelectedIndex="3"
                          SelectionChanged="OnDragZoneChanged">
                    <x:String>禁用</x:String>
                    <x:String>追番</x:String>
                    <x:String>补番</x:String>
                    <x:String>不感兴趣</x:String>
                </ComboBox>
                <Slider x:Name="TopLeftSize"
                        Grid.Column="2"
                        Minimum="15"
                        Maximum="40"
                        Value="25"
                        TickFrequency="5"
                        ValueChanged="OnDragZoneSliderChanged"/>
            </Grid>

            <Grid ColumnDefinitions="120,*,80"
                  ColumnSpacing="8">
                <TextBlock Text="右上角"
                           VerticalAlignment="Center"
                           FontSize="14"/>
                <ComboBox x:Name="TopRightAction"
                          Grid.Column="1"
                          SelectedIndex="2"
                          SelectionChanged="OnDragZoneChanged">
                    <x:String>禁用</x:String>
                    <x:String>追番</x:String>
                    <x:String>补番</x:String>
                    <x:String>不感兴趣</x:String>
                </ComboBox>
                <Slider x:Name="TopRightSize"
                        Grid.Column="2"
                        Minimum="15"
                        Maximum="40"
                        Value="25"
                        TickFrequency="5"
                        ValueChanged="OnDragZoneSliderChanged"/>
            </Grid>

            <Grid ColumnDefinitions="120,*,80"
                  ColumnSpacing="8">
                <TextBlock Text="左下角"
                           VerticalAlignment="Center"
                           FontSize="14"/>
                <ComboBox x:Name="BottomLeftAction"
                          Grid.Column="1"
                          SelectedIndex="3"
                          SelectionChanged="OnDragZoneChanged">
                    <x:String>禁用</x:String>
                    <x:String>追番</x:String>
                    <x:String>补番</x:String>
                    <x:String>不感兴趣</x:String>
                </ComboBox>
                <Slider x:Name="BottomLeftSize"
                        Grid.Column="2"
                        Minimum="15"
                        Maximum="40"
                        Value="25"
                        TickFrequency="5"
                        ValueChanged="OnDragZoneSliderChanged"/>
            </Grid>

            <Grid ColumnDefinitions="120,*,80"
                  ColumnSpacing="8">
                <TextBlock Text="右下角"
                           VerticalAlignment="Center"
                           FontSize="14"/>
                <ComboBox x:Name="BottomRightAction"
                          Grid.Column="1"
                          SelectedIndex="0"
                          SelectionChanged="OnDragZoneChanged">
                    <x:String>禁用</x:String>
                    <x:String>追番</x:String>
                    <x:String>补番</x:String>
                    <x:String>不感兴趣</x:String>
                </ComboBox>
                <Slider x:Name="BottomRightSize"
                        Grid.Column="2"
                        Minimum="15"
                        Maximum="40"
                        Value="25"
                        TickFrequency="5"
                        ValueChanged="OnDragZoneSliderChanged"/>
            </Grid>

            <Button Content="恢复默认"
                    HorizontalAlignment="Right"
                    Click="OnResetDragZones"
                    Height="32"
                    FontSize="13"
                    Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</Page>
