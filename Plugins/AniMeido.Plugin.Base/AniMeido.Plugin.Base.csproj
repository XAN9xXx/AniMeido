<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>$(AniMeidoVersion)</Version>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
  </PropertyGroup>

  <!-- WinUI 包已把所有 .xaml 作为 Page 编译；它移出 None 的规则早于 SDK 默认项执行而失效，这里补上，让 XAML 只作为 Page 存在。 -->
  <ItemGroup>
    <None Remove="**\*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AniMeido.Contracts\AniMeido.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>AniMeido.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
