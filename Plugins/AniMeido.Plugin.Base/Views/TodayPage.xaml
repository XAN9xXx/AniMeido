<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="AniMeido.Plugin.Base.Views.TodayPage" x:Name="RootPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:AniMeido.Plugin.Base.ViewModels"
      xmlns:views="using:AniMeido.Plugin.Base.Views"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <Style x:Key="TodaySectionCardStyle" TargetType="Border" BasedOn="{StaticResource AniMeidoContentCardStyle}">
            <Setter Property="Padding" Value="20"/>
        </Style>
        <!-- 卡片内的次级面板：计划行、观看行、日期格共用同一层浅底 -->
        <Style x:Key="TodayTileStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style x:Key="TodayTileButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TodayCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <!-- 今天的个人相关放送：封面、标题、个人状态与放送星期；日历接口不提供简介 -->
        <DataTemplate x:Key="BroadcastEntryTemplate" x:DataType="vm:TodayAnimeEntry">
            <Button Tag="{x:Bind Anime}" Click="OnAnimeButtonClick" Style="{StaticResource TodayTileButtonStyle}" Height="104">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Width="58" Height="82" CornerRadius="6" Background="{ThemeResource AniMeidoPlaceholderBackgroundBrush}">
                        <Image DataContext="{x:Bind Anime}" Stretch="UniformToFill" Loaded="OnCoverLoaded" DataContextChanged="OnCoverDataContextChanged"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="{x:Bind Anime.Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Visibility="{x:Bind HasBadge}" Padding="8,2" CornerRadius="10" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <TextBlock Text="{x:Bind Badge}" FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Border>
                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource TodayCaptionStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- 本周条带的一天：今天用强调色描边 -->
        <DataTemplate x:Key="BroadcastDayTemplate" x:DataType="vm:TodayBroadcastDay">
            <Grid Height="124">
                <Border Style="{StaticResource TodayTileStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Bind CountText}" Visibility="{x:Bind IsToday}" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{x:Bind CountText}" Visibility="{x:Bind IsOtherDay}" Style="{StaticResource TodayCaptionStyle}" HorizontalAlignment="Center"/>
                        <ItemsControl ItemsSource="{x:Bind PreviewTitles}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock FontSize="12" MaxLines="1" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind}">
                                        <Run Text="· "/><Run Text="{x:Bind}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{x:Bind MoreText}" Visibility="{x:Bind HasMore}" Style="{StaticResource TodayCaptionStyle}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="8" BorderThickness="2" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind IsToday}" IsHitTestVisible="False"/>
            </Grid>
        </DataTemplate>

        <!-- 整行可点击进入详情；“打开播放器”叠放在行上，而不是嵌套在行按钮里 -->
        <DataTemplate x:Key="PlaybackEntryTemplate" x:DataType="vm:TodayAnimeEntry">
            <Grid Margin="0,0,0,8">
                <Button Tag="{x:Bind Anime}" Click="OnAnimeButtonClick" Style="{StaticResource TodayTileButtonStyle}" Padding="10,10,150,10" AutomationProperties.Name="{x:Bind Anime.Title}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Width="48" Height="68" CornerRadius="6" Background="{ThemeResource AniMeidoPlaceholderBackgroundBrush}">
                            <Image DataContext="{x:Bind Anime}" Stretch="UniformToFill" Loaded="OnCoverLoaded" DataContextChanged="OnCoverDataContextChanged"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                            <TextBlock Text="{x:Bind Anime.Title}" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource TodayCaptionStyle}" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                            <ProgressBar Value="{x:Bind ProgressPercent}" Maximum="100" Visibility="{x:Bind HasProgress}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind Trailing}" Visibility="{x:Bind HasTrailing}" Style="{StaticResource TodayCaptionStyle}" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Tag="{x:Bind Anime}" Click="OnPlaybackClick" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="13"/>
                        <TextBlock Text="打开播放器"/>
                    </StackPanel>
                </Button>
            </Grid>
        </DataTemplate>

        <!-- 补番计划行：整行是进入详情的按钮，操作按钮叠放在行上（不嵌套），各自处理点击。
             宽行的按钮在行尾，行按钮右侧留出按钮区；紧凑行的按钮在底部，行按钮下方留出按钮区。 -->
        <DataTemplate x:Key="PlanRowWideTemplate" x:DataType="vm:TodayPlanEntry">
            <StackPanel Spacing="8" Padding="0,0,0,8">
                <Grid>
                    <Border CornerRadius="8" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" IsHitTestVisible="False"/>
                    <Button Tag="{x:Bind}" Click="OnPlanDetailsClick" Style="{StaticResource TodayTileButtonStyle}" Padding="8,8,202,8" AutomationProperties.Name="{x:Bind Title}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border Width="36" Height="50" CornerRadius="6" Background="{ThemeResource AniMeidoPlaceholderBackgroundBrush}">
                                    <Image DataContext="{x:Bind Anime}" Stretch="UniformToFill" Loaded="OnCoverLoaded" DataContextChanged="OnCoverDataContextChanged"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Meta}" Visibility="{x:Bind HasNormalMeta}" Style="{StaticResource TodayCaptionStyle}" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Meta}" Visibility="{x:Bind HasOverdueMeta}" FontSize="12" MaxLines="1" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                </StackPanel>
                        </Grid>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Button Tag="{x:Bind}" Click="OnEditPlanClick" Padding="8,4" FontSize="12">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE70F;" FontSize="13"/>
                                    <TextBlock Text="调整计划"/>
                                </StackPanel>
                            </Button>
                            <DropDownButton Padding="8,4" FontSize="12">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xEA8F;" FontSize="13"/>
                                    <TextBlock Text="提醒"/>
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem Text="添加提醒" Tag="{x:Bind}" Click="OnAddReminderClick"/>
                                        <MenuFlyoutItem Text="管理提醒" Tag="{x:Bind}" Click="OnManageRemindersClick"/>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PlanRowCompactTemplate" x:DataType="vm:TodayPlanEntry">
            <StackPanel Spacing="8" Padding="0,0,0,8">
                <Grid MinHeight="82">
                    <Border CornerRadius="8" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" IsHitTestVisible="False"/>
                    <Button Tag="{x:Bind}" Click="OnPlanDetailsClick" Style="{StaticResource TodayTileButtonStyle}" Padding="56,8,8,42" VerticalContentAlignment="Top" AutomationProperties.Name="{x:Bind Title}">
                        <Grid>
                                <StackPanel VerticalAlignment="Top" Spacing="6">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Meta}" Visibility="{x:Bind HasNormalMeta}" Style="{StaticResource TodayCaptionStyle}" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Meta}" Visibility="{x:Bind HasOverdueMeta}" FontSize="12" MaxLines="1" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                </StackPanel>
                        </Grid>
                    </Button>
                    <Border IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" Width="36" Height="50" CornerRadius="6" Background="{ThemeResource AniMeidoPlaceholderBackgroundBrush}">
                            <Image DataContext="{x:Bind Anime}" Stretch="UniformToFill" Loaded="OnCoverLoaded" DataContextChanged="OnCoverDataContextChanged"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,6">
                            <Button Tag="{x:Bind}" Click="OnEditPlanClick" Padding="8,4" FontSize="12">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE70F;" FontSize="13"/>
                                    <TextBlock Text="调整计划"/>
                                </StackPanel>
                            </Button>
                            <DropDownButton Padding="8,4" FontSize="12">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xEA8F;" FontSize="13"/>
                                    <TextBlock Text="提醒"/>
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem Text="添加提醒" Tag="{x:Bind}" Click="OnAddReminderClick"/>
                                        <MenuFlyoutItem Text="管理提醒" Tag="{x:Bind}" Click="OnManageRemindersClick"/>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- 今日主题的一行：整行进入详情；悬停时标记按钮盖住行尾的评分或状态（叠放，不嵌套） -->
        <DataTemplate x:Key="ThemeRowTemplate" x:DataType="vm:TodayThemeItem">
            <Grid PointerEntered="OnThemeRowPointerEntered"
                  PointerExited="OnThemeRowPointerExited"
                  GotFocus="OnThemeRowFocusChanged"
                  LostFocus="OnThemeRowFocusChanged">
                <Button Tag="{x:Bind Anime}" Click="OnAnimeButtonClick" Style="{StaticResource TodayTileButtonStyle}" Padding="8,7,12,7" AutomationProperties.Name="{x:Bind Anime.Title}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Width="44" Height="60" CornerRadius="5" Background="{ThemeResource AniMeidoPlaceholderBackgroundBrush}">
                            <Image DataContext="{x:Bind Anime}" Stretch="UniformToFill" Loaded="OnCoverLoaded" DataContextChanged="OnCoverDataContextChanged"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Anime.Title}" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Meta}" Style="{StaticResource TodayCaptionStyle}" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Note}" Visibility="{x:Bind HasNote}" FontSize="12" MaxLines="1" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        <Grid x:Name="ThemeRowTrailing" Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Visibility="{x:Bind HasStatus, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{x:Bind ScoreText}" Visibility="{x:Bind ShowScore, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        </Grid>
                    </Grid>
                </Button>
                <StackPanel x:Name="ThemeRowActions"
                            Opacity="{x:Bind ActionOpacity, Mode=OneWay}"
                            Orientation="Horizontal"
                            Spacing="4"
                            Margin="0,0,10,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Button Content="{x:Bind PrimaryLabel, Mode=OneWay}"
                            Tag="{x:Bind}"
                            Visibility="{x:Bind HasPrimary, Mode=OneWay}"
                            Click="OnThemePrimaryClick"
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="10,2"
                            FontSize="12"/>
                    <Button Content="{x:Bind SecondaryLabel, Mode=OneWay}"
                            Tag="{x:Bind}"
                            Visibility="{x:Bind HasSecondary, Mode=OneWay}"
                            Click="OnThemeSecondaryClick"
                            Padding="10,2"
                            FontSize="12"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- 轮换进度：当前主题是一小段横条，其余是圆点 -->
        <DataTemplate x:Key="ThemeDotTemplate" x:DataType="vm:TodayThemeDot">
            <Grid Height="6" VerticalAlignment="Center">
                <Rectangle Width="16" RadiusX="3" RadiusY="3" Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind IsCurrent}"/>
                <Ellipse Width="6" Fill="{ThemeResource ControlStrongStrokeColorDisabledBrush}" Visibility="{x:Bind IsOther}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BrowseEntryTemplate" x:DataType="vm:TodayBrowseEntry">
            <Button Tag="{x:Bind Anime}" Click="OnAnimeButtonClick" Style="{StaticResource TodayTileButtonStyle}" Height="76" Padding="8">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Width="40" Height="56" CornerRadius="5" Background="{ThemeResource AniMeidoPlaceholderBackgroundBrush}">
                        <Image DataContext="{x:Bind Anime}" Stretch="UniformToFill" Loaded="OnCoverLoaded" DataContextChanged="OnCoverDataContextChanged"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{x:Bind Anime.Title}" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource TodayCaptionStyle}"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,20,24,24">
        <ScrollViewer ViewChanged="OnPageScrollChanged" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Enabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContentPanel" Spacing="16" SizeChanged="OnContentSizeChanged">
                <!-- 页头与消息条放在无间距容器里：消息条关闭时折叠，不再留出空白 -->
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="今天" Style="{StaticResource AniMeidoPageTitleStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.TodayLabel, Mode=OneWay}" Style="{StaticResource AniMeidoPageSubtitleStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
                            <Button Click="OnRefreshClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                    <TextBlock Text="刷新"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <InfoBar x:Name="ErrorInfoBar" Severity="Error" IsClosable="True" Margin="0,12,0,0" Visibility="{x:Bind ErrorInfoBar.IsOpen, Mode=OneWay}"/>
                    <InfoBar x:Name="NotificationInfoBar" Severity="Informational" IsClosable="True" Margin="0,12,0,0" Visibility="{x:Bind NotificationInfoBar.IsOpen, Mode=OneWay}"/>
                </StackPanel>

                <!-- 今日放送：左侧回答“今天有哪些与我相关”，右侧是本周条带 -->
                <Border Style="{StaticResource TodaySectionCardStyle}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="24">
                        <Grid Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,0,0,14">
                            <TextBlock Text="今日放送" Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                            <TextBlock Grid.Column="1" Text="按放送表 · 上线时间以平台为准" Style="{StaticResource TodayCaptionStyle}" VerticalAlignment="Center" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="2" Content="放送日历" Style="{StaticResource AniMeidoNavigateButtonStyle}" VerticalAlignment="Center" Click="OnCalendarClick"/>
                        </Grid>

                        <Grid x:Name="TodayContent" Grid.Row="1" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20" Visibility="{x:Bind ViewModel.HasNoBroadcasts, Mode=OneWay}">
                                <Image Source="ms-appx:///Assets/Empty_anime.png" Width="84" Height="126" Stretch="Uniform"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.BroadcastMessage, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind ViewModel.NextBroadcastText, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasNextBroadcast, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.PersonalBroadcasts, Mode=OneWay}" ItemTemplate="{StaticResource BroadcastEntryTemplate}" Visibility="{x:Bind ViewModel.HasBroadcasts, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MaximumRowsOrColumns="{x:Bind ViewModel.BroadcastColumns, Mode=OneWay}" MinItemWidth="260" MinItemHeight="104" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill"/>
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </Grid>

                        <!-- 位置由 code-behind 按宽度调整：宽时在右侧，窄时移到下方 -->
                        <ItemsRepeater x:Name="WeekStrip" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" ItemsSource="{x:Bind ViewModel.BroadcastDays, Mode=OneWay}" ItemTemplate="{StaticResource BroadcastDayTemplate}" Visibility="{x:Bind ViewModel.HasBroadcastDays, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MaximumRowsOrColumns="7" MinItemWidth="88" MinItemHeight="124" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill"/>
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </Grid>
                </Border>

                <!-- 最近观看仅在播放器插件可用时出现。最近观看与今日主题在左栏，补番计划在右栏；
                     窄时从上到下排列。位置与间距由 code-behind 调整 -->
                <Grid x:Name="ActivityGrid" ColumnDefinitions="3*,2*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16">
                    <Border x:Name="PlaybackCard" Style="{StaticResource TodaySectionCardStyle}" VerticalAlignment="Top" Visibility="{x:Bind ViewModel.IsPlaybackAvailable, Mode=OneWay}">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <TextBlock Text="最近观看" Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                                <TextBlock Grid.Column="1" Text="最近播放的在前 · 进度条是这一集看到的位置" Style="{StaticResource TodayCaptionStyle}" VerticalAlignment="Center" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <TextBlock Text="还没有播放记录。" Visibility="{x:Bind ViewModel.HasNoRecentActivity, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.RecentActivity, Mode=OneWay}" ItemTemplate="{StaticResource PlaybackEntryTemplate}"/>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasUnstarted, Mode=OneWay}">
                                <TextBlock Text="还没开始看" FontWeight="SemiBold"/>
                                <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ContinueWatching, Mode=OneWay}" ItemTemplate="{StaticResource PlaybackEntryTemplate}"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ThemeCard" Grid.Row="1" Style="{StaticResource TodaySectionCardStyle}" VerticalAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="今日主题" Style="{StaticResource TodayCaptionStyle}" VerticalAlignment="Center"/>
                                        <Border Padding="7,0" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.Theme.SourceText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Border>
                                        <Border Padding="7,0" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.Theme.IsFallback, Mode=OneWay}">
                                            <TextBlock Text="替补" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.Theme.Title, Mode=OneWay}" Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                                    <TextBlock Text="{x:Bind ViewModel.Theme.Caption, Mode=OneWay}" Style="{StaticResource TodayCaptionStyle}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Theme.CycleDots, Mode=OneWay}" ItemTemplate="{StaticResource ThemeDotTemplate}" HorizontalAlignment="Right" Margin="0,6,0,0"
                                                   AutomationProperties.Name="主题轮换进度">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal" Spacing="4"/>
                                        </ItemsRepeater.Layout>
                                    </ItemsRepeater>
                                    <Button Content="换一批" Command="{x:Bind ViewModel.Theme.NextBatchCommand}" Visibility="{x:Bind ViewModel.Theme.CanShowNextBatch, Mode=OneWay}" HorizontalAlignment="Right" Padding="10,2" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Visibility="{x:Bind ViewModel.Theme.HasStatusText, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.Theme.StatusText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Button Grid.Column="1" Content="重试" Command="{x:Bind ViewModel.Theme.RetryCommand}" Visibility="{x:Bind ViewModel.Theme.IsFailed, Mode=OneWay}" Padding="10,2" FontSize="12"/>
                            </Grid>
                            <ItemsRepeater x:Name="ThemeRows" ItemsSource="{x:Bind ViewModel.Theme.Items, Mode=OneWay}" ItemTemplate="{StaticResource ThemeRowTemplate}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout x:Name="ThemeRowsLayout" MaximumRowsOrColumns="2" MinItemWidth="260" MinItemHeight="76" MinColumnSpacing="10" MinRowSpacing="8" ItemsStretch="Fill"/>
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                            <TextBlock Text="{x:Bind ViewModel.Theme.NextThemeText, Mode=OneWay}" Style="{StaticResource TodayCaptionStyle}"/>
                        </StackPanel>
                    </Border>
                    <!-- 前三项直接显示；其余由底部卡包展开。与今日主题共用一行，自动等高。 -->
                    <Grid x:Name="PlanCard" Grid.Column="1" VerticalAlignment="Stretch">
                        <Grid x:Name="PlanVisual">
                            <Border x:Name="PlanBackdrop" Style="{StaticResource TodaySectionCardStyle}"
                                    Background="{ThemeResource AniMeidoCardBackgroundBrush}" IsHitTestVisible="False"/>
                            <Border x:Name="PlanSurface" Background="Transparent" BorderBrush="Transparent" Style="{StaticResource TodaySectionCardStyle}" TabFocusNavigation="Cycle" KeyDown="OnPlanStackKeyDown">
                                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="补番计划" Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PlanCountText, Mode=OneWay}" Style="{StaticResource TodayCaptionStyle}" VerticalAlignment="Center" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <ScrollViewer x:Name="PlanScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden"
                                                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollMode="Disabled" ZoomMode="Disabled">
                                        <StackPanel>
                                            <TextBlock Text="暂无补番计划。" Visibility="{x:Bind ViewModel.HasNoPlans, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <ItemsControl x:Name="VisiblePlanList" ItemsSource="{x:Bind ViewModel.Plans, Mode=OneWay}"
                                                          ItemTemplate="{StaticResource PlanRowCompactTemplate}" SizeChanged="OnVisiblePlanListSizeChanged">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><views:TodayPlanStackPanel Loaded="OnPlanPanelLoaded" Tapped="OnPlanDeckTapped" Background="Transparent" IsTabStop="True" KeyDown="OnPlanDeckKeyDown"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <StackPanel x:Name="PlanFooter" Grid.Row="2" Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Visibility="{x:Bind ViewModel.HasNotification, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE946;" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.NotificationMessage, Mode=OneWay}" Style="{StaticResource TodayCaptionStyle}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Content="通知设置" Style="{StaticResource AniMeidoNavigateButtonStyle}" FontSize="12" VerticalAlignment="Center" Click="OnNotificationSettingsClick"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <Border Style="{StaticResource TodaySectionCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="最近浏览" Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                            <Button Grid.Column="1" Click="OnClearBrowseHistoryClick" Visibility="{x:Bind ViewModel.HasBrowsed, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                                    <TextBlock Text="清空"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Text="还没有浏览记录。" Visibility="{x:Bind ViewModel.HasNoBrowsed, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.RecentBrowsed, Mode=OneWay}" ItemTemplate="{StaticResource BrowseEntryTemplate}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="240" MinItemHeight="76" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill"/>
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <!-- 展开时迁入同一个 PlanSurface；没有第二套列表或卡片。 -->
        <Popup x:Name="PlanStackPopup" IsLightDismissEnabled="False" ShouldConstrainToRootBounds="False"
               Opened="OnPlanStackOpened" Closed="OnPlanStackClosed">
            <!-- 不让原生 light-dismiss 抢先隐藏；透明区域点击统一走收起动画。 -->
            <Canvas x:Name="PlanDismissCanvas" Background="Transparent"
                    PointerPressed="OnPlanOutsidePressed" PointerWheelChanged="OnPlanOutsideWheel"/>
        </Popup>
    </Grid>
</Page>
