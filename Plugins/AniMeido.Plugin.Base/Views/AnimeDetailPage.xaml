<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.AnimeDetailPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:contracts="using:AniMeido.Contracts.Models"
    xmlns:local="using:AniMeido.Plugin.Base.Views"
    xmlns:vm="using:AniMeido.Plugin.Base.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <InfoBar x:Name="ErrorInfoBar"
                 Grid.Row="0"
                 Margin="24,16,24,0"
                 Severity="Error"
                 IsClosable="True"
                 IsOpen="False"/>

        <ScrollViewer Grid.Row="1"
                      x:Name="ContentScrollViewer">
            <Grid Padding="24,20,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        CornerRadius="12"
                        Margin="0,0,24,0"
                        Width="300"
                        MaxHeight="440"
                        VerticalAlignment="Top"
                        Style="{StaticResource AniMeidoCardStyle}"
                        Padding="0">
                    <Image x:Name="DetailCoverImage"
                           Stretch="Uniform"/>
                </Border>

                <StackPanel Grid.Column="1"
                            Spacing="16">

                    <TextBlock Text="{Binding AnimeDetail.Title}"
                               Style="{StaticResource AniMeidoPageTitleStyle}"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="OnlinePlayButton"
                                Click="OnOnlinePlayClick"
                                IsEnabled="{Binding HasData}"
                                Visibility="Collapsed"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;"/>
                                <TextBlock Text="在线播放"/>
                            </StackPanel>
                        </Button>

                        <Button Click="OnPersonalArchiveClick"
                                IsEnabled="{Binding HasData}"
                                Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8F1;"/>
                                <TextBlock Text="个人档案"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock x:Name="DetailStudio"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="Collapsed"/>

                    <Border Height="1"
                            Background="{ThemeResource DividerStrokeColorDefault}"/>

                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <TextBlock Text="{Binding AnimeDetail.AirDate}"
                                   FontSize="14"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding MediaFormatText}"
                                   FontSize="14"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="·"
                                   FontSize="14"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding ReleasePhaseText}"
                                   FontSize="14"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <TextBlock x:Name="DetailScore"
                               TextWrapping="Wrap"
                               LineHeight="24"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="Collapsed"/>

                    <Border Style="{StaticResource AniMeidoContentCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="简介"
                                       Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                            <TextBlock Text="{Binding AnimeDetail.Description}"
                                       FontSize="15"
                                       TextWrapping="Wrap"
                                       LineHeight="24"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="CharacterSection"
                                Visibility="Collapsed"
                                Spacing="8">
                        <TextBlock Text="角色"
                                   Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                        <ScrollViewer HorizontalScrollMode="Auto"
                                      VerticalScrollMode="Disabled"
                                      HorizontalScrollBarVisibility="Hidden">
                            <StackPanel x:Name="CharacterPanel"
                                        Orientation="Horizontal"
                                        Spacing="8"/>
                        </ScrollViewer>
                    </StackPanel>

                    <Border Height="1"
                            Background="{ThemeResource DividerStrokeColorDefault}"/>

                    <ScrollViewer
                        HorizontalScrollBarVisibility="Hidden"
                        HorizontalScrollMode="Auto"
                        VerticalScrollMode="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.VisibleTrackingActions, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TrackingActionDescriptor">
                                    <ToggleButton
                                        Margin="0,0,8,8"
                                        Padding="14,8"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefault}"
                                        BorderThickness="1"
                                        Command="{Binding ElementName=RootPage, Path=ViewModel.SetTrackingStatusCommand}"
                                        CommandParameter="{x:Bind Status}"
                                        CornerRadius="8"
                                        IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                        IsEnabled="{Binding ElementName=RootPage, Path=ViewModel.HasData}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon
                                                FontSize="14"
                                                Glyph="{x:Bind Glyph}"/>
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Label}"/>
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.CurrentStatusHint, Mode=OneWay}"
                        Visibility="{x:Bind local:AnimeDetailPage.BooleanToVisibility(ViewModel.HasCurrentStatus), Mode=OneWay}"/>

                    <Border Height="1"
                            Background="{ThemeResource DividerStrokeColorDefault}"/>

                    <TextBlock Text="Bangumi 标签"
                               Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                    <StackPanel x:Name="TagContainer"
                                Orientation="Horizontal"
                                Visibility="Collapsed">
                    </StackPanel>


                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="1"
              x:Name="LoadingOverlay"
              Visibility="Collapsed"
              Background="Transparent"
              Tapped="OnLoadingOverlayTapped">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <ProgressRing x:Name="LoadingRing"
                              Height="40"
                              Width="40"
                              HorizontalAlignment="Center"/>
                <Image x:Name="LoadingFailedImage"
                       Source="ms-appx:///Assets/Loading_failed.png"
                       Width="80"
                       Height="80"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed"/>
                <TextBlock x:Name="LoadingHint"
                           FontSize="14"
                           Foreground="{ThemeResource AniMeidoMutedTextBrush}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="300"
                           TextAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
