<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.GlobalSearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AniMeido.Plugin.Base.Views"
    xmlns:controls="using:AniMeido.Plugin.Base.Views.Controls"
    xmlns:vm="using:AniMeido.Plugin.Base.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- 形态筛选标签：带已加载结果中的数量 -->
        <DataTemplate x:Key="FormatChipTemplate" x:DataType="vm:PastSeasonFormatChip">
            <ToggleButton Tag="{x:Bind}"
                          IsChecked="{x:Bind IsSelected}"
                          Click="OnFormatChipClick"
                          CornerRadius="14"
                          Padding="12,4"
                          AutomationProperties.Name="{x:Bind Label}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{x:Bind Label}"/>
                    <TextBlock Text="{x:Bind Count}" Opacity="0.7" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </ToggleButton>
        </DataTemplate>

        <!-- “我的番剧”里匹配的作品：横向排列的小卡 -->
        <DataTemplate x:Key="LocalMatchTemplate" x:DataType="vm:PastSeasonEntry">
            <Button Width="260"
                    Margin="0,0,10,0"
                    Padding="8"
                    HorizontalContentAlignment="Stretch"
                    Tag="{x:Bind}"
                    Click="OnLocalMatchClick"
                    AutomationProperties.Name="{x:Bind Anime.Title}">
                <Grid ColumnDefinitions="40,*" ColumnSpacing="10">
                    <Border Width="40" Height="54"
                            CornerRadius="4"
                            Background="{ThemeResource AniMeidoPlaceholderBackgroundBrush}">
                        <Image Stretch="UniformToFill"
                               Loaded="OnCoverLoaded"
                               DataContextChanged="OnCoverDataContextChanged"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{x:Bind Anime.Title}"
                                   FontWeight="SemiBold"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind vm:MineBrowse.StatusLabel(Status)}"
                                   FontSize="12"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ResultCardTemplate" x:DataType="vm:PastSeasonEntry">
            <controls:AnimeCard DataContext="{x:Bind Anime}"
                                TrackingStatus="{x:Bind Status}"
                                ShowMediaFormatBadge="True"
                                CardClicked="OnAnimeCardClicked"/>
        </DataTemplate>

        <DataTemplate x:Key="RecentChipTemplate" x:DataType="x:String">
            <Button Margin="0,0,6,0"
                    CornerRadius="14"
                    Padding="12,4"
                    Content="{x:Bind}"
                    Tag="{x:Bind}"
                    Click="OnRecentSearchClick"/>
        </DataTemplate>

        <DataTemplate x:Key="SavedTagChipTemplate" x:DataType="x:String">
            <Button Margin="0,0,6,0"
                    CornerRadius="14"
                    Padding="12,4"
                    Tag="{x:Bind}"
                    Click="OnSavedTagClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8EC;" FontSize="12"/>
                    <TextBlock Text="{x:Bind}"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <Style x:Key="SearchPanelStyle" TargetType="Border">
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid"
          Padding="24,20,24,0"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="12"
          Loaded="OnPageLoaded">
        <StackPanel Orientation="Horizontal" Spacing="14">
            <TextBlock Text="搜索" Style="{StaticResource AniMeidoPageTitleStyle}"/>
            <TextBlock Text="在 Bangumi 和你标记过的作品里查找"
                       Style="{StaticResource AniMeidoPageSubtitleStyle}"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,4"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource AniMeidoToolbarStyle}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <AutoSuggestBox x:Name="SearchBox"
                                QueryIcon="Find"
                                PlaceholderText="作品名或别名"
                                FontSize="15"
                                VerticalAlignment="Center"
                                QuerySubmitted="OnSearchQuerySubmitted"
                                TextChanged="OnSearchTextChanged"
                                AutomationProperties.Name="搜索作品"/>
                <Button Grid.Column="1"
                        Content="搜索"
                        Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Center"
                        Click="OnSearchClick"/>
            </Grid>
        </Border>

        <!-- 未搜索：最近搜索与收藏的标签 -->
        <ScrollViewer Grid.Row="2"
                      Padding="0,0,0,24"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{x:Bind ViewModel.IsLanding, Mode=OneWay}">
            <StackPanel Spacing="12">
                <Border Style="{StaticResource SearchPanelStyle}" Visibility="{x:Bind ViewModel.HasRecentSearches, Mode=OneWay}">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="10" ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE81C;" FontSize="14"/>
                            <TextBlock Text="最近搜索" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="清除记录" Click="OnClearRecentClick"/>
                        <ScrollViewer Grid.Row="1"
                                      Grid.ColumnSpan="2"
                                      HorizontalScrollMode="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.RecentSearches}" ItemTemplate="{StaticResource RecentChipTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SearchPanelStyle}" Visibility="{x:Bind ViewModel.HasSavedTags, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8EC;" FontSize="14"/>
                            <TextBlock Text="收藏的标签" FontWeight="SemiBold"/>
                            <TextBlock Text="在“我的番剧”中管理"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ScrollViewer HorizontalScrollMode="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SavedTags}" ItemTemplate="{StaticResource SavedTagChipTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,24,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource AniMeidoMutedTextBrush}"
                           Text="输入作品名开始搜索。你标记过的作品会先列出来。"
                           Visibility="{x:Bind local:GlobalSearchPage.NoLandingVisibility(ViewModel.HasLandingContent), Mode=OneWay}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 搜索后：我的番剧中的匹配、Bangumi 结果；页头随结果一起滚动 -->
        <GridView x:Name="ResultGrid"
                  Grid.Row="2"
                  Padding="0,0,0,24"
                  ItemsSource="{x:Bind ViewModel.Results}"
                  ItemTemplate="{StaticResource ResultCardTemplate}"
                  SelectionMode="None"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Visibility="{x:Bind ViewModel.HasSearched, Mode=OneWay}">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="UseSystemFocusVisuals" Value="False"/>
                    <Setter Property="IsTabStop" Value="False"/>
                    <Setter Property="Margin" Value="0,0,4,8"/>
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.Header>
                <StackPanel Spacing="12" Margin="0,0,0,8">
                    <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasLocalMatches, Mode=OneWay}">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                            <TextBlock Text="在我的番剧中" Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,2"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ViewModel.LocalSummary, Mode=OneWay}"/>
                            <Button Grid.Column="3"
                                    Content="在“我的番剧”中查看"
                                    Style="{StaticResource AniMeidoNavigateButtonStyle}"
                                    VerticalAlignment="Center"
                                    Click="OnOpenMineClick"/>
                        </Grid>
                        <ScrollViewer HorizontalScrollMode="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Disabled"
                                      Padding="0,0,0,6">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.LocalMatches}" ItemTemplate="{StaticResource LocalMatchTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Bangumi 结果" Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                        <TextBlock VerticalAlignment="Bottom"
                                   Margin="0,0,0,2"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"/>
                        <ProgressRing Width="16" Height="16"
                                      VerticalAlignment="Center"
                                      IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <ScrollViewer HorizontalScrollMode="Auto"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.FormatChips, Mode=OneWay}" ItemTemplate="{StaticResource FormatChipTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="排序"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="SortComboBox" MinWidth="110" AutomationProperties.Name="排序方式"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.IsError, Mode=OneWay}" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{ThemeResource AniMeidoMutedTextBrush}"/>
                        <Button Content="重试" HorizontalAlignment="Center" Click="OnRetryClick"/>
                    </StackPanel>

                    <TextBlock Margin="0,24,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource AniMeidoMutedTextBrush}"
                               Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.HasNoResults, Mode=OneWay}"/>
                </StackPanel>
            </GridView.Header>
            <GridView.Footer>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="10"
                            Margin="0,12,0,0">
                    <Button Content="加载更多"
                            Click="OnLoadMoreClick"
                            Visibility="{x:Bind ViewModel.CanLoadMore, Mode=OneWay}"
                            IsEnabled="{x:Bind local:GlobalSearchPage.NotLoadingMore(ViewModel.IsLoadingMore), Mode=OneWay}"/>
                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}"/>
                </StackPanel>
            </GridView.Footer>
        </GridView>

        <!-- 拖放覆盖层 -->
        <Canvas Grid.RowSpan="3"
                x:Name="DragOverlay"
                Visibility="Collapsed"
                Background="Transparent"
                AllowDrop="True"/>
    </Grid>
</Page>
