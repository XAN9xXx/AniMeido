<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AniMeido.Plugin.Base.Views.Controls.AnimeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AniMeido.Plugin.Base.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    CanDrag="True"
    AutomationProperties.Name="{Binding Title}"
    DragStarting="OnBodyDragStarting">

    <Grid Width="150"
          Margin="6">
        <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                BorderBrush="{ThemeResource ControlStrokeColorDefault}"
                BorderThickness="1"
                CornerRadius="10"
                Translation="0,0,32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 封面图片 + 重试加载环 -->
                <Grid Grid.Row="0"
                      Height="200">
                    <Border CornerRadius="10,10,0,0"
                            Height="200">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,150,200"/>
                        </Border.Clip>
                        <Image x:Name="CoverImage"
                               Height="200"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center"/>
                    </Border>
                    <!-- 封面重试加载环 -->
                    <Grid x:Name="RetryOverlay"
                          Visibility="Collapsed"
                          Background="{ThemeResource AniMeidoFailedOverlayBrush}">
                        <ProgressRing x:Name="RetryRing"
                                      Width="24"
                                      Height="24"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource SystemAccentColor}"/>
                        <Button x:Name="RetryButton"
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                ToolTipService.ToolTip="重新加载封面"
                                PointerPressed="OnRetryCoverPointerPressed"
                                Click="OnRetryCoverClick">
                            <FontIcon Glyph="&#xE72C;"/>
                        </Button>
                    </Grid>
                </Grid>

                <!-- 星期放送角标（补番页使用，默认隐藏） -->
                <Border x:Name="WeekdayBadge"
                        Background="{ThemeResource SystemAccentColor}"
                        CornerRadius="0,0,10,0"
                        Padding="8,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Visibility="Collapsed">
                    <TextBlock x:Name="WeekdayBadgeText"
                               Text=""
                               Foreground="{ThemeResource AniMeidoBadgeTextBrush}"
                               FontSize="12"
                               FontWeight="Bold"/>
                </Border>

                <!-- 动画形态角标（番剧库使用，默认隐藏） -->
                <Border x:Name="MediaFormatBadge"
                        Background="{ThemeResource SystemAccentColor}"
                        CornerRadius="0,0,10,0"
                        Padding="8,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Visibility="Collapsed">
                    <TextBlock x:Name="MediaFormatBadgeText"
                               Foreground="{ThemeResource AniMeidoBadgeTextBrush}"
                               FontSize="12"
                               FontWeight="Bold"/>
                </Border>

                <!-- 评分角标（封面右下角） -->
                <Border x:Name="ScoreBadge"
                        Background="{ThemeResource SystemAccentColor}"
                        CornerRadius="10,0,0,0"
                        Padding="6,3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ScoreText"
                               Foreground="{ThemeResource AniMeidoBadgeTextBrush}"
                               FontSize="12"
                               FontWeight="Bold"/>
                </Border>

                <!-- 追番状态标签（放送日历使用，默认隐藏） -->
                <Border x:Name="WatchingBadge"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="9"
                        Padding="7,1"
                        Margin="6"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Visibility="Collapsed">
                    <TextBlock Text="追番中"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                </Border>
                <Border x:Name="FollowingBadge"
                        Background="{ThemeResource AniMeidoFollowingColorBrush}"
                        CornerRadius="9"
                        Padding="7,1"
                        Margin="6"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Visibility="Collapsed">
                    <TextBlock Text="关注中"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#2A1D00"/>
                </Border>
                <Border x:Name="OtherStatusBadge"
                        Background="#A6000000"
                        CornerRadius="9"
                        Padding="7,1"
                        Margin="6"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Visibility="Collapsed">
                    <TextBlock x:Name="OtherStatusBadgeText"
                               FontSize="12"
                               Foreground="White"/>
                </Border>

                <!-- 放送星期（放送日历搜索结果使用，默认隐藏） -->
                <Border x:Name="WeekdayTextBadge"
                        Background="#A6000000"
                        CornerRadius="9"
                        Padding="7,1"
                        Margin="6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Visibility="Collapsed">
                    <TextBlock x:Name="WeekdayTextBadgeText"
                               FontSize="12"
                               Foreground="White"/>
                </Border>

                <!-- 悬停标记按钮（放送日历使用，默认隐藏）。按钮自己处理点击，不会触发卡片单击 -->
                <Grid x:Name="QuickActions"
                      Height="200"
                      VerticalAlignment="Top"
                      Visibility="Collapsed">
                    <Grid VerticalAlignment="Bottom"
                          Padding="6,28,6,6"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="4">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#D9000000" Offset="0.55"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Button x:Name="WatchActionButton"
                                Content="追番"
                                Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.Name="切换追番状态"
                                HorizontalAlignment="Stretch"
                                Padding="0,3"
                                FontSize="12"
                                Click="OnWatchActionClick"/>
                        <Button x:Name="FollowActionButton"
                                Grid.Column="1"
                                Content="关注"
                                AutomationProperties.Name="切换关注状态"
                                HorizontalAlignment="Stretch"
                                Padding="0,3"
                                FontSize="12"
                                Click="OnFollowActionClick"/>
                    </Grid>
                </Grid>

                <!-- 文字信息 -->
                <StackPanel Grid.Row="1"
                            Padding="10,8">
                    <TextBlock Text="{Binding Title}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="2"
                               Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding AirDate}"
                               FontSize="12"
                               Foreground="{ThemeResource AniMeidoMutedTextBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>


