<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.ManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AniMeido.Plugin.Base.Views"
    xmlns:controls="using:AniMeido.Plugin.Base.Views.Controls"
    xmlns:vm="using:AniMeido.Plugin.Base.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="OnPageLoaded">

    <Page.Resources>
        <!-- 左侧导航项：沿用共用的轻量按钮（悬停出浅底），改为正文色、铺满整行；选中底色由内容里的 Border 显示 -->
        <Style x:Key="MineNavButtonStyle" TargetType="Button" BasedOn="{StaticResource AniMeidoSubtleButtonStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <DataTemplate x:Key="StatusNavTemplate" x:DataType="vm:TrackingStatusSection">
            <Button Style="{StaticResource MineNavButtonStyle}"
                    Tag="{x:Bind}"
                    Click="OnStatusNavClick"
                    AutomationProperties.Name="{x:Bind Label}">
                <Grid Height="36">
                    <Border CornerRadius="4"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            Visibility="{x:Bind IsSelected, Mode=OneWay}"/>
                    <Border Width="3" Height="16"
                            HorizontalAlignment="Left"
                            CornerRadius="2"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Visibility="{x:Bind IsSelected, Mode=OneWay}"/>
                    <Grid Padding="12,0" ColumnDefinitions="22,*,Auto" ColumnSpacing="8">
                        <FontIcon FontSize="15" Glyph="{x:Bind Glyph}"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Label}"/>
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind Count, Mode=OneWay}"/>
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- 列表行：封面、标题、开播与评分、标记时间；右侧状态按钮可直接改状态 -->
        <DataTemplate x:Key="MineRowTemplate" x:DataType="vm:MineEntry">
            <Grid Padding="8"
                  Margin="0,0,0,6"
                  ColumnDefinitions="44,*,Auto"
                  ColumnSpacing="12"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
                <Border Width="44" Height="60"
                        CornerRadius="4"
                        Background="{ThemeResource AniMeidoPlaceholderBackgroundBrush}">
                    <Image Stretch="UniformToFill"
                           Loaded="OnManagedCoverLoaded"
                           DataContextChanged="OnManagedCoverDataContextChanged"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="{x:Bind Anime.Title}"
                               FontWeight="SemiBold"
                               MaxLines="1"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{x:Bind MetaText}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               MaxLines="1"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{x:Bind MarkedText}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{x:Bind MyRatingText}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind HasMyRating}"/>
                    </StackPanel>
                </StackPanel>
                <DropDownButton Grid.Column="2"
                                VerticalAlignment="Center"
                                Content="{x:Bind StatusLabel}"
                                Tag="{x:Bind}"
                                AutomationProperties.Name="修改状态">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="OnRowStatusMenuOpening"/>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MineCardTemplate" x:DataType="vm:MineEntry">
            <controls:AnimeCard DataContext="{x:Bind Anime}"
                                TrackingStatus="{x:Bind Status}"
                                ShowMediaFormatBadge="True"
                                CardClicked="OnAnimeCardClicked"/>
        </DataTemplate>

        <DataTemplate x:Key="TagCardTemplate" x:DataType="vm:PastSeasonEntry">
            <controls:AnimeCard DataContext="{x:Bind Anime}"
                                TrackingStatus="{x:Bind Status}"
                                ShowMediaFormatBadge="True"
                                CardClicked="OnAnimeCardClicked"/>
        </DataTemplate>

        <!-- 收藏的标签：点标签看作品，× 取消收藏 -->
        <DataTemplate x:Key="TagChipTemplate" x:DataType="vm:TagItem">
            <Grid Margin="0,0,6,6"
                  CornerRadius="14"
                  BorderThickness="1"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  Background="{ThemeResource ControlFillColorDefaultBrush}"
                  Tapped="OnTagChipTapped"
                  Tag="{x:Bind TagName}">
                <Border CornerRadius="14"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Opacity="0.18"
                        Visibility="{x:Bind IsSelected}"/>
                <StackPanel Orientation="Horizontal" Spacing="4" Padding="12,4,4,4">
                    <TextBlock VerticalAlignment="Center" FontSize="13" Text="{x:Bind TagName}"/>
                    <Button Width="22" Height="22"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Tag="{x:Bind TagName}"
                            Click="OnRemoveTagClick"
                            ToolTipService.ToolTip="取消收藏"
                            AutomationProperties.Name="取消收藏">
                        <FontIcon FontSize="9" Glyph="&#xE711;" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,20,24,0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="14">
            <TextBlock Text="我的番剧" Style="{StaticResource AniMeidoPageTitleStyle}"/>
            <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
                       Style="{StaticResource AniMeidoPageSubtitleStyle}"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,4"/>
        </StackPanel>

        <InfoBar x:Name="ErrorInfoBar"
                 Grid.Row="1"
                 IsClosable="True"
                 Closed="OnErrorInfoBarClosed"
                 IsOpen="{x:Bind ViewModel.IsError, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 Severity="Error"/>

        <!-- 工具栏：跨状态搜索、排序、列表／网格、批量选择 -->
        <Border Grid.Row="2" Style="{StaticResource AniMeidoToolbarStyle}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <AutoSuggestBox x:Name="SearchBox"
                                MaxWidth="480"
                                HorizontalAlignment="Left"
                                MinWidth="260"
                                QueryIcon="Find"
                                PlaceholderText="在我的番剧里搜索（所有状态）"
                                VerticalAlignment="Center"
                                QuerySubmitted="OnSearchQuerySubmitted"
                                TextChanged="OnSearchTextChanged"
                                AutomationProperties.Name="在我的番剧里搜索"/>
                <StackPanel x:Name="ViewTools"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.IsStatusOrSearchView, Mode=OneWay}">
                    <TextBlock Text="排序"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ComboBox x:Name="SortComboBox" MinWidth="120" VerticalAlignment="Center" AutomationProperties.Name="排序方式"/>
                    <ToggleButton x:Name="ListLayoutButton"
                                  IsChecked="True"
                                  Padding="8,7"
                                  Click="OnLayoutClick"
                                  ToolTipService.ToolTip="列表"
                                  AutomationProperties.Name="列表视图">
                        <FontIcon Glyph="&#xE8FD;" FontSize="14"/>
                    </ToggleButton>
                    <ToggleButton x:Name="GridLayoutButton"
                                  Padding="8,7"
                                  Click="OnLayoutClick"
                                  ToolTipService.ToolTip="网格"
                                  AutomationProperties.Name="网格视图">
                        <FontIcon Glyph="&#xF0E2;" FontSize="14"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BatchButton" Click="OnBatchClick" AutomationProperties.Name="批量选择">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE762;" FontSize="14"/>
                            <TextBlock x:Name="BatchButtonText" Text="批量选择"/>
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="216,*" ColumnSpacing="16">
            <!-- 左侧：五个常用状态平铺，“不想看到”折叠，最后是收藏的标签 -->
            <ScrollViewer Padding="0,0,4,24" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="2">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.MainSections}" ItemTemplate="{StaticResource StatusNavTemplate}"/>
                    <Button x:Name="HiddenToggle"
                            Margin="0,10,0,0"
                            Style="{StaticResource MineNavButtonStyle}"
                            Click="OnHiddenToggleClick"
                            AutomationProperties.Name="不想看到">
                        <Grid Height="32" Padding="12,0" ColumnDefinitions="*,Auto">
                            <TextBlock Text="不想看到"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <FontIcon x:Name="HiddenChevron"
                                      Grid.Column="1"
                                      FontSize="10"
                                      Glyph="&#xE70D;"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </Button>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.HiddenSections}"
                                  ItemTemplate="{StaticResource StatusNavTemplate}"
                                  Visibility="{x:Bind ViewModel.IsHiddenExpanded, Mode=OneWay}"/>
                    <Border Height="1" Margin="8,10" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                    <Button x:Name="TagsNavButton"
                            Style="{StaticResource MineNavButtonStyle}"
                            Click="OnTagsNavClick"
                            AutomationProperties.Name="收藏的标签">
                        <Grid Height="36">
                            <Border CornerRadius="4"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Visibility="{x:Bind ViewModel.IsTagsView, Mode=OneWay}"/>
                            <Border Width="3" Height="16"
                                    HorizontalAlignment="Left"
                                    CornerRadius="2"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="{x:Bind ViewModel.IsTagsView, Mode=OneWay}"/>
                            <Grid Padding="12,0" ColumnDefinitions="22,*,Auto" ColumnSpacing="8">
                                <FontIcon FontSize="15" Glyph="&#xE8EC;"/>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="收藏的标签"/>
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{x:Bind ViewModel.TagCount, Mode=OneWay}"/>
                            </Grid>
                        </Grid>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- 右侧：标题、批量操作栏、列表或网格；标签视图另用一块 -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                    <TextBlock Text="{x:Bind ViewModel.HeaderText, Mode=OneWay}" Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                    <ProgressRing Width="16" Height="16"
                                  VerticalAlignment="Center"
                                  IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
                </StackPanel>

                <Border x:Name="BatchBar"
                        Grid.Row="1"
                        Margin="0,0,8,10"
                        Padding="12,8"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        Visibility="Collapsed">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock x:Name="BatchCountText" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="全选" Click="OnSelectAllClick"/>
                            <DropDownButton x:Name="BatchMoveButton" Content="移到…" AutomationProperties.Name="批量移到其他状态">
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="OnBatchMenuOpening"/>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button x:Name="BatchRemoveButton" Content="取消标记" Click="OnBatchRemoveClick"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ListView x:Name="MineList"
                          Grid.Row="2"
                          Padding="0,0,8,24"
                          ItemsSource="{x:Bind ViewModel.Entries}"
                          ItemTemplate="{StaticResource MineRowTemplate}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="OnMineItemClick"
                          SelectionChanged="OnMineSelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <GridView x:Name="MineGrid"
                          Grid.Row="2"
                          Padding="0,0,0,24"
                          ItemsSource="{x:Bind ViewModel.Entries}"
                          ItemTemplate="{StaticResource MineCardTemplate}"
                          SelectionMode="None"
                          Visibility="Collapsed">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="UseSystemFocusVisuals" Value="False"/>
                            <Setter Property="IsTabStop" Value="False"/>
                            <Setter Property="Margin" Value="0,0,4,8"/>
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>

                <TextBlock Grid.Row="2"
                           Margin="0,24,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Foreground="{ThemeResource AniMeidoMutedTextBrush}"
                           Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                           Visibility="{x:Bind local:ManagementPage.EmptyVisibility(ViewModel.HasNoEntries, ViewModel.IsLoading, ViewModel.IsStatusOrSearchView), Mode=OneWay}"/>

                <Grid x:Name="TagsPanel"
                      Grid.Row="1"
                      Grid.RowSpan="2"
                      RowDefinitions="Auto,Auto,*"
                      Visibility="{x:Bind ViewModel.IsTagsView, Mode=OneWay}">
                    <!-- 标签宽度不一，放不下时横向滚动 -->
                    <ScrollViewer Margin="0,0,8,0"
                                  HorizontalScrollMode="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.TagList}" ItemTemplate="{StaticResource TagChipTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource AniMeidoMutedTextBrush}"
                               Text="还没有收藏的标签。在作品详情页右键点击标签即可收藏。"
                               Visibility="{x:Bind local:ManagementPage.NoTagsVisibility(ViewModel.HasTags), Mode=OneWay}"/>
                    <Grid Grid.Row="1" Margin="0,6,8,10" ColumnDefinitions="*,Auto" Visibility="{x:Bind ViewModel.HasTags, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ViewModel.TagResultSummary, Mode=OneWay}"/>
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsTagLoading, Mode=OneWay}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="在标签页中打开"
                                Style="{StaticResource AniMeidoNavigateButtonStyle}"
                                VerticalAlignment="Center"
                                Click="OnOpenTagPageClick"/>
                    </Grid>
                    <GridView Grid.Row="2"
                              Padding="0,0,0,24"
                              ItemsSource="{x:Bind ViewModel.TagEntries}"
                              ItemTemplate="{StaticResource TagCardTemplate}"
                              SelectionMode="None">
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="UseSystemFocusVisuals" Value="False"/>
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter Property="Margin" Value="0,0,4,8"/>
                            </Style>
                        </GridView.ItemContainerStyle>
                    </GridView>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
