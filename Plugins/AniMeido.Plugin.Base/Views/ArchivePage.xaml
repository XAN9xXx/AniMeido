<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.Plugin.Base.Views.ArchivePage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <MenuFlyout x:Key="ScreenshotMoreActionsFlyout">
            <MenuFlyoutItem Text="移入回收站"
                            Click="OnDeleteScreenshotClick"/>
            <MenuFlyoutItem Text="清理缺失记录"
                            Click="OnCleanupScreenshotsClick"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="截图设置"
                            Click="OnScreenshotSettingsClick"/>
        </MenuFlyout>
    </Page.Resources>

    <Grid Padding="24,20,24,24"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto"
              VerticalAlignment="Center">
            <StackPanel Spacing="2">
                <TextBlock Text="个人动画档案馆"
                           Style="{StaticResource AniMeidoPageTitleStyle}"/>
                <TextBlock Text="整理评分、笔记、观看记忆与截图"
                           Style="{StaticResource AniMeidoPageSubtitleStyle}"/>
            </StackPanel>
            <Button Grid.Column="1"
                    ToolTipService.ToolTip="刷新档案数据"
                    Click="OnRefreshClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                    <TextBlock Text="刷新"/>
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar x:Name="StatusInfoBar"
                 Grid.Row="1"
                 IsClosable="True"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="4">
            <ToggleButton x:Name="ArchivesSectionButton"
                          Tag="archives"
                          Style="{StaticResource AniMeidoSectionTabStyle}"
                          Click="OnSectionButtonClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8F1;" FontSize="15"/>
                    <TextBlock Text="番剧档案"/>
                </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="StatisticsSectionButton"
                          Tag="statistics"
                          Style="{StaticResource AniMeidoSectionTabStyle}"
                          Click="OnSectionButtonClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE9D2;" FontSize="15"/>
                    <TextBlock Text="统计"/>
                </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="ReviewSectionButton"
                          Tag="review"
                          Style="{StaticResource AniMeidoSectionTabStyle}"
                          Click="OnSectionButtonClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE787;" FontSize="15"/>
                    <TextBlock Text="年度回顾"/>
                </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="ScreenshotsSectionButton"
                          Tag="screenshots"
                          Style="{StaticResource AniMeidoSectionTabStyle}"
                          Click="OnSectionButtonClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE722;" FontSize="15"/>
                    <TextBlock Text="截图"/>
                </StackPanel>
            </ToggleButton>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid x:Name="ArchivesPanel" ColumnDefinitions="390,*" ColumnSpacing="18">
                <Border Style="{StaticResource AniMeidoCardStyle}">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                        <StackPanel Spacing="8">
                            <TextBox x:Name="ArchiveFilter" PlaceholderText="搜索标题或个人标签"
                                     TextChanged="OnArchiveFilterChanged"/>
                            <Expander Header="筛选档案">
                                <StackPanel Spacing="10" Padding="0,8,0,4">
                                    <ComboBox x:Name="StatusFilter" Header="追番状态"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="OnArchiveOptionChanged">
                                        <x:String>全部状态</x:String><x:String>追番中</x:String>
                                        <x:String>补番中</x:String><x:String>不感兴趣</x:String>
                                        <x:String>关注</x:String><x:String>已看完</x:String>
                                        <x:String>弃坑</x:String>
                                    </ComboBox>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <NumberBox x:Name="MinimumRatingFilter" Header="最低评分"
                                                   Minimum="0.5" Maximum="10" SmallChange="0.5"
                                                   ValueChanged="OnArchiveNumberFilterChanged"/>
                                        <NumberBox x:Name="ArchiveYearFilter" Grid.Column="1"
                                                   Header="建档年份" Minimum="2000" Maximum="2100"
                                                   ValueChanged="OnArchiveNumberFilterChanged"/>
                                    </Grid>
                                    <Button Content="清除筛选" HorizontalAlignment="Left"
                                            Click="OnClearArchiveFiltersClick"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                            <TextBlock Text="我的档案" FontWeight="SemiBold" FontSize="18"/>
                            <TextBlock x:Name="ArchiveResultCount" Grid.Column="1"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                        <Grid Grid.Row="2">
                            <ListView x:Name="ArchiveList" SelectionMode="Single"
                                      SelectionChanged="OnArchiveSelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="3,7" ColumnDefinitions="62,*,Auto" ColumnSpacing="12"
                                              MinHeight="88">
                                            <Border CornerRadius="6"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                <Image Width="62" Height="82" Stretch="UniformToFill"
                                                       Loaded="OnArchiveCoverLoaded"
                                                       DataContextChanged="OnArchiveCoverDataContextChanged"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding TagSummary}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Text="{Binding RatingText}" FontSize="12"
                                                           Foreground="{ThemeResource AniMeidoAccentBrush}"/>
                                                <TextBlock Text="{Binding EntryCountText}" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel x:Name="ArchiveListEmptyState" Visibility="Collapsed"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <FontIcon Glyph="&#xE11A;" Style="{StaticResource AniMeidoEmptyStateIconStyle}"/>
                                <TextBlock Text="没有符合条件的档案" FontWeight="SemiBold"/>
                                <TextBlock Text="尝试清除筛选，或先在番剧详情中建立档案"
                                           MaxWidth="260" TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <Grid Grid.Column="1">
                    <Border x:Name="ArchiveSelectionEmptyState"
                            Style="{StaticResource AniMeidoCardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" Style="{StaticResource AniMeidoEmptyStateIconStyle}"/>
                            <TextBlock Text="选择一部番剧开始整理"
                                       Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                            <TextBlock Text="在左侧选择作品，查看笔记、感想和时间线。"
                                       MaxWidth="440" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer x:Name="ArchiveDetailPanel" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" Padding="0,0,4,4">
                            <Border Style="{StaticResource AniMeidoCardStyle}">
                                <Grid ColumnDefinitions="150,*,Auto" ColumnSpacing="18">
                                    <Border CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <Image x:Name="ArchiveHeroCover" Width="150" Height="210"
                                               Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                        <TextBlock x:Name="ArchiveTitle"
                                                   Style="{StaticResource AniMeidoSectionTitleStyle}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="ArchiveAnimeMetadata"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock x:Name="ArchiveRatingText"
                                                       Foreground="{ThemeResource AniMeidoAccentBrush}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock x:Name="ArchiveStatusText"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ArchiveTagsText" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="编辑档案" VerticalAlignment="Top"
                                            Click="OnEditArchiveClick"/>
                                </Grid>
                            </Border>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                <Border Style="{StaticResource AniMeidoCardStyle}">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="作品笔记"
                                                           Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                                                <TextBlock Text="一部作品一份长期笔记 · 支持 Markdown"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="编辑" Click="OnEditNoteClick"/>
                                        </Grid>
                                        <Border Padding="20" CornerRadius="8"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                            <RichTextBlock x:Name="ArchiveNotePreview" TextWrapping="Wrap"
                                                           FontFamily="Microsoft YaHei UI" FontSize="16"
                                                           LineHeight="27" MinHeight="180"/>
                                        </Border>
                                        <StackPanel x:Name="ArchiveScreenshotSection"
                                                    Visibility="Collapsed" Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="相关截图"
                                                           Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                                                <TextBlock x:Name="ArchiveScreenshotCount" Grid.Column="1"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Grid>
                                            <ItemsControl x:Name="ArchiveScreenshotStrip">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="8"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="180" Height="104" CornerRadius="5"
                                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                        <Image Stretch="UniformToFill"
                                                               Loaded="OnScreenshotImageLoaded"
                                                               DataContextChanged="OnScreenshotImageDataContextChanged"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource AniMeidoCardStyle}">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock x:Name="ArchiveTimelineTitle"
                                                       Text="观看时间线"
                                                       Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                                            <Button Grid.Column="1" Content="写感想"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Click="OnAddEntryClick"/>
                                        </Grid>
                                        <ComboBox x:Name="ArchiveTimelineFilter" Header="显示"
                                                  SelectionChanged="OnTimelineFilterChanged">
                                            <x:String>全部</x:String><x:String>感想</x:String>
                                            <ComboBoxItem x:Name="WatchHistoryFilterItem"
                                                          Content="观看记录"/>
                                            <x:String>状态变更</x:String>
                                        </ComboBox>
                                        <ListView x:Name="EntryList" MinHeight="220" MaxHeight="540"
                                                  SelectionMode="Single"
                                                  SelectionChanged="OnEntrySelectionChanged">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Padding="4,0" ColumnDefinitions="14,*" ColumnSpacing="12"
                                                          MinHeight="90">
                                                        <Border Width="2" HorizontalAlignment="Center"
                                                                Margin="0,-2,0,-2"
                                                                Background="{ThemeResource AniMeidoAccentBrush}"/>
                                                        <Ellipse Width="10" Height="10" VerticalAlignment="Top"
                                                                 Margin="0,12,0,0"
                                                                 Fill="{ThemeResource AniMeidoAccentBrush}"/>
                                                        <StackPanel Grid.Column="1" Spacing="4"
                                                                    Margin="0,10,0,12">
                                                            <TextBlock Text="{Binding DisplayTime}" FontSize="12"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding Kind}" FontSize="12"
                                                                       Foreground="{ThemeResource AniMeidoAccentBrush}"/>
                                                            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Body}" TextWrapping="Wrap"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                            <Button x:Name="EditEntryButton" Content="编辑所选感想"
                                                    IsEnabled="False" Click="OnEditEntryClick"/>
                                            <Button x:Name="DeleteEntryButton" Content="删除所选"
                                                    IsEnabled="False" Click="OnDeleteEntryClick"/>
                                            <Button x:Name="AddManualWatchButton"
                                                    Content="补录观看"
                                                    Click="OnAddManualEventClick"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
            <ScrollViewer x:Name="StatisticsPanel" Visibility="Collapsed">
                <StackPanel Spacing="16" Padding="0,0,4,4">
                    <Border Style="{StaticResource AniMeidoCardStyle}">
                        <StackPanel Spacing="20">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="个人统计"
                                               Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                                    <TextBlock Text="档案、笔记、标签与观看汇总"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="StatisticsStartText"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                            <Grid ColumnDefinitions="*,1,*,1,*,1,*" ColumnSpacing="16">
                                <StackPanel Spacing="7">
                                    <FontIcon Glyph="&#xE8F1;" FontSize="22"
                                              HorizontalAlignment="Left"
                                              Foreground="{ThemeResource AniMeidoAccentBrush}"/>
                                    <TextBlock Text="档案"/>
                                    <TextBlock x:Name="StatisticsArchiveCountText"
                                               FontSize="32" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AniMeidoAccentBrush}"/>
                                </StackPanel>
                                <Rectangle Grid.Column="1" Width="1"
                                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                <StackPanel Grid.Column="2" Spacing="7">
                                    <FontIcon Glyph="&#xE734;" FontSize="22"
                                              HorizontalAlignment="Left"
                                              Foreground="{ThemeResource AniMeidoAccentBrush}"/>
                                    <TextBlock Text="已评分"/>
                                    <TextBlock x:Name="StatisticsRatedCountText"
                                               FontSize="32" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AniMeidoAccentBrush}"/>
                                </StackPanel>
                                <Rectangle Grid.Column="3" Width="1"
                                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                <StackPanel Grid.Column="4" Spacing="7">
                                    <FontIcon Glyph="&#xE70B;" FontSize="22"
                                              HorizontalAlignment="Left"
                                              Foreground="{ThemeResource AniMeidoAccentBrush}"/>
                                    <TextBlock Text="观看感想"/>
                                    <TextBlock x:Name="StatisticsEntryCountText"
                                               FontSize="32" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AniMeidoAccentBrush}"/>
                                </StackPanel>
                                <Rectangle Grid.Column="5" Width="1"
                                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                <StackPanel Grid.Column="6" Spacing="7">
                                    <FontIcon Glyph="&#xE722;" FontSize="22"
                                              HorizontalAlignment="Left"
                                              Foreground="{ThemeResource AniMeidoAccentBrush}"/>
                                    <TextBlock Text="截图记录"/>
                                    <TextBlock x:Name="StatisticsScreenshotCountText"
                                               FontSize="32" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AniMeidoAccentBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="1.3*,*" ColumnSpacing="16">
                        <Border x:Name="StatisticsTagsCard"
                                Style="{StaticResource AniMeidoCardStyle}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="常用个人标签"
                                               Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                                    <TextBlock Text="按带有该标签的档案数量统计"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="StatisticsTagsEmpty"
                                           Text="还没有个人标签"
                                           Visibility="Collapsed"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ItemsControl x:Name="StatisticsTagList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="92,*,36"
                                                  ColumnSpacing="10" Margin="0,5">
                                                <TextBlock Text="{Binding Name}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <ProgressBar Grid.Column="1" Maximum="100"
                                                             Value="{Binding Percent}"
                                                             Height="16" VerticalAlignment="Center"
                                                             Foreground="{ThemeResource AniMeidoAccentBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Count}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border x:Name="StatisticsWatchCard" Grid.Column="1"
                                Style="{StaticResource AniMeidoCardStyle}">
                            <StackPanel Spacing="15">
                                <TextBlock Text="观看记录汇总"
                                           Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                                <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                                    <FontIcon Glyph="&#xE768;" FontSize="27"
                                              Foreground="{ThemeResource AniMeidoAccentBrush}"/>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="已记录完成集数"/>
                                        <TextBlock x:Name="StatisticsCompletedText"
                                                   FontSize="30" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AniMeidoAccentBrush}"/>
                                    </StackPanel>
                                </Grid>
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                                    <FontIcon Glyph="&#xE823;" FontSize="27"
                                              Foreground="{ThemeResource AniMeidoAccentBrush}"/>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="估算观看时长"/>
                                        <TextBlock x:Name="StatisticsDurationText"
                                                   FontSize="28" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AniMeidoAccentBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource AniMeidoCardStyle}">
                        <Grid ColumnDefinitions="*,220" ColumnSpacing="28">
                            <StackPanel Spacing="10">
                                <TextBlock Text="记录完整度"
                                           Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                                <TextBlock Text="已评分档案占全部档案的比例"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                    <ProgressBar x:Name="StatisticsCoverageBar"
                                                 Maximum="100" Height="16"
                                                 VerticalAlignment="Center"
                                                 Foreground="{ThemeResource AniMeidoAccentBrush}"/>
                                    <TextBlock x:Name="StatisticsCoveragePercentText"
                                               Grid.Column="1"
                                               Foreground="{ThemeResource AniMeidoAccentBrush}"
                                               FontWeight="SemiBold"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock x:Name="StatisticsCoverageText"/>
                                    <TextBlock x:Name="StatisticsUnratedText"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="状态变化"/>
                                <TextBlock x:Name="StatisticsStatusChangesText"
                                           FontSize="30" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AniMeidoAccentBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ReviewPanel" Visibility="Collapsed">
                <StackPanel Spacing="16" Padding="0,0,4,4">
                    <Border Style="{StaticResource AniMeidoCardStyle}">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="Auto,Auto,160,Auto,*,Auto"
                                  ColumnSpacing="10">
                                <TextBlock Text="年度回顾"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                                <Button Grid.Column="1" Content="‹" Click="OnReviewPreviousYearClick"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="上一年"/>
                                <NumberBox x:Name="ReviewYear" Grid.Column="2"
                                           Minimum="2000" Maximum="2100"
                                           SpinButtonPlacementMode="Hidden"
                                           VerticalAlignment="Center"
                                           ValueChanged="OnReviewYearChanged"/>
                                <Button Grid.Column="3" Content="›" Click="OnReviewNextYearClick"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="下一年"/>
                                <Button Grid.Column="5" Content="导出 HTML"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="OnExportReviewClick"/>
                            </Grid>
                            <Rectangle Height="1"
                                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                            <Grid ColumnDefinitions="1.4*,*" ColumnSpacing="20">
                                <StackPanel Spacing="7" VerticalAlignment="Center">
                                    <TextBlock x:Name="ReviewHeroYear"
                                               FontSize="60" FontWeight="Bold"
                                               Foreground="{ThemeResource AniMeidoAccentBrush}"/>
                                    <TextBlock x:Name="ReviewYearState"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="ReviewRecordingStart"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <Grid Grid.Column="1" MinHeight="160">
                                    <TextBlock x:Name="ReviewCoversEmpty"
                                               Text="这一年还没有新增档案"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <ItemsControl x:Name="ReviewCovers">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal"
                                                               HorizontalAlignment="Right"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="102" Height="150" CornerRadius="7"
                                                        Margin="0,0,8,8"
                                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                        ToolTipService.ToolTip="{Binding Title}">
                                                    <Image Stretch="UniformToFill"
                                                           Loaded="OnReviewCoverLoaded"
                                                           DataContextChanged="OnReviewCoverDataContextChanged"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Grid>
                            <Rectangle Height="1"
                                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                            <Grid x:Name="ReviewStatsGrid"
                                  ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="新增档案"/>
                                    <TextBlock x:Name="ReviewArchiveCount" FontSize="29"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource AniMeidoAccentBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="写下感想"/>
                                    <TextBlock x:Name="ReviewEntryCount" FontSize="29"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource AniMeidoAccentBrush}"/>
                                </StackPanel>
                                <StackPanel x:Name="ReviewScreenshotStat"
                                            Grid.Column="2" Spacing="4">
                                    <TextBlock Text="截图记录"/>
                                    <TextBlock x:Name="ReviewScreenshotCount" FontSize="29"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource AniMeidoAccentBrush}"/>
                                </StackPanel>
                                <StackPanel x:Name="ReviewWatchStat"
                                            Grid.Column="3" Spacing="4">
                                    <TextBlock Text="估算观看时长"/>
                                    <TextBlock x:Name="ReviewWatchDuration" FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource AniMeidoAccentBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Grid ColumnDefinitions="1.1*,*" ColumnSpacing="16">
                        <Border x:Name="ReviewMomentsCard"
                                Style="{StaticResource AniMeidoCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="这一年留下的片段"
                                           Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                                <TextBlock x:Name="ReviewMomentsEmpty"
                                           Text="这一年还没有写下感想"
                                           Visibility="Collapsed"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ItemsControl x:Name="ReviewMoments">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="14,66,*" ColumnSpacing="10"
                                                  MinHeight="94">
                                                <Border Width="2" HorizontalAlignment="Center"
                                                        Margin="0,-4,0,-4"
                                                        Background="{ThemeResource AniMeidoAccentBrush}"/>
                                                <Ellipse Width="10" Height="10"
                                                         VerticalAlignment="Top" Margin="0,10,0,0"
                                                         Fill="{ThemeResource AniMeidoAccentBrush}"/>
                                                <Border Grid.Column="1" Width="60" Height="78"
                                                        CornerRadius="5"
                                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                    <Image Stretch="UniformToFill"
                                                           Loaded="OnReviewCoverLoaded"
                                                           DataContextChanged="OnReviewCoverDataContextChanged"/>
                                                </Border>
                                                <StackPanel Grid.Column="2" Spacing="3">
                                                    <TextBlock Text="{Binding DateText}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding AnimeTitle}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Preview}"
                                                               MaxLines="2" TextWrapping="WrapWholeWords"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border x:Name="ReviewScreenshotsCard" Grid.Column="1"
                                Style="{StaticResource AniMeidoCardStyle}">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="镜头里的回忆"
                                               Style="{StaticResource AniMeidoSectionTitleStyle}"/>
                                    <Button Grid.Column="1" Content="查看更多截图 ›"
                                            Click="OnReviewMoreScreenshotsClick"/>
                                </Grid>
                                <TextBlock x:Name="ReviewScreenshotsEmpty"
                                           Text="这一年还没有截图"
                                           Visibility="Collapsed"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ItemsControl x:Name="ReviewScreenshots">
                                    <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="220" Spacing="4"
                                                        Margin="0,0,10,10">
                                                <Border Height="120" CornerRadius="6"
                                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                    <Image Stretch="UniformToFill"
                                                           Loaded="OnScreenshotImageLoaded"
                                                           DataContextChanged="OnScreenshotImageDataContextChanged"/>
                                                </Border>
                                                <TextBlock Text="{Binding ReviewTitle}"
                                                           TextTrimming="CharacterEllipsis"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ReviewCaption}"
                                                           MaxLines="2" TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="ScreenshotsPanel"
                  Visibility="Collapsed"
                  RowDefinitions="Auto,*"
                  RowSpacing="12">
                <Border Style="{StaticResource AniMeidoCardStyle}">
                    <Grid ColumnDefinitions="*,150,Auto" ColumnSpacing="8">
                        <TextBox x:Name="ScreenshotFilter"
                                 PlaceholderText="搜索番剧、场合、进程或标签"
                                 TextChanged="OnScreenshotFilterChanged"/>
                        <NumberBox x:Name="ScreenshotYearFilter"
                                   Grid.Column="1"
                                   PlaceholderText="年份"
                                   Minimum="2000"
                                   Maximum="2100"
                                   ValueChanged="OnScreenshotYearFilterChanged"/>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8">
                            <Button Content="打开"
                                    Click="OnOpenScreenshotClick"/>
                            <Button Content="编辑"
                                    Click="OnEditScreenshotClick"/>
                            <Button Content="加标签"
                                    Click="OnTagScreenshotsClick"/>
                            <Button Content="导出"
                                    Click="OnExportScreenshotsClick"/>
                            <Button Content="更多"
                                    FlyoutBase.AttachedFlyout="{StaticResource ScreenshotMoreActionsFlyout}"
                                    Click="OnShowScreenshotMoreActionsClick"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <GridView x:Name="ScreenshotList"
                          Grid.Row="1"
                          SelectionMode="Multiple">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border Width="260"
                                    Style="{StaticResource AniMeidoCardStyle}"
                                    Padding="0">
                                <StackPanel>
                                    <Image Loaded="OnScreenshotImageLoaded"
                                           DataContextChanged="OnScreenshotImageDataContextChanged"
                                           Width="260"
                                           Height="146"
                                           Stretch="UniformToFill"/>
                                    <StackPanel Padding="12" Spacing="5">
                                        <TextBlock Text="{Binding AnimeTitle}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ContextNote}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
        </Grid>
    </Grid>
</Page>
