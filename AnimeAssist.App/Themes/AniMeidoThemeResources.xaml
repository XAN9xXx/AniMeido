<ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

        <ResourceDictionary.ThemeDictionaries>
                <!-- ========= Light Theme ========= -->
                <ResourceDictionary x:Key="Light">
                        <!-- 页面背景 -->
                        <SolidColorBrush x:Key="AniMeidoPageBackgroundBrush"
                                         Color="#F5F5F5"/>
                        <SolidColorBrush x:Key="AniMeidoSurfaceBrush"
                                         Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AniMeidoCardBackgroundBrush"
                                         Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AniMeidoCardBorderBrush"
                                         Color="#E0E0E0"/>

                        <!-- 文字 -->
                        <SolidColorBrush x:Key="AniMeidoPrimaryTextBrush"
                                         Color="#1A1A1A"/>
                        <SolidColorBrush x:Key="AniMeidoSecondaryTextBrush"
                                         Color="#444444"/>
                        <SolidColorBrush x:Key="AniMeidoMutedTextBrush"
                                         Color="#777777"/>
                        <SolidColorBrush x:Key="AniMeidoErrorTextBrush"
                                         Color="#D32F2F"/>

                        <!-- 强调色 -->
                        <SolidColorBrush x:Key="AniMeidoAccentBrush"
                                         Color="{ThemeResource SystemAccentColor}"/>

                        <!-- 覆盖层（半透明遮罩） -->
                        <SolidColorBrush x:Key="AniMeidoOverlayScrimBrush"
                                         Color="#80FFFFFF"/>

                        <!-- 角标 -->
                        <SolidColorBrush x:Key="AniMeidoBadgeBackgroundBrush"
                                         Color="{ThemeResource SystemAccentColor}"/>
                        <SolidColorBrush x:Key="AniMeidoBadgeTextBrush"
                                         Color="#FFFFFF"/>

                        <!-- Tag -->
                        <SolidColorBrush x:Key="AniMeidoTagBackgroundBrush"
                                         Color="#E8E8E8"/>
                        <SolidColorBrush x:Key="AniMeidoTagTextBrush"
                                         Color="#1A1A1A"/>

                        <!-- 拖放 Zone -->
                        <SolidColorBrush x:Key="AniMeidoDropZoneBackgroundBrush"
                                         Color="#CCE8FF"/>
                        <SolidColorBrush x:Key="AniMeidoDropZoneBorderBrush"
                                         Color="#80B3FF"/>
                        <SolidColorBrush x:Key="AniMeidoDropZoneHoverBrush"
                                         Color="#99CCFF"/>

                        <!-- 导航 -->
                        <SolidColorBrush x:Key="AniMeidoNavTextDefaultBrush"
                                         Color="#1A1A1A"/>
                        <SolidColorBrush x:Key="AniMeidoNavTextSelectedBrush"
                                         Color="{ThemeResource SystemAccentColor}"/>
                        <SolidColorBrush x:Key="AniMeidoNavIndicatorBrush"
                                         Color="{ThemeResource SystemAccentColor}"/>
                        <SolidColorBrush x:Key="AniMeidoNavItemHoverBackgroundBrush"
                                         Color="{ThemeResource SystemAccentColor}"
                                         Opacity="0.10"/>
                        <SolidColorBrush x:Key="AniMeidoNavItemSelectedBackgroundBrush"
                                         Color="{ThemeResource SystemAccentColor}"
                                         Opacity="0.08"/>

                        <!-- 状态标记颜色 -->
                        <SolidColorBrush x:Key="AniMeidoWatchingColorBrush"
                                         Color="#4488FF"/>
                        <SolidColorBrush x:Key="AniMeidoPlanToWatchColorBrush"
                                         Color="#44FF88"/>
                        <SolidColorBrush x:Key="AniMeidoNotInterestedColorBrush"
                                         Color="#FF4444"/>
                        <SolidColorBrush x:Key="AniMeidoFollowingColorBrush"
                                         Color="#FFAA00"/>
                        <SolidColorBrush x:Key="AniMeidoCompletedColorBrush"
                                         Color="#8844FF"/>
                        <SolidColorBrush x:Key="AniMeidoDroppedColorBrush"
                                         Color="#888888"/>
                        <SolidColorBrush x:Key="AniMeidoBlockedColorBrush"
                                         Color="#444444"/>

                        <!-- 统计卡片 -->
                        <SolidColorBrush x:Key="AniMeidoStatsCardTextBrush"
                                         Color="{ThemeResource SystemAccentColor}"/>

                        <!-- 占位图 / 失败覆盖层 -->
                        <SolidColorBrush x:Key="AniMeidoPlaceholderBackgroundBrush"
                                         Color="#E8E8E8"/>
                        <SolidColorBrush x:Key="AniMeidoFailedOverlayBrush"
                                         Color="#CCE0E0E0"/>
                </ResourceDictionary>

                <!-- ========= Dark Theme ========= -->
                <ResourceDictionary x:Key="Dark">
                        <!-- 页面背景 -->
                        <SolidColorBrush x:Key="AniMeidoPageBackgroundBrush"
                                         Color="#1A1A1A"/>
                        <SolidColorBrush x:Key="AniMeidoSurfaceBrush"
                                         Color="#2A2A2A"/>
                        <SolidColorBrush x:Key="AniMeidoCardBackgroundBrush"
                                         Color="#2D2D2D"/>
                        <SolidColorBrush x:Key="AniMeidoCardBorderBrush"
                                         Color="#404040"/>

                        <!-- 文字 -->
                        <SolidColorBrush x:Key="AniMeidoPrimaryTextBrush"
                                         Color="#F0F0F0"/>
                        <SolidColorBrush x:Key="AniMeidoSecondaryTextBrush"
                                         Color="#AAAAAA"/>
                        <SolidColorBrush x:Key="AniMeidoMutedTextBrush"
                                         Color="#777777"/>
                        <SolidColorBrush x:Key="AniMeidoErrorTextBrush"
                                         Color="#EF5350"/>

                        <!-- 强调色 -->
                        <SolidColorBrush x:Key="AniMeidoAccentBrush"
                                         Color="{ThemeResource SystemAccentColor}"/>

                        <!-- 覆盖层 -->
                        <SolidColorBrush x:Key="AniMeidoOverlayScrimBrush"
                                         Color="#B0000000"/>

                        <!-- 角标 -->
                        <SolidColorBrush x:Key="AniMeidoBadgeBackgroundBrush"
                                         Color="{ThemeResource SystemAccentColor}"/>
                        <SolidColorBrush x:Key="AniMeidoBadgeTextBrush"
                                         Color="#FFFFFF"/>

                        <!-- Tag -->
                        <SolidColorBrush x:Key="AniMeidoTagBackgroundBrush"
                                         Color="#3A3A3A"/>
                        <SolidColorBrush x:Key="AniMeidoTagTextBrush"
                                         Color="#D0D0D0"/>

                        <!-- 拖放 Zone -->
                        <SolidColorBrush x:Key="AniMeidoDropZoneBackgroundBrush"
                                         Color="#332A2A6A"/>
                        <SolidColorBrush x:Key="AniMeidoDropZoneBorderBrush"
                                         Color="#664488FF"/>
                        <SolidColorBrush x:Key="AniMeidoDropZoneHoverBrush"
                                         Color="#996699FF"/>

                        <!-- 导航 -->
                        <SolidColorBrush x:Key="AniMeidoNavTextDefaultBrush"
                                         Color="#E9E9E9"/>
                        <SolidColorBrush x:Key="AniMeidoNavTextSelectedBrush"
                                         Color="{ThemeResource SystemAccentColor}"/>
                        <SolidColorBrush x:Key="AniMeidoNavIndicatorBrush"
                                         Color="{ThemeResource SystemAccentColor}"/>
                        <SolidColorBrush x:Key="AniMeidoNavItemHoverBackgroundBrush"
                                         Color="{ThemeResource SystemAccentColor}"
                                         Opacity="0.14"/>
                        <SolidColorBrush x:Key="AniMeidoNavItemSelectedBackgroundBrush"
                                         Color="{ThemeResource SystemAccentColor}"
                                         Opacity="0.10"/>

                        <!-- 状态标记颜色 -->
                        <SolidColorBrush x:Key="AniMeidoWatchingColorBrush"
                                         Color="#4488FF"/>
                        <SolidColorBrush x:Key="AniMeidoPlanToWatchColorBrush"
                                         Color="#44FF88"/>
                        <SolidColorBrush x:Key="AniMeidoNotInterestedColorBrush"
                                         Color="#FF4444"/>
                        <SolidColorBrush x:Key="AniMeidoFollowingColorBrush"
                                         Color="#FFAA00"/>
                        <SolidColorBrush x:Key="AniMeidoCompletedColorBrush"
                                         Color="#8844FF"/>
                        <SolidColorBrush x:Key="AniMeidoDroppedColorBrush"
                                         Color="#888888"/>
                        <SolidColorBrush x:Key="AniMeidoBlockedColorBrush"
                                         Color="#444444"/>

                        <!-- 统计卡片 -->
                        <SolidColorBrush x:Key="AniMeidoStatsCardTextBrush"
                                         Color="{ThemeResource SystemAccentColor}"/>

                        <!-- 占位图 / 失败覆盖层 -->
                        <SolidColorBrush x:Key="AniMeidoPlaceholderBackgroundBrush"
                                         Color="#3A3A3A"/>
                        <SolidColorBrush x:Key="AniMeidoFailedOverlayBrush"
                                         Color="#B0333333"/>
                </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
