<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.0.1</Version>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AniMeido.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Views\SettingPage.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Placeholder_cover.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Empty_anime.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Loading_failed.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\GitHub_Invertocat_Black_Clearspace.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AnimeAssist.Contracts\AniMeido.Contracts.csproj" />
    <ProjectReference Include="..\Plugins\AnimeAssist.Plugin.Base\AniMeido.Plugin.Base.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Page Update="Views\SettingPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <WebView2DispatchAdapterNamespace>AniMeido.App</WebView2DispatchAdapterNamespace>
  </PropertyGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>

  <Target Name="CopyPluginPri" AfterTargets="Build">
    <ItemGroup>
      <PluginPriFiles Include="$(MSBuildProjectDirectory)\..\Plugins\**\bin\$(Configuration)\net8.0-windows10.0.19041.0\*.pri" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginPriFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutDir)$(TargetName).pri" DestinationFolder="$(PublishDir)" />
  </Target>

  <Target Name="CopyPluginPriToPublish" AfterTargets="Publish">
    <ItemGroup>
      <PluginPriFiles Include="$(MSBuildProjectDirectory)\..\Plugins\**\bin\$(Configuration)\net8.0-windows10.0.19041.0\*.pri" />
    </ItemGroup>
    <!-- 复制到根目录（供根目录加载时使用） -->
    <Copy SourceFiles="@(PluginPriFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <!-- 复制到 Plugins\ 子目录（供子目录加载时使用） -->
    <Copy SourceFiles="@(PluginPriFiles)" DestinationFolder="$(PublishDir)Plugins\" SkipUnchangedFiles="true" />
  </Target>
</Project>