<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AniMeido.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AniMeido.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AnimeAssist">

    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid"
          Background="{ThemeResource LayerFillColorDefault}">
        <NavigationView x:Name="MainNaviView"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        OpenPaneLength="130"
                        Margin="0,30,0,0">

            <Frame x:Name="ContentFrame"/>

        </NavigationView>

        <!-- 标题栏 -->
        <Grid x:Name="AppTitleBar"
              Height="32"
              VerticalAlignment="Top"
              IsHitTestVisible="True"
              Background="{ThemeResource SolidBackgroundFillColorBase}"
              Margin="0,-1,0,0">
            <Rectangle Height="1"
                       VerticalAlignment="Bottom"
                       Fill="{ThemeResource DividerStrokeColorDefault}"/>

            <!-- 返回按钮 -->
            <Button x:Name="BackButton"
                    Content="&#xE76B;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="14"
                    Width="48"
                    Height="32"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnBackButtonClick"/>
        </Grid>

        <!-- 开屏覆盖层：覆盖全窗口 -->
        <Grid x:Name="SplashOverlay"
              Visibility="Visible"
              IsHitTestVisible="False"
              Background="#FF1A1A2E"
              VerticalAlignment="Stretch"
              HorizontalAlignment="Stretch">
            <Image x:Name="SplashImage"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
