<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.App.Views.AppSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24,16"
                Spacing="16">

            <TextBlock Text="App 设置"
                       FontSize="24"
                       FontWeight="Bold"/>

            <!-- 主题设置卡片 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8"
                    Padding="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="主题"
                               VerticalAlignment="Center"
                               FontSize="16"/>
                    <ComboBox Grid.Column="1"
                              x:Name="ThemeCombo"
                              MinWidth="140"
                              SelectionChanged="OnThemeSelectionChanged">
                        <x:String>浅色</x:String>
                        <x:String>深色</x:String>
                        <x:String>跟随系统</x:String>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- 插件列表 -->
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,12,0,0">
                <TextBlock Text="已加载插件"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="持续开发中，敬请期待"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <ItemsControl x:Name="PluginList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Version}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding PluginID}"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 关于卡片 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="关于"
                               Margin="16,12,16,4"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <Grid Margin="16,0,16,0"
                            Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="数据来源"
                                   VerticalAlignment="Center"
                                   FontSize="15"/>
                        <TextBlock Grid.Column="1"
                                   Text="Bangumi API (bgm.tv)"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>

                    <Rectangle Height="1"
                            Fill="{ThemeResource DividerStrokeColorDefault}"
                            Margin="16,0"/>

                    <Grid Margin="16,0,16,0"
                            Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="作者"
                                   VerticalAlignment="Center"
                                   FontSize="15"/>
                        <TextBlock Grid.Column="1"
                                   Text="XAN9x"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>

                    <Rectangle Height="1"
                            Fill="{ThemeResource DividerStrokeColorDefault}"
                            Margin="16,0"/>

                    <Grid Margin="16,0,16,0"
                            Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="联系方式"
                                   VerticalAlignment="Center"
                                   FontSize="15"/>
                        <TextBlock Grid.Column="1"
                                   Text="xan9xxx@gmail.com | QQ:3223271148"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>

                    <Rectangle Height="1"
                            Fill="{ThemeResource DividerStrokeColorDefault}"
                            Margin="16,0"/>

                    <Grid Margin="16,0,16,0"
                            Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="检查更新"
                                   VerticalAlignment="Center"
                                   FontSize="15"/>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                            <TextBlock x:Name="VersionInfoText"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Button x:Name="UpdateCheckButton"
                                    Content="检查"
                                    MinWidth="80"
                                    Height="32"
                                    VerticalAlignment="Center"
                                    Click="OnUpdateCheckClick"/>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1"
                            Fill="{ThemeResource DividerStrokeColorDefault}"
                            Margin="16,0"/>

                    <Grid Margin="16,0,16,0"
                            Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="开源协议"
                                   VerticalAlignment="Center"
                                   FontSize="15"/>
                        <TextBlock Grid.Column="1"
                                   Text="GNU General Public License v3.0"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>

                    <Rectangle Height="1"
                            Fill="{ThemeResource DividerStrokeColorDefault}"
                            Margin="16,0"/>

                    <Grid Margin="16,0,16,0"
                            Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="GitHub 仓库"
                                   VerticalAlignment="Center"
                                   FontSize="15"/>
                        <Border x:Name="GitHubButton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource CardBackgroundFillColorDefault}"
                                CornerRadius="6"
                                BorderBrush="{ThemeResource ControlStrokeColorDefault}"
                                BorderThickness="1"
                                IsTapEnabled="True"
                                Tapped="OnGitHubCardTapped"
                                PointerEntered="OnGitHubPointerEntered"
                                PointerExited="OnGitHubPointerExited"
                                PointerPressed="OnGitHubPointerPressed"
                                PointerReleased="OnGitHubPointerReleased">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6"
                                        Padding="10,6">
                                <Image Source="ms-appx:///Assets/GitHub_Invertocat_Black_Clearspace.png"
                                       Width="18"
                                       Height="18"
                                       VerticalAlignment="Center"/>
                                <TextBlock Text="XAN9xXx/AniMeido"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Rectangle Height="1"
                            Fill="{ThemeResource DividerStrokeColorDefault}"
                            Margin="16,0"/>

                    <Grid Margin="16,0,16,0"
                            Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="AniMeido 官网"
                                   VerticalAlignment="Center"
                                   FontSize="15"/>
                        <Border x:Name="WebsiteButton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource CardBackgroundFillColorDefault}"
                                CornerRadius="6"
                                BorderBrush="{ThemeResource ControlStrokeColorDefault}"
                                BorderThickness="1"
                                IsTapEnabled="True"
                                Tapped="OnWebsiteCardTapped"
                                PointerEntered="OnWebsitePointerEntered"
                                PointerExited="OnWebsitePointerExited"
                                PointerPressed="OnWebsitePointerPressed"
                                PointerReleased="OnWebsitePointerReleased">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6"
                                        Padding="10,6">
                                <Image Source="ms-appx:///Assets/icon.ico"
                                       Width="18"
                                       Height="18"
                                       VerticalAlignment="Center"/>
                                <TextBlock Text="animeido.com"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ======== 数据管理 ======== -->

            <TextBlock Text="数据管理"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,24,0,0"/>

            <!-- 本地缓存 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="本地缓存"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="番剧数据缓存到本地后可离线浏览，减少重复请求。"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="WrapWholeWords"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CacheInfoText"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button x:Name="ClearCacheButton"
                                Grid.Column="1"
                                Content="清理缓存"
                                Height="32"
                                MinWidth="80"
                                Click="OnClearCacheClick"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 数据路径 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="数据路径"
                               Margin="16,12,16,4"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <Grid Margin="16,0,16,0" Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="数据库路径" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="DbPathText" FontSize="13"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="打开文件夹" Height="32" VerticalAlignment="Center" Click="OnOpenDbDirClick"/>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefault}" Margin="16,0"/>

                    <Grid Margin="16,0,16,0" Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="备份路径" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="BackupPathText" FontSize="13"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="打开文件夹" Height="32" VerticalAlignment="Center" Click="OnOpenBackupDirClick"/>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefault}" Margin="16,0"/>

                    <Grid Margin="16,0,16,0" Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="日志路径" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="LogPathText" FontSize="13"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="打开文件夹" Height="32" VerticalAlignment="Center" Click="OnOpenLogDirClick"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 备份 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="备份与恢复"
                               Margin="16,12,16,4"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Grid Margin="16,0,16,0" Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="立即备份" VerticalAlignment="Center" FontSize="15"/>
                        <Button Grid.Column="1" x:Name="BackupNowButton" Content="备份" Height="32" VerticalAlignment="Center" Click="OnBackupNowClick"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 导入导出 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="导入导出"
                               Margin="16,12,16,4"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Grid Margin="16,0,16,0" Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="导出追番数据" VerticalAlignment="Center" FontSize="15"/>
                        <Button Grid.Column="1" x:Name="ExportButton" Content="导出" Height="32" VerticalAlignment="Center" Click="OnExportClick"/>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefault}" Margin="16,0"/>
                    <Grid Margin="16,0,16,0" Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="导入追番数据" VerticalAlignment="Center" FontSize="15"/>
                        <Button Grid.Column="1" x:Name="ImportButton" Content="导入" Height="32" VerticalAlignment="Center" Click="OnImportClick"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
