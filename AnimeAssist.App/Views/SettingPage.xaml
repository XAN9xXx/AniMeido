<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.App.Views.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*"
          RowSpacing="16"
          Padding="24,20,24,24"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel Spacing="2">
            <TextBlock Text="设置"
                       Style="{StaticResource AniMeidoPageTitleStyle}"/>
            <TextBlock Text="管理 AniMeido、基础功能与可选插件"
                       Style="{StaticResource AniMeidoPageSubtitleStyle}"/>
        </StackPanel>

        <NavigationView x:Name="SettingsNavigation"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsPaneOpen="True"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        OpenPaneLength="230"
                        SelectionChanged="OnSettingsSelectionChanged">
            <NavigationView.Resources>
                <Style TargetType="NavigationViewItem">
                    <Setter Property="MinHeight" Value="44"/>
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </NavigationView.Resources>

            <Frame x:Name="SettingsFrame"/>
        </NavigationView>
    </Grid>
</Page>
