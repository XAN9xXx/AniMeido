<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniMeido.App.Views.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <StackPanel Grid.Column="0"
                    Margin="0,0,16,0"
                    Spacing="0">
            <TextBlock Text="设置"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,12"/>

            <!-- App 设置入口 -->
            <Border x:Name="AppSettingsCard"
                    Padding="12,10,12,10"
                    Height="40"
                    Tapped="OnNavItemTapped"
                    PointerEntered="OnCardPointerEntered"
                    PointerExited="OnCardPointerExited">
                <Grid ColumnDefinitions="3,*">
                    <Rectangle x:Name="AppSettingsIndicator"
                               Width="3"
                               Height="20"
                               Fill="{ThemeResource AniMeidoNavIndicatorBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="AppSettingsLabel"
                               Grid.Column="1"
                               Text="App 设置"
                               FontSize="14"
                               Foreground="{ThemeResource AniMeidoNavTextSelectedBrush}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </Grid>
            </Border>

            <!-- 插件设置入口（由代码动态填充） -->
            <StackPanel x:Name="PluginSettingsList"
                        Spacing="0"/>
        </StackPanel>

        <!-- 右侧 Frame -->
        <Frame x:Name="SettingsFrame"
               Grid.Column="1"/>
    </Grid>
</Page>